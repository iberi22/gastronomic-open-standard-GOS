---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import LoadingSpinner from '../components/LoadingSpinner.astro';

const title = "Scraped Data - GOS";
---

<Layout title={title}>
  <div class="max-w-4xl mx-auto p-6">
    <header class="mb-8">
      <h1 class="text-4xl font-display text-primary mb-2">📥 Datos Extraídos</h1>
      <p class="text-gray-400">Datos capturados desde la extensión de Chrome</p>
    </header>

    <!-- Sync Status -->
    <section id="sync-status" class="mb-8 p-4 bg-white/5 rounded-xl border border-white/10">
      <div id="sync-spinner-container" style="display:none;" class="mb-4">
        <LoadingSpinner size="md" label="Sincronizando datos..." />
      </div>
      <div id="sync-content">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-display text-white">Estado de Sincronización</h2>
            <p id="sync-status-text" class="text-gray-400 text-sm">Esperando...</p>
          </div>
          <div class="flex items-center gap-4">
            <div class="text-center">
              <div id="sync-places-count" class="text-2xl font-bold text-primary">0</div>
              <div class="text-xs text-gray-500">Lugares</div>
            </div>
            <div class="text-center">
              <div id="sync-reviews-count" class="text-2xl font-bold text-secondary">0</div>
              <div class="text-xs text-gray-500">Reviews</div>
            </div>
          </div>
        </div>
        <div class="mt-4 flex gap-3">
          <button id="btn-sync" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/80 transition">
              🔄 Sincronizar Ahora
          </button>
          <button id="btn-open-extension" class="px-4 py-2 bg-white/10 text-white rounded-lg hover:bg-white/20 transition">
            🌐 Abrir Extensión
          </button>
        </div>
      </div>
    </section>

    <!-- Extension Check -->
    <section id="extension-check" class="mb-8 p-4 bg-white/5 rounded-xl border border-white/10">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span id="extension-icon" class="text-2xl">❓</span>
          <div>
            <h3 id="extension-status" class="text-white">Verificando extensión...</h3>
            <p class="text-gray-500 text-sm">Chrome Extension GOS Scraper</p>
          </div>
        </div>
        <button id="btn-install-guide" class="px-4 py-2 bg-white/10 text-white rounded-lg hover:bg-white/20 transition text-sm">
          Ver Guía de Instalación
        </button>
      </div>
    </section>

    <!-- Scraper Guide Modal -->
    <dialog id="guide-modal" class="bg-[#1a1a2e] border border-white/10 rounded-xl p-6 max-w-lg w-full">
      <h2 class="text-xl font-display text-white mb-4">📦 Instalar GOS Scraper</h2>
      <div class="space-y-4 text-gray-300">
        <div class="flex gap-3">
          <span class="bg-primary/20 text-primary px-2 py-1 rounded text-sm font-bold">1</span>
          <p>Abre Chrome y navega a <code class="bg-white/10 px-2 py-1 rounded">chrome://extensions/</code></p>
        </div>
        <div class="flex gap-3">
          <span class="bg-primary/20 text-primary px-2 py-1 rounded text-sm font-bold">2</span>
          <p>Activa "Modo desarrollador" (esquina superior derecha)</p>
        </div>
        <div class="flex gap-3">
          <span class="bg-primary/20 text-primary px-2 py-1 rounded text-sm font-bold">3</span>
          <p>Click en "Cargar extensión sin empaquetar"</p>
        </div>
        <div class="flex gap-3">
          <span class="bg-primary/20 text-primary px-2 py-1 rounded text-sm font-bold">4</span>
          <p>Selecciona la carpeta: <code class="bg-white/10 px-2 py-1 rounded">extensions/gos-scraper</code></p>
        </div>
      </div>
      <div class="mt-6 flex justify-end">
        <button id="btn-close-guide" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/80 transition">
          Entendido
        </button>
      </div>
    </dialog>

    <!-- Places List -->
    <section class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-display text-white">🏪 Lugares Extraídos</h2>
        <span id="places-total" class="text-gray-500 text-sm">0 lugares</span>
      </div>
      <div id="places-list" class="grid gap-4 md:grid-cols-2">
        <EmptyState icon="📍" title="No hay lugares todavía" description="Usa la extensión para extraer lugares de Google Maps" ctaText="Ver Guía" ctaLink="#" />
      </div>
      <!-- Places Pagination -->
      <div id="places-pagination" class="pagination-controls mt-4" style="display: none;">
        <button id="places-prev" class="pagination-btn" disabled>← Anterior</button>
        <span id="places-page-info" class="pagination-info">Página 1 de 1</span>
        <button id="places-next" class="pagination-btn" disabled>Siguiente →</button>
      </div>
    </section>

    <!-- Reviews List -->
    <section class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-display text-white">⭐ Reviews Extraídas</h2>
        <span id="reviews-total" class="text-gray-500 text-sm">0 reviews</span>
      </div>
      <div id="reviews-list" class="space-y-3">
        <EmptyState icon="⭐" title="No hay reviews todavía" description="Usa la extensión para extraer reviews de Google Maps" />
      </div>
      <!-- Reviews Pagination -->
      <div id="reviews-pagination" class="pagination-controls mt-4" style="display: none;">
        <button id="reviews-prev" class="pagination-btn" disabled>← Anterior</button>
        <span id="reviews-page-info" class="pagination-info">Página 1 de 1</span>
        <button id="reviews-next" class="pagination-btn" disabled>Siguiente →</button>
      </div>
    </section>

    <!-- Import/Export -->
    <section class="mb-8">
      <h2 class="text-2xl font-display text-white mb-4">💾 Importar / Exportar</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="p-4 bg-white/5 rounded-xl border border-white/10">
          <h3 class="text-white mb-2">📤 Exportar Datos</h3>
          <p class="text-gray-500 text-sm mb-4">Descarga todos los datos extraídos</p>
          <div class="flex gap-2">
            <select id="export-format" class="flex-1 px-3 py-2 bg-white/10 text-white rounded-lg border border-white/20 focus:border-primary focus:outline-none">
              <option value="json">JSON</option>
              <option value="csv">CSV</option>
              <option value="feed">RSS/Feed</option>
            </select>
            <button id="btn-export" class="px-4 py-2 bg-secondary text-white rounded-lg hover:bg-secondary/80 transition">
              Exportar
            </button>
          </div>
          <p class="text-gray-600 text-xs mt-2">JSON: Full backup • CSV: Spreadsheet • RSS: Public feed</p>
        </div>
        <div class="p-4 bg-white/5 rounded-xl border border-white/10">
          <h3 class="text-white mb-2">📥 Importar Datos</h3>
          <p class="text-gray-500 text-sm mb-4">Importa datos desde un archivo JSON</p>
          <label class="block w-full px-4 py-2 bg-white/10 text-white text-center rounded-lg hover:bg-white/20 transition cursor-pointer">
            Seleccionar Archivo
            <input type="file" id="import-file" accept=".json" class="hidden" />
          </label>
        </div>
      </div>
    </section>

    <!-- Clear Data -->
    <section class="p-4 bg-red-900/20 rounded-xl border border-red-500/30">
      <h2 class="text-xl font-display text-red-400 mb-2">⚠️ Zona de Peligro</h2>
      <p class="text-gray-400 text-sm mb-4">Esta acción eliminará todos los datos extraídos. No se puede deshacer.</p>
      <button id="btn-clear" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
        🗑️ Eliminar Todos los Datos
      </button>
    </section>
  </div>
</Layout>

<script>
  import { userDB } from '../lib/user-db';
  import { extensionSync } from '../lib/extension-sync';
  import { exportAll } from '../lib/export';

  // Elements
  const syncStatus = document.getElementById('sync-status-text');
  const syncPlacesCount = document.getElementById('sync-places-count');
  const syncReviewsCount = document.getElementById('sync-reviews-count');
  const placesList = document.getElementById('places-list');
  const reviewsList = document.getElementById('reviews-list');
  const placesTotal = document.getElementById('places-total');
  const reviewsTotal = document.getElementById('reviews-total');
  const extensionIcon = document.getElementById('extension-icon');
  const extensionStatus = document.getElementById('extension-status');
  const guideModal = document.getElementById('guide-modal');
  const placesPagination = document.getElementById('places-pagination');
  const reviewsPagination = document.getElementById('reviews-pagination');

  // Pagination state
  const ITEMS_PER_PAGE = {
    places: 12,
    reviews: 20
  };
  let currentPage = {
    places: 1,
    reviews: 1
  };
  let totalItems = {
    places: 0,
    reviews: 0
  };
  let allPlaces = [];
  let allReviews = [];


  // Get page from URL hash
  function getPageFromHash() {
    const hash = window.location.hash;
    const match = hash.match(/page=(\d+)/);
    return match ? parseInt(match[1], 10) : 1;
  }


  // Set page in URL hash
  function setPageInHash(page) {
    const hash = window.location.hash.replace(/page=\d+/, '');
    if (page > 1) {
      window.location.hash = hash + (hash ? '&' : '') + `page=${page}`;
    } else {
      window.history.replaceState(null, '', window.location.pathname + window.location.search);
    }
  }

  // Calculate total pages
  function getTotalPages(count, perPage) {
    return Math.ceil(count / perPage) || 1;
  }

  // Update pagination controls
  function updatePaginationControls(type) {
    const total = totalItems[type];
    const perPage = ITEMS_PER_PAGE[type];
    const current = currentPage[type];
    const totalPages = getTotalPages(total, perPage);
    const pagination = type === 'places' ? placesPagination : reviewsPagination;
    const prevBtn = document.getElementById(`${type}-prev`);
    const nextBtn = document.getElementById(`${type}-next`);
    const pageInfo = document.getElementById(`${type}-page-info`);

    if (pagination) {
      pagination.style.display = total > perPage ? 'flex' : 'none';
    }

    if (prevBtn) {
      prevBtn.disabled = current <= 1;
    }
    if (nextBtn) {
      nextBtn.disabled = current >= totalPages;
    }
    if (pageInfo) {
      pageInfo.textContent = `Página ${current} de ${totalPages}`;
    }
  }

  // Paginate items
  function paginateItems(items, page, perPage) {
    const start = (page - 1) * perPage;
    return items.slice(start, start + perPage);
  }

  // Check if extension is installed
  async function checkExtension() {
    try {
      const installed = await extensionSync.isExtensionInstalled();
      if (installed) {
        extensionIcon.textContent = '✅';
        extensionStatus.textContent = 'Extensión Instalada';
        extensionStatus.className = 'text-green-400';
      } else {
        extensionIcon.textContent = '❌';
        extensionStatus.textContent = 'Extensión No Detectada';
        extensionStatus.className = 'text-red-400';
      }
    } catch {
      extensionIcon.textContent = '❓';
      extensionStatus.textContent = 'Verificación Fallida';
    }
  }

  // Load scraped data
  async function loadScrapedData(pageOverride) {
    allPlaces = await userDB.getScrapedPlaces();
    allReviews = await userDB.getScrapedReviews();
    const favorites = await userDB.getFavorites('place');
    const favoriteIds = new Set(favorites.map(f => f.itemId));


    totalItems.places = allPlaces.length;
    totalItems.reviews = allReviews.length;

    // Update counts
    syncPlacesCount.textContent = allPlaces.length.toString();
    syncReviewsCount.textContent = allReviews.length.toString();
    placesTotal.textContent = `${allPlaces.length} lugares`;
    reviewsTotal.textContent = `${allReviews.length} reviews`;

    // Get current page from hash if no override
    const placesPage = pageOverride?.places ?? getPageFromHash();
    const reviewsPage = pageOverride?.reviews ?? 1;
    currentPage.places = Math.min(placesPage, getTotalPages(totalItems.places, ITEMS_PER_PAGE.places));
    currentPage.reviews = Math.min(reviewsPage, getTotalPages(totalItems.reviews, ITEMS_PER_PAGE.reviews));

    // Update URL hash
    if (currentPage.places > 1) {
      setPageInHash(currentPage.places);
    }

    // Update pagination controls
    updatePaginationControls('places');
    updatePaginationControls('reviews');

    // Get paginated items
    const paginatedPlaces = paginateItems(allPlaces, currentPage.places, ITEMS_PER_PAGE.places);
    const paginatedReviews = paginateItems(allReviews, currentPage.reviews, ITEMS_PER_PAGE.reviews);

    // Render places
    if (paginatedPlaces.length === 0) {
      placesList.innerHTML = `
        <div class="col-span-2">
          <div class="flex flex-col items-center justify-center py-12 px-6 bg-white/5 rounded-xl border border-white/10 text-center">
            <span class="text-5xl mb-4">📍</span>
            <h3 class="text-lg font-display text-white mb-2">No hay lugares todavía</h3>
            <p class="text-gray-400 text-sm mb-6 max-w-sm">Usa la extensión para extraer lugares de Google Maps</p>
            <button class="px-5 py-2.5 bg-primary text-white rounded-lg font-medium hover:bg-primary/80 transition" onclick="document.getElementById('guide-modal')?.showModal()">Ver Guía</button>
          </div>
        </div>
      `;
    } else {
      placesList.innerHTML = paginatedPlaces.map(place => {
        const isFav = favoriteIds.has(place.id);
        return `
        <div class="p-4 bg-white/5 rounded-xl border border-white/10">
          <div class="flex justify-between items-start mb-2">
            <h3 class="text-white font-medium">${place.name}</h3>
            <span class="text-sm text-primary">${place.source}</span>
          </div>
          <div class="text-gray-400 text-sm space-y-1">
            ${place.averageRating ? `<p>⭐ ${place.averageRating} (${place.reviewCount} reviews)</p>` : ''}
            ${place.location?.address ? `<p>📍 ${place.location.address}</p>` : ''}
            ${place.categories?.length ? `<p>🏷️ ${place.categories.join(', ')}</p>` : ''}
          </div>
          ${place.sourceUrl ? `<a href="${place.sourceUrl}" target="_blank" class="text-primary text-sm hover:underline">Ver original →</a>` : ''}
          <div class="mt-3 pt-3 border-t border-white/10 flex justify-between items-center">
            <button
              class="fav-btn px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${
                isFav
                  ? 'bg-red-500/20 text-red-400 border border-red-500/40'
                  : 'bg-white/5 text-gray-400 border border-white/10 hover:bg-white/10 hover:text-white'
              }"
              data-place-id="${place.id}"
              data-place-name="${place.name}"
              data-is-fav="${isFav}"
            >
              ${isFav ? '❤️ Favorito' : '🤍 Add to Favorites'}
            </button>
          </div>
        </div>
      `}).join('');

      // Attach click handlers for favorite buttons
      placesList.querySelectorAll('.fav-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const el = e.currentTarget as HTMLButtonElement;
          const placeId = el.dataset.placeId!;
          const placeName = el.dataset.placeName!;
          const isFav = el.dataset.isFav === 'true';

          if (isFav) {
            await userDB.removeFavorite(placeId);
          } else {
            await userDB.addFavorite({
              type: 'place',
              itemId: placeId,
              itemName: placeName
            });
          }

          // Toggle visual state immediately
          const newIsFav = !isFav;
          el.dataset.isFav = String(newIsFav);
          if (newIsFav) {
            el.className = 'fav-btn px-3 py-1.5 rounded-lg text-sm font-medium transition-all bg-red-500/20 text-red-400 border border-red-500/40';
            el.textContent = '❤️ Favorito';
          } else {
            el.className = 'fav-btn px-3 py-1.5 rounded-lg text-sm font-medium transition-all bg-white/5 text-gray-400 border border-white/10 hover:bg-white/10 hover:text-white';
            el.textContent = '🤍 Add to Favorites';
          }
        });
      });
    }

    // Render reviews
    if (paginatedReviews.length === 0) {
      reviewsList.innerHTML = `
        <div class="flex flex-col items-center justify-center py-12 px-6 bg-white/5 rounded-xl border border-white/10 text-center">
          <span class="text-5xl mb-4">⭐</span>
          <h3 class="text-lg font-display text-white mb-2">No hay reviews todavía</h3>
          <p class="text-gray-400 text-sm mb-6 max-w-sm">Usa la extensión para extraer reviews de Google Maps</p>
        </div>
      `;
    } else {
      reviewsList.innerHTML = paginatedReviews.map(review => `
        <div class="p-4 bg-white/5 rounded-xl border border-white/10">
          <div class="flex justify-between items-start mb-2">
            <div>
              <span class="text-primary">${'⭐'.repeat(review.rating || 0)}</span>
              <span class="text-gray-500 text-sm ml-2">${review.source}</span>
            </div>
            <span class="text-gray-500 text-xs">${review.publishDate || ''}</span>
          </div>
          ${review.comment ? `<p class="text-gray-300 text-sm mb-2">"${review.comment.substring(0, 200)}${review.comment.length > 200 ? '...' : ''}"</p>` : ''}
          <p class="text-gray-500 text-xs">Por: ${review.userName || 'Anonymous'}</p>
        </div>
      `).join('');
    }

    syncStatus.textContent = `Última sync: ${new Date().toLocaleTimeString()}`;
  }

  // Event Listeners
  document.getElementById('btn-sync')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-sync');
    const spinnerContainer = document.getElementById('sync-spinner-container');
    const syncContent = document.getElementById('sync-content');

    // Show spinner, hide content
    if (spinnerContainer) spinnerContainer.style.display = 'block';
    if (syncContent) syncContent.style.display = 'none';

    if (btn) {
      btn.setAttribute('disabled', 'true');
    }

    try {
      await extensionSync.forceSync();
      await loadScrapedData();
    } finally {
      // Hide spinner, show content
      if (spinnerContainer) spinnerContainer.style.display = 'none';
      if (syncContent) syncContent.style.display = 'block';
      if (btn) {
        btn.textContent = '🔄 Sincronizar Ahora';
        btn.removeAttribute('disabled');
      }
    }
  });

  document.getElementById('btn-open-extension')?.addEventListener('click', () => {
    extensionSync.openExtension();
  });

  document.getElementById('btn-install-guide')?.addEventListener('click', () => {
    guideModal?.showModal();
  });

  document.getElementById('btn-close-guide')?.addEventListener('click', () => {
    guideModal?.close();
  });

  // Export with format selection
  document.getElementById('btn-export')?.addEventListener('click', async () => {
    const format = (document.getElementById('export-format') as HTMLSelectElement)?.value as 'json' | 'csv' | 'feed';
    await exportAll(userDB, format);
  });

  // Import
  document.getElementById('import-file')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    try {
      const text = await file.text();
      const data = JSON.parse(text);
      await userDB.importAll(data);
      await loadScrapedData();
      alert('Datos importados correctamente');
    } catch (err) {
      alert('Error al importar: ' + (err as Error).message);
    }
  });

  // Clear
  document.getElementById('btn-clear')?.addEventListener('click', async () => {
    if (!confirm('¿Estás seguro de eliminar TODOS los datos?')) return;
    if (!confirm('Esta acción NO se puede deshacer. ¿Continuar?')) return;

    await extensionSync.clearAll();
    await loadScrapedData();
    alert('Datos eliminados');
  });

  // Initialize
  checkExtension();
  await loadScrapedData();
  await extensionSync.start();

  // Listen for hash changes
  window.addEventListener('hashchange', () => {
    loadScrapedData({ places: getPageFromHash() });
  });

  // Listen for new data
  extensionSync.listenToMessages(() => {
    loadScrapedData();
  });

  // Pagination event listeners
  document.getElementById('places-prev')?.addEventListener('click', () => {
    if (currentPage.places > 1) {
      currentPage.places--;
      setPageInHash(currentPage.places);
      updatePaginationControls('places');
      const paginatedPlaces = paginateItems(allPlaces, currentPage.places, ITEMS_PER_PAGE.places);
      // Re-render just the places list with updated favorites
      loadScrapedData({ places: currentPage.places });
    }
  });

  document.getElementById('places-next')?.addEventListener('click', () => {
    const totalPages = getTotalPages(totalItems.places, ITEMS_PER_PAGE.places);
    if (currentPage.places < totalPages) {
      currentPage.places++;
      setPageInHash(currentPage.places);
      updatePaginationControls('places');
      loadScrapedData({ places: currentPage.places });
    }
  });

  document.getElementById('reviews-prev')?.addEventListener('click', () => {
    if (currentPage.reviews > 1) {
      currentPage.reviews--;
      updatePaginationControls('reviews');
      loadScrapedData({ reviews: currentPage.reviews });
    }
  });


  document.getElementById('reviews-next')?.addEventListener('click', () => {
    const totalPages = getTotalPages(totalItems.reviews, ITEMS_PER_PAGE.reviews);
    if (currentPage.reviews < totalPages) {
      currentPage.reviews++;
      updatePaginationControls('reviews');
      loadScrapedData({ reviews: currentPage.reviews });
    }
  });
</script>

<style>
  .pagination-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
  }
  .pagination-btn {
    padding: 0.4rem 1rem;
    background: rgba(255, 255, 255, 0.06);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .pagination-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .pagination-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .pagination-info {
    color: #94a3b8;
    font-size: 0.875rem;
    font-weight: 500;
    min-width: 120px;
    text-align: center;
  }
</style>