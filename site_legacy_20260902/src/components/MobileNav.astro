---
const baseUrl = import.meta.env.BASE_URL;

// Navigation links matching index.astro
const navLinks = [
  { href: '/assistant', label: 'Asistente AI', icon: 'smart_toy' },
  { href: '/reviews', label: 'Reviews', icon: 'assignment' },
  { href: '/profile', label: 'Perfil', icon: 'person' },
  { href: '/settings', label: 'Ajustes', icon: 'settings' },
  { href: '/scraped', label: 'Importar Datos', icon: 'download' },
  { href: '/extension-guide', label: 'Instalar Extensión', icon: 'build' },
  { href: '/graph', label: 'Grafo', icon: 'account_tree' },
];
---

<!-- Mobile Navigation Menu -->
<div id="mobile-nav-overlay" class="fixed inset-0 z-40 hidden bg-black/60 backdrop-blur-sm" aria-hidden="true"></div>

<nav id="mobile-nav" class="fixed top-0 right-0 z-50 h-full w-72 max-w-[85vw] transform translate-x-full transition-transform duration-300 ease-out bg-[#0a0a0f] border-l border-white/10 shadow-2xl" aria-label="Mobile navigation">
  <!-- Header -->
  <div class="flex items-center justify-between p-4 border-b border-white/10">
    <span class="text-xl font-display text-primary">GOS</span>
    <button
      id="mobile-nav-close"
      type="button"
      class="flex size-11 min-w-[44px] items-center justify-center rounded-full hover:bg-white/10 transition-colors text-gray-300"
      aria-label="Cerrar menú"
    >
      <span class="material-symbols-outlined text-2xl">close</span>
    </button>
  </div>

  <!-- Navigation Links -->
  <ul class="p-4 space-y-1">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class="flex items-center gap-3 p-4 min-h-[52px] rounded-xl text-gray-300 hover:bg-white/5 hover:text-[#e94560] transition-all"
        >
          <span class="material-symbols-outlined text-xl">{link.icon}</span>
          <span class="font-medium">{link.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <!-- Footer -->
  <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-white/10">
    <p class="text-center text-xs text-gray-500">GOS PWA v0.1.0</p>
  </div>
</nav>

<!-- Hamburger Button (top-right of header area) -->
<button
  id="mobile-nav-toggle"
  type="button"
  class="fixed top-4 right-4 z-30 flex size-11 min-w-[44px] items-center justify-center rounded-full bg-[#0a0a0f]/80 backdrop-blur-md border border-white/10 hover:bg-[#e94560] hover:border-[#e94560] transition-all text-gray-300 hover:text-white"
  aria-label="Abrir menú"
  aria-expanded="false"
  aria-controls="mobile-nav"
>
  <span class="material-symbols-outlined text-2xl">menu</span>
</button>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const closeBtn = document.getElementById('mobile-nav-close');
  const nav = document.getElementById('mobile-nav');
  const overlay = document.getElementById('mobile-nav-overlay');
  const STORAGE_KEY = 'gos_mobile_nav_closed';

  function isNavClosed(): boolean {
    try {
      return localStorage.getItem(STORAGE_KEY) === 'true';
    } catch {
      return false;
    }
  }

  function setNavClosed(closed: boolean): void {
    try {
      localStorage.setItem(STORAGE_KEY, closed ? 'true' : 'false');
    } catch { /* noop */ }
  }

  function openNav(): void {
    nav?.classList.remove('translate-x-full');
    overlay?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.querySelector('.material-symbols-outlined')!.textContent = 'close';
    document.body.style.overflow = 'hidden';
  }

  function closeNav(): void {
    nav?.classList.add('translate-x-full');
    overlay?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.querySelector('.material-symbols-outlined')!.textContent = 'menu';
    document.body.style.overflow = '';
    setNavClosed(true);
  }

  // Restore user-closed state
  if (!isNavClosed()) {
    // Check viewport - only auto-open on mobile
    if (window.innerWidth < 768) {
      // Small delay to ensure DOM is ready
      setTimeout(() => openNav(), 100);
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = !nav?.classList.contains('translate-x-full');
    isOpen ? closeNav() : openNav();
  });

  closeBtn?.addEventListener('click', closeNav);

  overlay?.addEventListener('click', closeNav);

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeNav();
  });

  // Close on route change (Astro View Transitions)
  document.addEventListener('astro:after-swap', () => {
    // Re-apply closed state after navigation
    if (isNavClosed() && window.innerWidth < 768) {
      closeNav();
    }
  });

  // Handle resize - reset closed state when going to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      setNavClosed(false); // Reset so hamburger doesn't auto-open on desktop
    }
  });
</script>