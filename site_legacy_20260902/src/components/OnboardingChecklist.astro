---
// OnboardingChecklist.astro — 5-step onboarding with localStorage tracking
---

<div id="onboarding-checklist" class="bg-white/5 border border-white/10 rounded-xl p-6 mb-8">
  <h3 class="text-xl font-display mb-4 text-primary">🎯 Welcome to GOS — Get Started</h3>
  <ul class="space-y-3">
    <li data-step="country">
      <a href="#country-section" class="checklist-item flex items-center gap-3 p-3 bg-white/5 rounded-lg hover:bg-white/10 transition-all border border-transparent hover:border-primary/30">
        <span class="checkbox w-5 h-5 rounded border border-gray-500 flex items-center justify-center text-transparent">✓</span>
        <span class="step-text">Select your country</span>
      </a>
    </li>
    <li data-step="extension">
      <a href="/settings#extension-section" class="checklist-item flex items-center gap-3 p-3 bg-white/5 rounded-lg hover:bg-white/10 transition-all border border-transparent hover:border-primary/30">
        <span class="checkbox w-5 h-5 rounded border border-gray-500 flex items-center justify-center text-transparent">✓</span>
        <span class="step-text">Install Chrome Extension</span>
      </a>
    </li>
    <li data-step="scraped">
      <a href="/scraped" class="checklist-item flex items-center gap-3 p-3 bg-white/5 rounded-lg hover:bg-white/10 transition-all border border-transparent hover:border-primary/30">
        <span class="checkbox w-5 h-5 rounded border border-gray-500 flex items-center justify-center text-transparent">✓</span>
        <span class="step-text">Extract your first restaurant</span>
      </a>
    </li>
    <li data-step="favorites">
      <a href="/favorites" class="checklist-item flex items-center gap-3 p-3 bg-white/5 rounded-lg hover:bg-white/10 transition-all border border-transparent hover:border-primary/30">
        <span class="checkbox w-5 h-5 rounded border border-gray-500 flex items-center justify-center text-transparent">✓</span>
        <span class="step-text">Add a favorite product</span>
      </a>
    </li>
    <li data-step="graph">
      <a href="/graph" class="checklist-item flex items-center gap-3 p-3 bg-white/5 rounded-lg hover:bg-white/10 transition-all border border-transparent hover:border-primary/30">
        <span class="checkbox w-5 h-5 rounded border border-gray-500 flex items-center justify-center text-transparent">✓</span>
        <span class="step-text">Explore the food graph</span>
      </a>
    </li>
  </ul>
  <p class="text-gray-500 text-sm mt-4">Progress saved automatically</p>
</div>

<script>
  const STORAGE_KEY = 'gos_onboarding_completed';

  function getCompletedSteps(): string[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }

  function saveCompletedSteps(steps: string[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(steps));
  }

  function markStepComplete(step: string) {
    const completed = getCompletedSteps();
    if (!completed.includes(step)) {
      completed.push(step);
      saveCompletedSteps(completed);
    }
    renderChecklist();
  }

  function renderChecklist() {
    const completed = getCompletedSteps();
    const items = document.querySelectorAll('#onboarding-checklist li[data-step]');
    items.forEach(li => {
      const step = li.getAttribute('data-step');
      const checkbox = li.querySelector('.checkbox');
      const link = li.querySelector('.checklist-item') as HTMLElement;
      if (step && completed.includes(step) && checkbox) {
        checkbox.classList.add('bg-primary', 'border-primary', 'text-black');
        checkbox.classList.remove('border-gray-500', 'text-transparent');
        if (link) {
          link.classList.add('line-through', 'opacity-60');
          link.style.pointerEvents = 'none';
        }
      }
    });
  }

  // Mark steps as complete based on real user actions
  function trackStep(step: string, condition: () => boolean) {
    if (condition()) {
      markStepComplete(step);
    }
  }

  // Auto-detect completed steps
  document.addEventListener('DOMContentLoaded', () => {
    renderChecklist();

    // country selected
    trackStep('country', () => !!localStorage.getItem('gos_country'));

    // extension installed — check localStorage flag
    trackStep('extension', () => localStorage.getItem('gos_extension_installed') === 'true');

    // first restaurant extracted
    trackStep('scraped', () => {
      try {
        const scraped = localStorage.getItem('gos_scraped_count');
        return scraped && parseInt(scraped) > 0;
      } catch { return false; }
    });

    // favorites added
    trackStep('favorites', () => {
      try {
        const favs = localStorage.getItem('gos_favorites');
        return favs && JSON.parse(favs).length > 0;
      } catch { return false; }
    });

    // graph visited
    trackStep('graph', () => localStorage.getItem('gos_visited_graph') === 'true');
  });

  // Track graph visit
  if (window.location.pathname === '/graph') {
    localStorage.setItem('gos_visited_graph', 'true');
  }

  // Allow manual marking via custom event
  document.addEventListener('gos:step-complete', (e: Event) => {
    const step = (e as CustomEvent).detail?.step;
    if (step) markStepComplete(step);
  });

  // Expose markStepComplete globally for other components
  (window as any).gosMarkStepComplete = markStepComplete;
</script>

<style>
  #onboarding-checklist .checklist-item {
    cursor: pointer;
  }
</style>