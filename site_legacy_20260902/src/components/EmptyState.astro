---
interface Props {
  icon: string;
  title: string;
  description: string;
  ctaText?: string;
  ctaLink?: string;
}

const { icon, title, description, ctaText, ctaLink } = Astro.props;
---

<div class="flex flex-col items-center justify-center py-12 px-6 bg-white/5 rounded-xl border border-white/10 text-center">
  <span class="text-5xl mb-4">{icon}</span>
  <h3 class="text-lg font-display text-white mb-2">{title}</h3>
  <p class="text-gray-400 text-sm mb-6 max-w-sm">{description}</p>
  {ctaText && ctaLink && (
    <a
      href={ctaLink}
      class="px-5 py-2.5 bg-primary text-white rounded-lg font-medium hover:bg-primary/80 transition"
    >
      {ctaText}
    </a>
  )}
  {ctaText && !ctaLink && (
    <button class="px-5 py-2.5 bg-primary text-white rounded-lg font-medium hover:bg-primary/80 transition">
      {ctaText}
    </button>
  )}
</div>