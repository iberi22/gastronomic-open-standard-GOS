---
import { Toaster } from '@swal/ui'
import { THEME_BOOT_SCRIPT } from '@swal/ui/theme-boot'
import GosShell from '../components/GosShell.svelte'
import OfflineBanner from '../components/OfflineBanner.astro'
import TranslateMenu from '../components/TranslateMenu.astro'
import { ogMeta } from '../lib/images'
import { SITE_URL } from '../lib/seo'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  canonical?: string
  type?: string
  /** Saca la pagina del indice de buscadores. Para fichas sin datos aun. */
  noindex?: boolean
}

const {
  title = 'GOS — Gastronomic Open Standard',
  // Default sin stack tecnico: el texto anterior ("· Astro 7 + Svelte 5 +
  // Antigravity") no le dice nada a quien busca y empujaba a 576 paginas a
  // compartir la misma description. Describe el sitio, no la tecnologia.
  description = 'Base de conocimiento gastronomica abierta: recetas de todo el mundo conectadas con ingredientes, vitaminas, sabores, micronutrientes, afecciones y substancias bioactivas.',
  image,
  canonical,
  type = 'website',
  noindex = false,
} = Astro.props

const robots = noindex ? 'noindex, follow' : 'index, follow'

const base = import.meta.env.BASE_URL
const baseClean = base.replace(/\/$/, '')
const siteOrigin = SITE_URL

const pathname = Astro.url?.pathname || '/'
const canonicalUrl =
  canonical ||
  `${siteOrigin}${pathname.startsWith('/') ? pathname : `/${pathname}`}`
// Google y los crawlers sociales no aceptan SVG en og:image/twitter:image.
// ogMeta() mapea cada SVG a su PNG de 1200x630, cae a og-default.png y deja
// intactas las imagenes raster que el sitio ya emitia.
const og = ogMeta(image, siteOrigin)

// El item activo del menu sale de la URL, no de cada pagina.
const currentPath = pathname.replace(/\/+$/, '') || '/'
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <!-- Color de la barra del navegador / PWA: el fondo del tema Bone. var() no
         vale en <meta>, asi que el claro se resuelve con la media query. -->
    <meta name="theme-color" content="#121211" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f5" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Gastronomic Open Standard" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og.url} />
    <meta property="og:image:type" content={og.type} />
    {
      og.width && (
        <>
          <meta property="og:image:width" content={String(og.width)} />
          <meta property="og:image:height" content={String(og.height)} />
        </>
      )
    }

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@gos_standard" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.url} />

    <link rel="manifest" href={`${baseClean}/manifest.json`} />
    <link rel="icon" type="image/svg+xml" href={`${baseClean}/favicon.svg`} />
    <!-- Fuentes del sistema (--swal-font): sin CDN, la PWA funciona offline. -->
    <!-- Tema sin destello: aplica ANTES de pintar solo la eleccion guardada
         (swal-theme); sin eleccion el CSS sigue a prefers-color-scheme. -->
    <script is:inline set:html={THEME_BOOT_SCRIPT}></script>
    <style is:global>
      :root { --font-sans: var(--swal-font, ui-sans-serif, system-ui, sans-serif); }
      html { max-width: 100%; overflow-x: hidden; scroll-behavior: smooth; scroll-padding-block: 5rem; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0;
        min-height: 100vh;
        max-width: 100%;
        overflow-x: hidden;
        background: var(--swal-bg);
        background-image: var(--swal-mesh);
        background-attachment: fixed;
        color: var(--swal-text);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
      }
      * { scrollbar-width: thin; scrollbar-color: var(--swal-border-strong) transparent; }
      /* WCAG 2.4.7: anillo de foco con el acento del tema (marfil / grafito). */
      :where(a, button, input, select, textarea, summary):focus-visible {
        outline: 2px solid var(--swal-accent);
        outline-offset: 2px;
      }
      ::selection { background: var(--swal-accent-muted); }
    </style>
  </head>
  <body>
    <OfflineBanner />
    <GosShell client:load currentPath={currentPath} base={baseClean}>
      <div slot="topbar"><TranslateMenu /></div>
      <div class="gos-content">
        <slot />

        <footer class="gos-footer">
          <div>
            <div class="gos-footer-title">GOS · Gastronomic Open Standard v2.0</div>
            <div class="gos-footer-line">Grafo abierto: recetas ↔ ingredientes ↔ vitaminas ↔ sabores ↔ afecciones ↔ dietas ↔ substancias.</div>
            <div class="gos-footer-note">Datos abiertos · grafo interactivo · funciona sin conexión</div>
          </div>
          <a href="https://github.com/iberi22/gastronomic-open-standard-GOS">GitHub · iberi22/GOS</a>
        </footer>
      </div>
    </GosShell>

    <Toaster client:load />
    <style is:global>
      .gos-content { max-width: 1280px; margin: 0 auto; }
      .gos-footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--swal-border);
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
        font-size: 0.8125rem;
        color: var(--swal-text-secondary);
      }
      .gos-footer-title { font-weight: 600; color: var(--swal-text); }
      .gos-footer-line { font-size: 0.75rem; margin-top: 0.25rem; }
      .gos-footer-note { font-size: 0.6875rem; margin-top: 0.5rem; color: var(--swal-text-muted); }
      .gos-footer a { color: var(--swal-accent); font-size: 0.75rem; }
    </style>
    <script is:inline>
      // PWA: registrar el service worker. Sin esto /sw.js existe y sirve 200,
      // pero el navegador nunca lo instala (medido 2026-10-01 en produccion:
      // 0 registros, 0 caches) y la app no funciona offline.
      // vite-plugin-pwa genera dist/registerSW.js pero ningun layout lo
      // importaba, asi que el snippet se replica aqui a proposito.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {
            // Sin SW la app sigue usable online; no romper la carga.
          })
        })
      }
    </script>
  </body>
</html>
