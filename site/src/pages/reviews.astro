---
import Layout from '../layouts/Layout.astro';
import ReviewPanel from '../components/ReviewPanel.astro';
import StarRating from '../components/StarRating.astro';
---

<Layout title="Reviews - GOS">
  <div class="max-w-4xl mx-auto">
    <header class="mb-8">
      <h1 class="text-4xl font-display text-primary mb-2">Reviews</h1>
      <p class="text-gray-400">Reseñas de la red gastronómica GOS</p>
    </header>

    <div id="review-list" class="space-y-4 mb-8">
      <!-- Reviews loaded dynamically from GunDB -->
      <div class="text-gray-500 text-center py-8">
        Cargando reseñas...
      </div>
    </div>

    <section class="border-t border-white/10 pt-8">
      <h2 class="text-2xl font-display mb-4">Crear Review</h2>
      <ReviewPanel />
    </section>
  </div>
</Layout>

<script>
  import { getReviews, onReviewAdded } from '../lib/gundb';

  async function loadReviews() {
    const container = document.getElementById('review-list');
    if (!container) return;

    try {
      const reviews = await getReviews();
      if (reviews.length === 0) {
        container.innerHTML = '<p class="text-gray-500 text-center py-8">No hay reseñas aún. ¡Sé el primero!</p>';
        return;
      }

      container.innerHTML = reviews.map(review => `
        <article class="p-4 bg-white/5 rounded-xl border border-white/10">
          <div class="flex items-start justify-between mb-2">
            <div>
              <h3 class="font-display text-xl">${review.placeName || 'Sin nombre'}</h3>
              <p class="text-gray-500 text-sm">${review.location || ''}</p>
            </div>
            <div class="text-primary text-lg">${'⭐'.repeat(review.rating || 0)}</div>
          </div>
          <p class="text-gray-300">${review.comment || ''}</p>
          <div class="mt-2 text-xs text-gray-600">
            ${review.timestamp ? new Date(review.timestamp).toLocaleDateString('es-CO') : ''}
          </div>
        </article>
      `).join('');
    } catch (e) {
      console.error('Error loading reviews:', e);
      container.innerHTML = '<p class="text-red-500 text-center py-8">Error cargando reseñas</p>';
    }
  }

  loadReviews();

  // Listen for new reviews
  if (typeof onReviewAdded === 'function') {
    onReviewAdded(() => loadReviews());
  }
</script>