---
import Layout from '../layouts/Layout.astro';
import ReviewPanel from '../components/ReviewPanel.astro';
import StarRating from '../components/StarRating.astro';
---

<Layout title="Reviews - GOS">
  <div class="max-w-4xl mx-auto">
    <header class="mb-8">
      <h1 class="text-4xl font-display text-primary mb-2">Reviews</h1>
      <p class="text-gray-400">Reseñas de la red gastronómica GOS</p>
    </header>

    <!-- Filter & Sort Controls -->
    <div class="flex flex-wrap gap-4 mb-8 p-4 bg-white/5 rounded-xl border border-white/10">
      <div class="flex-1 min-w-[200px]">
        <label for="filter-country" class="block text-xs text-gray-500 mb-1">Filtrar por país</label>
        <select id="filter-country" class="w-full px-3 py-2 bg-white/10 border border-white/20 rounded-lg focus:border-primary focus:outline-none text-sm">
          <option value="">Todos los países</option>
          <option value="CO">🇨🇴 Colombia</option>
          <option value="PE">🇵🇪 Perú</option>
          <option value="MX">🇲🇽 México</option>
          <option value="AR">🇦🇷 Argentina</option>
          <option value="US">🇺🇸 Estados Unidos</option>
          <option value="CN">🇨🇳 China</option>
        </select>
      </div>
      <div class="flex-1 min-w-[200px]">
        <label for="sort-order" class="block text-xs text-gray-500 mb-1">Ordenar por</label>
        <select id="sort-order" class="w-full px-3 py-2 bg-white/10 border border-white/20 rounded-lg focus:border-primary focus:outline-none text-sm">
          <option value="date-desc">Más recientes</option>
          <option value="date-asc">Más antiguos</option>
          <option value="rating-desc">Mayor calificación</option>
          <option value="rating-asc">Menor calificación</option>
        </select>
      </div>
      <div class="flex items-end">
        <button id="refresh-reviews" class="px-4 py-2 bg-secondary text-white rounded-lg hover:bg-secondary/80 transition-colors text-sm">
          🔄 Actualizar
        </button>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading-state" class="text-center py-12">
      <div class="inline-block w-8 h-8 border-4 border-primary/30 border-t-primary rounded-full animate-spin mb-4"></div>
      <p class="text-gray-500">Cargando reseñas desde GunDB...</p>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-12">
      <div class="text-6xl mb-4">🍽️</div>
      <h3 class="text-xl font-display mb-2 text-gray-300">No hay reseñas aún</h3>
      <p class="text-gray-500 mb-4">¡Sé el primero en compartir tu experiencia!</p>
      <a href="#review-form" class="inline-block px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary/80 transition-colors">
        Crear mi primera review
      </a>
    </div>

    <!-- Error State -->
    <div id="error-state" class="hidden text-center py-12">
      <div class="text-6xl mb-4">⚠️</div>
      <h3 class="text-xl font-display mb-2 text-red-400">Error al cargar</h3>
      <p id="error-message" class="text-gray-500 mb-4">No se pudieron cargar las reseñas</p>
      <button id="retry-btn" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary/80 transition-colors">
        Reintentar
      </button>
    </div>

    <!-- Reviews Container -->
    <div id="review-list" class="space-y-4 mb-8"></div>

    <!-- Review Count -->
    <div id="review-count" class="text-sm text-gray-600 mb-8"></div>

    <section class="border-t border-white/10 pt-8">
      <h2 class="text-2xl font-display mb-4">Crear Review</h2>
      <ReviewPanel />
    </section>
  </div>
</Layout>

<script>
  import { getReviews, onReviewAdded } from '../lib/gundb';

  interface Review {
    id: string;
    placeName: string;
    location?: string;
    rating: number;
    comment?: string;
    timestamp: number;
    country: string;
  }

  let allReviews: Review[] = [];
  let currentFilter = '';
  let currentSort = 'date-desc';

  const loadingEl = document.getElementById('loading-state');
  const emptyEl = document.getElementById('empty-state');
  const errorEl = document.getElementById('error-state');
  const errorMsgEl = document.getElementById('error-message');
  const listEl = document.getElementById('review-list');
  const countEl = document.getElementById('review-count');
  const filterCountryEl = document.getElementById('filter-country') as HTMLSelectElement;
  const sortOrderEl = document.getElementById('sort-order') as HTMLSelectElement;

  function showState(state: 'loading' | 'empty' | 'error' | 'content') {
    loadingEl?.classList.add('hidden');
    emptyEl?.classList.add('hidden');
    errorEl?.classList.add('hidden');
    listEl?.classList.add('hidden');

    switch (state) {
      case 'loading':
        loadingEl?.classList.remove('hidden');
        break;
      case 'empty':
        emptyEl?.classList.remove('hidden');
        break;
      case 'error':
        errorEl?.classList.remove('hidden');
        break;
      case 'content':
        listEl?.classList.remove('hidden');
        break;
    }
  }

  function renderReviews(reviews: Review[]) {
    if (!listEl) return;

    if (reviews.length === 0) {
      listEl.innerHTML = '';
      showState('empty');
      return;
    }

    // Apply filter
    let filtered = reviews;
    if (currentFilter) {
      filtered = reviews.filter(r => r.country === currentFilter);
    }

    // Apply sort
    filtered = [...filtered].sort((a, b) => {
      switch (currentSort) {
        case 'date-desc': return b.timestamp - a.timestamp;
        case 'date-asc': return a.timestamp - b.timestamp;
        case 'rating-desc': return b.rating - a.rating;
        case 'rating-asc': return a.rating - b.rating;
        default: return 0;
      }
    });

    listEl.innerHTML = filtered.map(review => {
      const date = review.timestamp ? new Date(review.timestamp).toLocaleDateString('es-CO', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      }) : '';
      const flag = getFlag(review.country);
      const stars = '⭐'.repeat(review.rating || 0);

      return `
        <article class="p-4 bg-white/5 rounded-xl border border-white/10 hover:border-primary/30 transition-colors">
          <div class="flex items-start justify-between mb-2">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <h3 class="font-display text-lg">${escapeHtml(review.placeName || 'Sin nombre')}</h3>
                <span class="text-lg">${flag}</span>
              </div>
              <p class="text-gray-500 text-sm">${escapeHtml(review.location || '')}</p>
            </div>
            <div class="text-primary text-lg text-right">
              <div>${stars}</div>
              <div class="text-xs text-gray-600">${review.rating}/5</div>
            </div>
          </div>
          ${review.comment ? `<p class="text-gray-300 mb-2">${escapeHtml(review.comment)}</p>` : ''}
          <div class="flex items-center justify-between mt-2 text-xs text-gray-600">
            <span>📅 ${date}</span>
            <span class="text-gray-700">#${review.id.slice(0, 8)}</span>
          </div>
        </article>
      `;
    }).join('');

    // Update count
    if (countEl) {
      const total = reviews.length;
      const shown = filtered.length;
      countEl.textContent = shown === total
        ? `Mostrando ${total} reseñas`
        : `Mostrando ${shown} de ${total} reseñas`;
    }

    showState('content');
  }

  function getFlag(country: string): string {
    const flags: Record<string, string> = {
      'CO': '🇨🇴', 'PE': '🇵🇪', 'MX': '🇲🇽',
      'AR': '🇦🇷', 'US': '🇺🇸', 'CN': '🇨🇳'
    };
    return flags[country] || '🌍';
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  async function loadReviews() {
    showState('loading');

    try {
      const reviews = await getReviews();
      allReviews = reviews;

      if (reviews.length === 0) {
        showState('empty');
      } else {
        renderReviews(reviews);
      }
    } catch (e) {
      console.error('Error loading reviews:', e);
      if (errorMsgEl) {
        errorMsgEl.textContent = (e as Error).message || 'Error de conexión con GunDB';
      }
      showState('error');
    }
  }

  // Event listeners
  filterCountryEl?.addEventListener('change', () => {
    currentFilter = filterCountryEl.value;
    renderReviews(allReviews);
  });

  sortOrderEl?.addEventListener('change', () => {
    currentSort = sortOrderEl.value;
    renderReviews(allReviews);
  });

  document.getElementById('refresh-reviews')?.addEventListener('click', () => {
    loadReviews();
  });

  document.getElementById('retry-btn')?.addEventListener('click', () => {
    loadReviews();
  });

  // Initial load
  loadReviews();

  // Listen for real-time updates when new reviews are added
  if (typeof onReviewAdded === 'function') {
    onReviewAdded((review: Review) => {
      // Check if review already exists
      const exists = allReviews.some(r => r.id === review.id);
      if (!exists) {
        allReviews.push(review);
        renderReviews(allReviews);
      }
    });
  }

  // Set saved filter/sort from localStorage
  const savedFilter = localStorage.getItem('gos_reviews_filter_country');
  const savedSort = localStorage.getItem('gos_reviews_sort');

  if (savedFilter && filterCountryEl) {
    filterCountryEl.value = savedFilter;
    currentFilter = savedFilter;
  }

  if (savedSort && sortOrderEl) {
    sortOrderEl.value = savedSort;
    currentSort = savedSort;
  }

  // Persist filter/sort
  filterCountryEl?.addEventListener('change', () => {
    localStorage.setItem('gos_reviews_filter_country', filterCountryEl.value);
  });

  sortOrderEl?.addEventListener('change', () => {
    localStorage.setItem('gos_reviews_sort', sortOrderEl.value);
  });
</script>
