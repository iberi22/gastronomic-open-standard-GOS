---
import Layout from '../../layouts/Layout.astro';
import SubstanceCard from '../../components/SubstanceCard.svelte';
import { getCollection } from 'astro:content';

const substances = await getCollection('substances');
substances.sort((a, b) => (a.data.name || '').localeCompare(b.data.name || ''));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Enciclopedia de Substancias Culinarias y Bioactivas — GOS">
  <div class="header">
    <div class="breadcrumb">
      <a href={`${base}/`}>Inicio</a> / <a href={`${base}/scientific`}>Ciencia</a> / <span>Substancias</span>
    </div>
    <h1 class="title">Enciclopedia de Substancias Bioactivas ({substances.length})</h1>
    <p class="subtitle">
      Compuestos químicos, principios activos y moléculas responsables del perfil organoléptico (sazón, sabor, textura) y propiedades medicinales de los ingredientes del Gastronomic Open Standard.
    </p>
  </div>

  <div class="grid">
    {substances.map(substance => (
      <SubstanceCard substance={substance as any} base={base} client:load />
    ))}
  </div>

  <style>
    .header {
      margin-bottom: 24px;
    }
    .breadcrumb {
      font-size: 12px;
      color: var(--swal-text-muted);
      margin-bottom: 8px;
    }
    .breadcrumb a {
      color: var(--swal-accent);
      text-decoration: none;
    }
    .title {
      font-size: 26px;
      font-weight: 800;
      margin: 0 0 8px 0;
      color: var(--swal-text);
    }
    .subtitle {
      font-size: 14px;
      color: var(--swal-text-secondary);
      max-width: 800px;
      line-height: 1.6;
      margin: 0;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
    }
  </style>
</Layout>
