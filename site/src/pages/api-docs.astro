---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="API Documentation - AI Chef">
  <div class="relative min-h-screen w-full flex flex-col">
    <!-- Header -->
    <header class="sticky top-0 z-50 w-full glass-panel border-b border-[#e6e6db] dark:border-[#333]">
      <div class="mx-auto flex h-20 max-w-[1440px] items-center justify-between px-6 lg:px-10">
        <div class="flex items-center gap-4">
          <a href={baseUrl} class="flex size-10 items-center justify-center rounded-xl bg-surface-light dark:bg-surface-dark border border-gray-200 dark:border-gray-700 text-text-light dark:text-text-dark hover:bg-primary hover:text-black hover:border-primary transition-all shadow-sm">
            <span class="material-symbols-outlined">arrow_back</span>
          </a>
          <h2 class="text-xl font-bold tracking-tight hidden md:block">API Documentation</h2>
        </div>
        <div class="flex items-center gap-2">
            <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="flex-1 container mx-auto px-4 py-8 max-w-4xl">
      <div class="glass-panel rounded-2xl p-8 md:p-12 shadow-xl ring-1 ring-black/5 dark:ring-white/10 bg-surface-light dark:bg-surface-dark">
        <h1 class="font-display text-4xl font-black tracking-tight text-text-light dark:text-text-dark mb-6">
          API Documentation
        </h1>

        <p class="text-lg mb-8 text-gray-600 dark:text-gray-300">
          Access all recipes programmatically through our JSON API. All endpoints return structured data
          with recipe metadata, ingredients, and preparation details.
        </p>

        <div class="bg-black/5 dark:bg-white/5 rounded-xl p-6 mb-8 border border-black/10 dark:border-white/10">
          <p class="font-bold text-primary uppercase tracking-widest text-xs mb-2">Base URL</p>
          <code class="text-sm font-mono block w-full overflow-x-auto text-text-light dark:text-text-dark">https://iberi22.github.io/gastronomic-open-standard-GOS/api/</code>
        </div>

        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6 text-text-light dark:text-text-dark border-b border-gray-200 dark:border-gray-700 pb-2">Main Endpoints</h2>

          <div class="grid gap-4">
            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/index.json</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">API index with statistics and available endpoints</p>
              <a href={`${baseUrl}/api/index.json`} class="inline-flex items-center text-sm font-bold text-text-light dark:text-text-dark hover:text-primary transition-colors">
                View response <span class="material-symbols-outlined text-[16px] ml-1">arrow_forward</span>
              </a>
            </div>

            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/all.json</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">All recipes (160 total)</p>
              <a href={`${baseUrl}/api/all.json`} class="inline-flex items-center text-sm font-bold text-text-light dark:text-text-dark hover:text-primary transition-colors">
                View response <span class="material-symbols-outlined text-[16px] ml-1">arrow_forward</span>
              </a>
            </div>

            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/docs.json</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">OpenAPI 3.0 specification for all endpoints</p>
              <a href={`${baseUrl}/api/docs.json`} class="inline-flex items-center text-sm font-bold text-text-light dark:text-text-dark hover:text-primary transition-colors">
                View OpenAPI spec <span class="material-symbols-outlined text-[16px] ml-1">arrow_forward</span>
              </a>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6 text-text-light dark:text-text-dark border-b border-gray-200 dark:border-gray-700 pb-2">Recipe Endpoints</h2>

          <div class="grid gap-4">
            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/countries/[country].json</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">Get all recipes from a specific country (colombia, china, peru)</p>
              <code class="text-xs bg-gray-100 dark:bg-gray-800 p-2 rounded mb-2">?page=1&amp;limit=50</code>
            </div>

            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/all.json (single recipe by search)</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">Get a single recipe by ID with full details, sensory data, and sources</p>
              <code class="text-xs bg-gray-100 dark:bg-gray-800 p-2 rounded mb-2">Example: /api/recipes/colombian/nacionales/chuzo</code>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6 text-text-light dark:text-text-dark border-b border-gray-200 dark:border-gray-700 pb-2">Sensory &amp; Sources Endpoints</h2>

          <div class="grid gap-4">
            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/sensory/[recipe_id].json</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">Get sensory profile (flavor, texture, aroma, presentation) for a recipe</p>
            </div>

            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/sources/[recipe_id].json</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">Get video, article, and image sources for a recipe</p>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6 text-text-light dark:text-text-dark border-b border-gray-200 dark:border-gray-700 pb-2">Graph Endpoints</h2>

          <div class="grid gap-4">
            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/graph/nodes.json</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">Get all nodes for the recipe relationship graph</p>
            </div>

            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/graph/edges.json</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">Get all edges (relationships) for the recipe graph</p>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6 text-text-light dark:text-text-dark border-b border-gray-200 dark:border-gray-700 pb-2">Ingredient Endpoints</h2>

          <div class="grid gap-4">
            <div class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-surface-dark dark:hover:border-primary">
              <h3 class="font-mono text-sm font-bold text-primary mb-2">GET /api/ingredients/[id].json</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">Get detailed information about an ingredient</p>
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6 text-text-light dark:text-text-dark border-b border-gray-200 dark:border-gray-700 pb-2">Sensory Data Coverage</h2>

          <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-6 border border-green-200 dark:border-green-800">
            <p class="font-bold text-green-800 dark:text-green-200 mb-4">Current Status:</p>
            <ul class="list-disc list-inside text-sm text-green-700 dark:text-green-300 space-y-1">
              <li><strong>79</strong> recipes have complete sensory data (49.7%)</li>
              <li><strong>78</strong> Colombian recipes have sensory data (71.6%)</li>
              <li><strong>0</strong> Chinese recipes have sensory data (0%) - needs attention</li>
            </ul>
          </div>
        </section>
      </div>
    </main>
  </div>
</Layout>
