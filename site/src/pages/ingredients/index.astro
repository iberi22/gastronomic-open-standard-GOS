---
import { getCollection } from 'astro:content'
import SearchBar from '../../components/SearchBar.astro'
// site/src/pages/ingredients/index.astro — searchable + faceted ingredient catalog
import Layout from '../../layouts/Layout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const ingredients = await getCollection('ingredients')

// Build search index data (full list, no slicing)
const items = ingredients
  .map((e) => ({
    id: e.id,
    name: e.data.name || e.id,
    group: e.data.group || '',
    scientific_name: e.data.scientific_name || '',
    health: e.data.health_registry?.[0]?.condition || '',
  }))
  .sort((a, b) => a.name.localeCompare(b.name))

// Compute unique facets (group only — top 20 to avoid clutter)
const allGroups = items.map((i) => i.group).filter(Boolean)
const groupCounts = new Map<string, number>()
allGroups.forEach((g) => {
  groupCounts.set(g, (groupCounts.get(g) || 0) + 1)
})
const facets = [...groupCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 20)
  .map(([g]) => g)
---

<Layout title="Ingredientes — GOS">
  <h1 class="title">Ingredientes científicos</h1>
  <p class="sub">
    Fichas con <strong>nutrición, compuestos activos, vitaminas</strong> y <strong>registro de salud</strong>
    (mecanismo, evidencia, estudios PubMed). Cada ficha alimenta el grafo
    con sus vitaminas, substancias y afecciones.
  </p>
  <p class="stats">
    <strong>{items.length}</strong> ingredientes · <strong>{facets.length}</strong> grupos
  </p>

  <SearchBar
    items={items}
    baseHref={`${base}/ingredients`}
    placeholder="Buscar por nombre, nombre científico o afección..."
    facets={facets}
    fuseKeys={['name', 'scientific_name', 'health']}
  />

  <p class="back-link"><a href={`${base}/`}>← Volver al inicio</a></p>
</Layout>

<style>
  .title { font-size: 26px; font-weight: 850; margin: 0; color: var(--swal-text); }
  .sub { color: var(--swal-text-secondary); line-height: 1.6; font-size: 13px; max-width: 800px; margin-top: 8px; }
  .sub code { font-family: var(--swal-font-mono); font-size: 11px; background: var(--swal-surface); border: 1px solid var(--swal-border); padding: 1px 5px; border-radius: 6px; }
  .stats { color: var(--swal-text-muted); font-size: 12px; font-family: var(--swal-font-mono); margin-top: 6px; }
  .stats strong { color: var(--swal-accent); }
  .back-link { margin-top: 32px; font-size: 13px; }
  .back-link a { color: var(--swal-accent); text-decoration: none; }
  .back-link a:hover { text-decoration: underline; }
</style>