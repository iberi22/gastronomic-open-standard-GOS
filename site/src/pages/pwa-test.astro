---
import Layout from '../layouts/Layout.astro';
---

<Layout title="PWA Test - GOS">
	<div class="container mx-auto px-4 py-8 max-w-4xl">
		<header class="mb-8">
			<h1 class="text-4xl font-display text-primary mb-2">🧪 PWA Diagnostics</h1>
			<p class="text-text-secondary dark:text-text-secondary-dark">Test your GOS PWA installation</p>
		</header>

		<!-- Test Results Grid -->
		<div class="grid gap-4" id="test-grid">
			
			<!-- Service Worker Test -->
			<div class="test-card card-glass p-5 rounded-xl" data-test="service-worker">
				<div class="flex items-center justify-between mb-3">
					<div class="flex items-center gap-3">
						<span class="text-2xl">📡</span>
						<div>
							<h2 class="font-display text-xl">Service Worker</h2>
							<p class="text-sm text-text-secondary dark:text-gray-400">SW registration status</p>
						</div>
					</div>
					<span class="test-status text-lg" id="sw-status">⏳</span>
				</div>
				<div class="result-details hidden text-sm" id="sw-details"></div>
			</div>

			<!-- Cache API Test -->
			<div class="test-card card-glass p-5 rounded-xl" data-test="cache-api">
				<div class="flex items-center justify-between mb-3">
					<div class="flex items-center gap-3">
						<span class="text-2xl">💾</span>
						<div>
							<h2 class="font-display text-xl">Cache API</h2>
							<p class="text-sm text-text-secondary dark:text-gray-400">Read/write caching</p>
						</div>
					</div>
					<span class="test-status text-lg" id="cache-status">⏳</span>
				</div>
				<div class="result-details hidden text-sm" id="cache-details"></div>
			</div>

			<!-- IndexedDB / GunDB Test -->
			<div class="test-card card-glass p-5 rounded-xl" data-test="indexeddb">
				<div class="flex items-center justify-between mb-3">
					<div class="flex items-center gap-3">
						<span class="text-2xl">🗄️</span>
						<div>
							<h2 class="font-display text-xl">IndexedDB / GunDB</h2>
							<p class="text-sm text-text-secondary dark:text-gray-400">Local data storage</p>
						</div>
					</div>
					<span class="test-status text-lg" id="idb-status">⏳</span>
				</div>
				<div class="result-details hidden text-sm" id="idb-details"></div>
			</div>

			<!-- Network Detection Test -->
			<div class="test-card card-glass p-5 rounded-xl" data-test="network">
				<div class="flex items-center justify-between mb-3">
					<div class="flex items-center gap-3">
						<span class="text-2xl">📶</span>
						<div>
							<h2 class="font-display text-xl">Network Status</h2>
							<p class="text-sm text-text-secondary dark:text-gray-400">Online/offline detection</p>
						</div>
					</div>
					<span class="test-status text-lg" id="network-status">⏳</span>
				</div>
				<div class="flex items-center gap-2">
					<span class="text-sm text-text-secondary dark:text-gray-400">Current:</span>
					<span id="network-state" class="font-semibold">—</span>
				</div>
			</div>

			<!-- PWA Installability Test -->
			<div class="test-card card-glass p-5 rounded-xl" data-test="installable">
				<div class="flex items-center justify-between mb-3">
					<div class="flex items-center gap-3">
						<span class="text-2xl">📲</span>
						<div>
							<h2 class="font-display text-xl">PWA Installability</h2>
							<p class="text-sm text-text-secondary dark:text-gray-400">Manifest + requirements</p>
						</div>
					</div>
					<span class="test-status text-lg" id="install-status">⏳</span>
				</div>
				<div class="result-details hidden text-sm" id="install-details"></div>
			</div>

		</div>

		<!-- Manual Test Instructions -->
		<section class="mt-8 card-glass p-6 rounded-xl">
			<h2 class="font-display text-2xl mb-4">📋 Manual Test Checklist</h2>
			<div class="grid md:grid-cols-2 gap-4 text-sm">
				<div class="flex gap-3 items-start">
					<span class="text-primary text-lg">1.</span>
					<div>
						<p class="font-semibold">Install App</p>
						<p class="text-text-secondary dark:text-gray-400">Click "Install" in browser menu or address bar icon</p>
					</div>
				</div>
				<div class="flex gap-3 items-start">
					<span class="text-primary text-lg">2.</span>
					<div>
						<p class="font-semibold">Offline Mode</p>
						<p class="text-text-secondary dark:text-gray-400">Enable airplane mode and navigate the site</p>
					</div>
				</div>
				<div class="flex gap-3 items-start">
					<span class="text-primary text-lg">3.</span>
					<div>
						<p class="font-semibold">Home Screen</p>
						<p class="text-text-secondary dark:text-gray-400">Check app appears correctly when added to home screen</p>
					</div>
				</div>
				<div class="flex gap-3 items-start">
					<span class="text-primary text-lg">4.</span>
					<div>
						<p class="font-semibold">Push Notifications</p>
						<p class="text-text-secondary dark:text-gray-400">If implemented, test notification delivery</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Run Tests Button -->
		<div class="mt-6 text-center">
			<button id="run-tests" class="px-6 py-3 bg-primary hover:bg-primary/90 text-white font-display text-lg rounded-full transition-all active:scale-95">
				🔄 Run All Tests
			</button>
			<button id="run-node-script" class="ml-4 px-6 py-3 bg-secondary hover:bg-secondary/90 text-white font-display text-lg rounded-full transition-all active:scale-95 hidden">
				📝 Run Node Verification
			</button>
		</div>

		<!-- Node Script Output -->
		<div id="node-output" class="mt-6 hidden">
			<pre id="node-output-text" class="bg-gray-900 text-green-400 p-4 rounded-xl text-sm overflow-x-auto"></pre>
		</div>

		<footer class="mt-12 text-center text-sm text-text-secondary dark:text-gray-500">
			<p>GOS PWA Diagnostics v1.0</p>
		</footer>
	</div>
</Layout>

<style>
	.test-card {
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.test-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px -5px rgba(0,0,0,0.1);
	}
	.dark .test-card:hover {
		box-shadow: 0 8px 25px -5px rgba(0,0,0,0.4);
	}
	.result-details {
		margin-top: 0.5rem;
		padding-top: 0.5rem;
		border-top: 1px solid rgba(128,128,128,0.2);
	}
	.pass { color: #4CAF50; }
	.fail { color: #FF6347; }
	.warn { color: #FFC107; }
</style>

<script is:inline>
	const PASS = '✅';
	const FAIL = '❌';
	const WARN = '⚠️';
	const SKIP = '⏭️';

 function setResult(id, status, detailsEl, msg) {
   const el = document.getElementById(id);
   if (el) el.textContent = status;
   if (detailsEl) {
     detailsEl.classList.remove('hidden');
     detailsEl.innerHTML = msg;
   }
 }

 function getResultClass(status) {
   if (status === PASS) return 'pass';
   if (status === FAIL) return 'fail';
   if (status === WARN) return 'warn';
   return '';
 }

 // Test 1: Service Worker
 async function testServiceWorker() {
   const statusEl = 'sw-status';
   const detailsEl = document.getElementById('sw-details');
   try {
     if (!('serviceWorker' in navigator)) {
       setResult(statusEl, FAIL, detailsEl, 'Service Worker API not available');
       return;
     }
     const reg = await navigator.serviceWorker.ready;
     const sws = await navigator.serviceWorker.getRegistrations();
     if (sws.length === 0) {
       setResult(statusEl, WARN, detailsEl, 'No SW registered yet. Reload and check again.');
       return;
     }
     const active = sws.find(r => r.active);
     if (!active) {
       setResult(statusEl, WARN, detailsEl, 'SW found but no active worker');
       return;
     }
     setResult(statusEl, PASS, detailsEl, `Active: ${active.scope}`);
   } catch(e) {
     setResult(statusEl, FAIL, detailsEl, e.message);
   }
 }

 // Test 2: Cache API
 async function testCacheAPI() {
   const statusEl = 'cache-status';
   const detailsEl = document.getElementById('cache-details');
   try {
     if (!('caches' in window)) {
       setResult(statusEl, FAIL, detailsEl, 'Cache API not available');
       return;
     }
     const testKey = 'gos-test-' + Date.now();
     const testVal = new Response('test');
     const cache = await caches.open(testKey);
     await cache.put(testKey, testVal);
     const val = await cache.match(testKey);
     await caches.delete(testKey);
     if (val) {
       setResult(statusEl, PASS, detailsEl, 'Cache read/write OK');
     } else {
       setResult(statusEl, FAIL, detailsEl, 'Cache write succeeded but read failed');
     }
   } catch(e) {
     setResult(statusEl, FAIL, detailsEl, e.message);
   }
 }

 // Test 3: IndexedDB / GunDB
 async function testIndexedDB() {
   const statusEl = 'idb-status';
   const detailsEl = document.getElementById('idb-details');
   try {
     if (!('indexedDB' in window)) {
       setResult(statusEl, FAIL, detailsEl, 'IndexedDB not available');
       return;
     }
     const db = await new Promise((res, rej) => {
       const req = indexedDB.open('gos-test-' + Date.now(), 1);
       req.onupgradeneeded = () => res(req.result);
       req.onsuccess = () => res(req.result);
       req.onerror = () => rej(req.error);
     });
     db.close();
     setResult(statusEl, PASS, detailsEl, 'IndexedDB operational');
   } catch(e) {
     setResult(statusEl, FAIL, detailsEl, e.message);
   }
 }

 // Test 4: Network Status
 function testNetwork() {
   const statusEl = 'network-status';
   const networkState = document.getElementById('network-state');
   const online = navigator.onLine;
   if (networkState) {
     networkState.textContent = online ? '🟢 Online' : '🔴 Offline';
     networkState.className = online ? 'text-green-500 font-semibold' : 'text-red-500 font-semibold';
   }
   setResult(statusEl, online ? PASS : WARN, null, online ? 'Network is online' : 'Network appears offline');
 }

 // Test 5: PWA Installability
 async function testInstallable() {
   const statusEl = 'install-status';
   const detailsEl = document.getElementById('install-details');
   try {
     const manifestRes = await fetch('/manifest.json');
     if (!manifestRes.ok) {
       setResult(statusEl, FAIL, detailsEl, 'manifest.json not found');
       return;
     }
     const manifest = await manifestRes.json();
     const missing = [];
     if (!manifest.name) missing.push('name');
     if (!manifest.icons || manifest.icons.length === 0) missing.push('icons');
     if (!manifest.start_url) missing.push('start_url');
     if (!manifest.display) missing.push('display');

     const hasInstallPrompt = 'beforeinstallprompt' in window;
     if (missing.length > 0) {
       setResult(statusEl, FAIL, detailsEl, `Missing: ${missing.join(', ')}`);
       return;
     }
     if (!hasInstallPrompt) {
       setResult(statusEl, WARN, detailsEl, 'Manifest OK but beforeinstallprompt not fired yet (may need more site interaction)');
       return;
     }
     setResult(statusEl, PASS, detailsEl, `Ready to install! Icons: ${manifest.icons.length}`);
   } catch(e) {
     setResult(statusEl, FAIL, detailsEl, e.message);
   }
 }

 // Run all tests
 async function runAllTests() {
   await Promise.all([
     testServiceWorker(),
     testCacheAPI(),
     testIndexedDB(),
     testNetwork(),
     testInstallable()
   ]);
 }

 // Listen online/offline
 window.addEventListener('online', testNetwork);
 window.addEventListener('offline', testNetwork);

 // Button handlers
 document.getElementById('run-tests')?.addEventListener('click', runAllTests);

 document.getElementById('run-node-script')?.addEventListener('click', async () => {
   const output = document.getElementById('node-output');
   const outputText = document.getElementById('node-output-text');
   if (output) output.classList.remove('hidden');
   if (outputText) outputText.textContent = 'Running verification script...';

   try {
     const res = await fetch('/scripts/test-pwa.cjs');
     if (!res.ok) throw new Error('Script not found at /scripts/test-pwa.cjs');
     const text = await res.text();
     if (outputText) outputText.textContent = 'Note: test-pwa.cjs is a Node.js script. Run it from terminal:\n\nnode scripts/test-pwa.cjs';
   } catch(e) {
     if (outputText) outputText.textContent = 'Error: ' + e.message;
   }
 });

 // Auto-run on load
 runAllTests();
</script>
