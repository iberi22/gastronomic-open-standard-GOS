---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const recipes = await getCollection('dishes');
const sorted = recipes.filter(r=>(r.data as any).region).sort((a,b)=> ((a.data as any).title||a.id).localeCompare((b.data as any).title||b.id));
const regions = [...new Set(sorted.map(r=>(r.data as any).region).filter(Boolean))].sort();
---
<Layout title="Recetas — GOS">
  <h1 class="title">Recetas del grafo global</h1>
  <p class="sub">Base de <strong>{sorted.length}</strong> recetas de <code>dishes/</code> — con región, categorías, dificultad y grafo <code>USES → ingredient</code>. Filtra por región.</p>

  <div class="filters">
    {regions.map(reg => <span class="pill">{reg}</span>)}
  </div>

  <div class="grid">
    {sorted.slice(0,80).map(r => (
      <a href={`${base}/recipes/${r.id}`} class="card">
        <div class="r-title">{(r.data as any).title || r.id.split('/').pop()}</div>
        <div class="r-meta">
          {(r.data as any).region && <span class="pill">{(r.data as any).region}</span>}
          {(r.data as any).difficulty && <span class="pill muted">{(r.data as any).difficulty}</span>}
          {(r.data as any).categories?.[0] && <span class="pill accent">{(r.data as any).categories[0]}</span>}
        </div>
        {(r.data as any).main_ingredients?.length && <div class="ings">{(r.data as any).main_ingredients.slice(0,4).join(' • ')}</div>}
      </a>
    ))}
  </div>
<style>
  .title{ font-size:22px; font-weight:850; color: var(--swal-text); margin:0; }
  .sub{ color: var(--swal-text-secondary); font-size:13px; line-height:1.6; }
  .sub code{ font-family: var(--swal-font-mono); font-size:11px; background: var(--swal-surface); border:1px solid var(--swal-border); padding:1px 5px; border-radius:6px; }
  .filters{ display:flex; gap:8px; flex-wrap:wrap; margin:12px 0; }
  .pill{ font-size:11px; padding:4px 10px; border-radius:999px; background: var(--swal-surface); border:1px solid var(--swal-border); color: var(--swal-text-secondary); }
  .pill.muted{ background: var(--swal-bg); }
  .pill.accent{ background: var(--swal-accent-muted); color: var(--swal-accent); }
  .grid{ display:grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap:12px; margin-top:12px; }
  .card{ border:1px solid var(--swal-border); background: var(--swal-surface); border-radius:16px; padding:14px; text-decoration:none; color: var(--swal-text); }
  .card:hover{ border-color: color-mix(in srgb, var(--swal-accent) 30%, var(--swal-border)); }
  .r-title{ font-weight:700; line-height:1.3; }
  .r-meta{ display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; }
  .ings{ font-size:11px; color: var(--swal-text-muted); font-family: var(--swal-font-mono); margin-top:6px; }
</style>
</Layout>
