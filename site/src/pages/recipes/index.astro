---
import { getCollection } from 'astro:content'
import SearchBar from '../../components/SearchBar.astro'
// site/src/pages/recipes/index.astro — searchable + faceted recipe catalog
import Layout from '../../layouts/Layout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
interface DishFrontmatter {
  title?: string
  region?: string
  difficulty?: string
  servings?: string
  prep_time?: string
  cook_time?: string
  sources?: string[]
  categories?: string[]
  sensory?: {
    flavor?: string | string[]
    texture?: string | string[]
    aroma?: string | string[]
  }
  main_ingredients?: string[]
}
const fd = (d: unknown): DishFrontmatter => d as DishFrontmatter

const recipes = await getCollection('dishes')
const sorted = recipes
  .filter((r) => fd(r.data).region)
  .sort((a, b) =>
    String(fd(a.data).title || a.id).localeCompare(
      String(fd(b.data).title || b.id),
    ),
  )

// Build search index (full list, no slicing)
const items = sorted.map((r) => {
  const d = r.data as DishFrontmatter
  return {
    id: r.id,
    name: d.title || r.id.split('/').pop() || r.id,
    region: d.region || '',
    difficulty: d.difficulty || '',
    scientific_name: d.categories?.join(', ') || '',
    health: (d.main_ingredients || []).join(', '),
  }
})

// Compute unique facets (top regions by count)
const regionCounts = new Map<string, number>()
items.forEach((i) => {
  regionCounts.set(i.region, (regionCounts.get(i.region) || 0) + 1)
})
const regionFacets = [...regionCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 18)
  .map(([r]) => r)

// Difficulty facets (top 6)
const difficultyFacets = [
  ...new Set(items.map((i) => i.difficulty).filter(Boolean)),
].slice(0, 6)
---

<Layout title="Recetas — GOS">
  <h1 class="title">Recetas del grafo global</h1>
  <p class="sub">
    Base de <strong>{sorted.length}</strong> recetas del mundo — con región,
    categorías, dificultad e ingredientes conectados al grafo. Buscá por nombre,
    categoría o ingrediente.
  </p>

  <SearchBar
    items={items}
    baseHref={`${base}/recipes`}
    placeholder="Buscar por nombre, región, categoría o ingrediente..."
    facets={[...regionFacets, ...difficultyFacets]}
    fuseKeys={['name', 'region', 'scientific_name', 'health']}
  />

  <p class="back-link"><a href={`${base}/`}>← Volver al inicio</a></p>
</Layout>

<style>
  .title { font-size: 26px; font-weight: 850; color: var(--swal-text); margin: 0; }
  .sub { color: var(--swal-text-secondary); font-size: 13px; line-height: 1.6; margin-top: 8px; }
  .sub code { font-family: var(--swal-font-mono); font-size: 11px; background: var(--swal-surface); border: 1px solid var(--swal-border); padding: 1px 5px; border-radius: 6px; }
  .back-link { margin-top: 32px; font-size: 13px; }
  .back-link a { color: var(--swal-accent); text-decoration: none; }
  .back-link a:hover { text-decoration: underline; }
</style>