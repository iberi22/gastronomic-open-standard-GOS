---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { recipeJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const col = await getCollection('dishes');
  return col.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const data = entry.data as any;

const jsonLd = recipeJsonLd({
  slug: entry.id,
  title: data.title || entry.id,
  description: data.sensory?.presentation || `${data.title || entry.id} — receta tradicional del Gastronomic Open Standard`,
  image: data.images?.[0]?.url,
  prepTime: data.prep_time ? `PT${data.prep_time}M` : undefined,
  cookTime: data.cook_time ? `PT${data.cook_time}M` : undefined,
  recipeYield: data.servings ? `${data.servings} servings` : undefined,
  recipeIngredient: data.main_ingredients || [],
  recipeCategory: data.categories?.[0] || 'Main dish',
  recipeCuisine: data.region || 'Colombian',
  keywords: data.tags || [],
  nutrition: data.nutrition_per_serving,
});
---
<Layout
  title={`${data.title || entry.id} — Receta GOS`}
  description={data.sensory?.presentation || `${data.title || entry.id} — receta tradicional del Gastronomic Open Standard`}
  image={data.images?.[0]?.url}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <a href={`${base}/recipes`} class="back">← Recetas</a>
  <article class="article">
    <h1>{data.title || entry.id}</h1>
    <div class="meta">
      {data.region && <span class="pill">{data.region}</span>}
      {data.difficulty && <span class="pill">{data.difficulty}</span>}
      {data.prep_time && <span class="pill muted">prep {data.prep_time} min</span>}
      {data.cook_time && <span class="pill muted">cook {data.cook_time} min</span>}
      {data.servings && <span class="pill">🍽️ {data.servings}</span>}
    </div>
    {data.sensory && (
      <div class="sensory">
        {data.sensory.flavor && <div><strong>Sabor:</strong> {Array.isArray(data.sensory.flavor) ? data.sensory.flavor.join(', ') : data.sensory.flavor}</div>}
        {data.sensory.texture && <div><strong>Textura:</strong> {Array.isArray(data.sensory.texture) ? data.sensory.texture.join(', ') : data.sensory.texture}</div>}
        {data.sensory.aroma && <div><strong>Aroma:</strong> {Array.isArray(data.sensory.aroma) ? data.sensory.aroma.join(', ') : data.sensory.aroma}</div>}
      </div>
    )}
    <div class="prose"><Content /></div>
    {data.main_ingredients && <p class="ings"><strong>Ingredientes clave:</strong> {data.main_ingredients.join(' • ')}</p>}
    {data.sources && <p class="src"><small>Fuentes: {data.sources.join(' · ')}</small></p>}
  </article>
<style>
  .back{ color: var(--swal-accent); text-decoration:none; font-size:12px; }
  .article{ border:1px solid var(--swal-border); background: var(--swal-surface); border-radius:20px; padding:22px; margin-top:12px; }
  .article h1{ margin:0; font-size:24px; color: var(--swal-text); }
  .meta{ display:flex; gap:8px; flex-wrap:wrap; margin-top:8px; }
  .pill{ font-size:11px; padding:4px 10px; border-radius:999px; background: var(--swal-bg); border:1px solid var(--swal-border); color: var(--swal-text-secondary); }
  .pill.muted{ color: var(--swal-text-muted); }
  .sensory{ margin:16px 0; padding:12px; border:1px solid var(--swal-border); border-radius:16px; background: var(--swal-bg); font-size:13px; color: var(--swal-text-secondary); display:grid; gap:4px; }
  .prose{ color: var(--swal-text-secondary); line-height:1.75; }
  .prose :global(h2){ color: var(--swal-text); margin-top:1.2em; }
  .prose :global(img){ max-width:100%; border-radius:12px; border:1px solid var(--swal-border); }
  .ings{ font-family: var(--swal-font-mono); font-size:12px; color: var(--swal-text-muted); margin-top:12px; }
  .src{ color: var(--swal-text-muted); }
</style>
</Layout>
