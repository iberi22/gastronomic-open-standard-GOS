---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { recipeJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const col = await getCollection('dishes');
  return col.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const jsonLd = recipeJsonLd(entry);
---
<Layout title={`${(entry.data as any).title || entry.id} — Receta GOS`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
  <a href={`${base}/recipes`} class="back">← Recetas</a>
  <article class="article">
    <h1>{(entry.data as any).title || entry.id}</h1>
    <div class="meta">
      {(entry.data as any).region && <span class="pill">{(entry.data as any).region}</span>}
      {(entry.data as any).difficulty && <span class="pill">{(entry.data as any).difficulty}</span>}
      {(entry.data as any).prep_time && <span class="pill muted">prep {(entry.data as any).prep_time}</span>}
      {(entry.data as any).cook_time && <span class="pill muted">cook {(entry.data as any).cook_time}</span>}
      {(entry.data as any).servings && <span class="pill">🍽️ {(entry.data as any).servings}</span>}
    </div>
    {(entry.data as any).sensory && (
      <div class="sensory">
        {(entry.data as any).sensory.flavor && <div><strong>Sabor:</strong> {Array.isArray((entry.data as any).sensory.flavor) ? (entry.data as any).sensory.flavor.join(', ') : (entry.data as any).sensory.flavor}</div>}
        {(entry.data as any).sensory.texture && <div><strong>Textura:</strong> {Array.isArray((entry.data as any).sensory.texture) ? (entry.data as any).sensory.texture.join(', ') : (entry.data as any).sensory.texture}</div>}
        {(entry.data as any).sensory.aroma && <div><strong>Aroma:</strong> {Array.isArray((entry.data as any).sensory.aroma) ? (entry.data as any).sensory.aroma.join(', ') : (entry.data as any).sensory.aroma}</div>}
      </div>
    )}
    <div class="prose"><Content /></div>
    {(entry.data as any).main_ingredients && <p class="ings"><strong>Ingredientes clave:</strong> {(entry.data as any).main_ingredients.join(' • ')}</p>}
    {(entry.data as any).sources && <p class="src"><small>Fuentes: {(entry.data as any).sources.join(' · ')}</small></p>}
  </article>
<style>
  .back{ color: var(--swal-accent); text-decoration:none; font-size:12px; }
  .article{ border:1px solid var(--swal-border); background: var(--swal-surface); border-radius:20px; padding:22px; margin-top:12px; }
  .article h1{ margin:0; font-size:24px; color: var(--swal-text); }
  .meta{ display:flex; gap:8px; flex-wrap:wrap; margin-top:8px; }
  .pill{ font-size:11px; padding:4px 10px; border-radius:999px; background: var(--swal-bg); border:1px solid var(--swal-border); color: var(--swal-text-secondary); }
  .pill.muted{ color: var(--swal-text-muted); }
  .sensory{ margin:16px 0; padding:12px; border:1px solid var(--swal-border); border-radius:16px; background: var(--swal-bg); font-size:13px; color: var(--swal-text-secondary); display:grid; gap:4px; }
  .prose{ color: var(--swal-text-secondary); line-height:1.75; }
  .prose :global(h2){ color: var(--swal-text); margin-top:1.2em; }
  .prose :global(img){ max-width:100%; border-radius:12px; border:1px solid var(--swal-border); }
  .ings{ font-family: var(--swal-font-mono); font-size:12px; color: var(--swal-text-muted); margin-top:12px; }
  .src{ color: var(--swal-text-muted); }
</style>
</Layout>
