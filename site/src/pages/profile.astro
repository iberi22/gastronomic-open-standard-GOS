---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Perfil - GOS">
  <div class="max-w-4xl mx-auto">
    <header class="mb-8">
      <h1 class="text-4xl font-display text-primary mb-2">Tu Perfil</h1>
      <p class="text-gray-400">Tu identidad criptográfica en la red GOS</p>
    </header>

    <!-- Identity Card -->
    <div id="identity-card" class="mb-8 p-6 bg-white/5 rounded-xl border border-white/10">
      <div class="flex items-start gap-4 flex-wrap">
        <div id="avatar-icon" class="w-16 h-16 rounded-full bg-primary flex items-center justify-center text-2xl">👤</div>
        <div class="flex-1 min-w-[200px]">
          <div class="flex items-center gap-2 mb-1">
            <h2 id="profile-name" class="text-xl font-display">Sin identificar</h2>
            <span id="verification-badge" class="px-2 py-0.5 text-xs rounded-full bg-gray-600">?</span>
          </div>
          <p id="profile-keys" class="text-gray-500 text-sm">Claves no generadas</p>
          <div id="trust-score-container" class="mt-2 hidden">
            <div class="flex items-center gap-2">
              <span class="text-xs text-gray-500">Trust Score:</span>
              <div class="flex gap-0.5">
                <span id="trust-dot-1" class="w-2 h-2 rounded-full bg-gray-700"></span>
                <span id="trust-dot-2" class="w-2 h-2 rounded-full bg-gray-700"></span>
                <span id="trust-dot-3" class="w-2 h-2 rounded-full bg-gray-700"></span>
                <span id="trust-dot-4" class="w-2 h-2 rounded-full bg-gray-700"></span>
                <span id="trust-dot-5" class="w-2 h-2 rounded-full bg-gray-700"></span>
              </div>
              <span id="trust-score-label" class="text-xs text-gray-600"></span>
            </div>
          </div>
        </div>
        <div id="key-status" class="text-right">
          <div class="text-xs text-gray-600">Estado</div>
          <div id="key-status-text" class="text-sm text-gray-500">-</div>
        </div>
      </div>
    </div>

    <!-- Key Generation Section -->
    <section id="generate-section" class="mb-8">
      <h3 class="text-xl font-display mb-4">⚙️ Generar Identidad</h3>
      <p class="text-gray-400 mb-4">
        Crea tu par de claves RSA-4096 para firmar tus reseñas de forma criptográfica.
        Tu clave privada se cifra con tu contraseña antes de almacenarse localmente.
      </p>
      <div class="space-y-4 max-w-md">
        <div>
          <label for="username" class="block text-sm text-gray-400 mb-1">Nombre de usuario</label>
          <input type="text" id="username" placeholder="MiNombre"
            class="w-full px-4 py-2 bg-white/10 border border-white/20 rounded-lg focus:border-primary focus:outline-none" />
        </div>
        <div>
          <label for="password" class="block text-sm text-gray-400 mb-1">Contraseña (para cifrar claves)</label>
          <input type="password" id="password" placeholder="********"
            class="w-full px-4 py-2 bg-white/10 border border-white/20 rounded-lg focus:border-primary focus:outline-none" />
          <p class="text-xs text-gray-600 mt-1">Mínimo 8 caracteres. No la olvides.</p>
        </div>
        <div id="generation-status" class="text-sm"></div>
        <button id="generate-keys" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/80 transition-colors font-display text-lg w-full sm:w-auto">
          🔑 Generar Claves RSA-4096
        </button>
      </div>
    </section>

    <!-- Public Key Section -->
    <section class="border-t border-white/10 pt-8 mb-8">
      <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <h3 class="text-xl font-display">🔐 Clave Pública</h3>
        <button id="copy-public-key" class="px-3 py-1 text-sm bg-white/10 border border-white/20 rounded-lg hover:bg-white/20 transition-colors">
          📋 Copiar
        </button>
      </div>
      <div id="public-key-container" class="p-4 bg-black/30 rounded-xl border border-white/10">
        <p class="text-gray-500 text-sm">Genera tus claves para ver tu clave pública</p>
      </div>
      <p class="text-xs text-gray-600 mt-2">
        Comparte esta clave con otros para que puedan verificar tus reseñas firmadas.
      </p>
    </section>

    <!-- Verification Level Info -->
    <section class="p-6 bg-white/5 rounded-xl border border-white/10 mb-8">
      <h3 class="text-xl font-display mb-4">📊 Niveles de Verificación</h3>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3 text-center text-xs">
        <div class="p-2 bg-white/5 rounded-lg">
          <div class="text-lg mb-1">⚪</div>
          <div class="font-display">0</div>
          <div class="text-gray-600">Sin clave</div>
        </div>
        <div class="p-2 bg-white/5 rounded-lg">
          <div class="text-lg mb-1">🟡</div>
          <div class="font-display">1</div>
          <div class="text-gray-600">Clave generada</div>
        </div>
        <div class="p-2 bg-white/5 rounded-lg">
          <div class="text-lg mb-1">🟠</div>
          <div class="font-display">2</div>
          <div class="text-gray-600">Verificado email</div>
        </div>
        <div class="p-2 bg-white/5 rounded-lg">
          <div class="text-lg mb-1">🟢</div>
          <div class="font-display">3-4</div>
          <div class="text-gray-600">Reviews firmadas</div>
        </div>
        <div class="p-2 bg-white/5 rounded-lg">
          <div class="text-lg mb-1">🔵</div>
          <div class="font-display">5</div>
          <div class="text-gray-600"> Trusted</div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { generateKeyPair, getPublicKey, hasKeys, signData } from '../lib/crypto';

  const generateBtn = document.getElementById('generate-keys') as HTMLButtonElement;
  const usernameInput = document.getElementById('username') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const profileName = document.getElementById('profile-name');
  const profileKeys = document.getElementById('profile-keys');
  const publicKeyContainer = document.getElementById('public-key-container');
  const keyStatusText = document.getElementById('key-status-text');
  const generationStatus = document.getElementById('generation-status');
  const copyBtn = document.getElementById('copy-public-key');
  const trustContainer = document.getElementById('trust-score-container');
  const trustDots = [
    document.getElementById('trust-dot-1'),
    document.getElementById('trust-dot-2'),
    document.getElementById('trust-dot-3'),
    document.getElementById('trust-dot-4'),
    document.getElementById('trust-dot-5')
  ];
  const trustLabel = document.getElementById('trust-score-label');

  // Calculate verification level (0-5)
  function calculateVerificationLevel(): number {
    // 0: No keys
    // 1: Has keys
    // 2: Email verified (not implemented yet - placeholder)
    // 3-4: Has signed reviews
    // 5: Trusted (manually set)

    let level = 0;

    // Level 1: Has key pair
    if (localStorage.getItem('gos_has_keys') === 'true') {
      level = 1;
    }

    // Level 2: Email verified (placeholder check)
    if (localStorage.getItem('gos_email_verified') === 'true') {
      level = 2;
    }

    // Level 3-4: Has signed reviews
    const signedReviews = localStorage.getItem('gos_signed_reviews');
    if (signedReviews) {
      const count = JSON.parse(signedReviews).length;
      if (count >= 3) level = 4;
      else if (count >= 1) level = 3;
    }

    // Level 5: Trusted
    if (localStorage.getItem('gos_trusted') === 'true') {
      level = 5;
    }

    return level;
  }

  function getVerificationBadge(level: number): { text: string; class: string } {
    switch (level) {
      case 0: return { text: 'Sin clave', class: 'bg-gray-600 text-gray-300' };
      case 1: return { text: 'Básico', class: 'bg-yellow-600 text-yellow-100' };
      case 2: return { text: 'Email', class: 'bg-orange-600 text-orange-100' };
      case 3: return { text: 'Reviewer', class: 'bg-green-600 text-green-100' };
      case 4: return { text: 'Veterano', class: 'bg-green-700 text-green-100' };
      case 5: return { text: 'Trusted', class: 'bg-blue-600 text-blue-100' };
      default: return { text: '?', class: 'bg-gray-600' };
    }
  }

  function updateTrustScore(level: number) {
    if (!trustContainer || !trustLabel) return;

    if (level === 0) {
      trustContainer.classList.add('hidden');
      return;
    }

    trustContainer.classList.remove('hidden');

    const colors = ['', 'bg-yellow-500', 'bg-orange-500', 'bg-green-500', 'bg-green-600', 'bg-blue-500'];
    const labels = ['', 'Básico', 'Verificado', 'Activo', 'Veterano', 'Trusted'];

    trustDots.forEach((dot, i) => {
      if (dot) {
        dot.className = `w-2 h-2 rounded-full ${i < level ? colors[level] : 'bg-gray-700'}`;
      }
    });

    if (trustLabel) {
      trustLabel.textContent = labels[level] || '';
    }
  }

  async function updateUI() {
    const hasKeyPair = await hasKeys();
    const pubKey = await getPublicKey();
    const username = localStorage.getItem('gos_username');
    const level = calculateVerificationLevel();
    const badge = getVerificationBadge(level);

    if (hasKeyPair && pubKey) {
      // Update profile card
      if (profileName) profileName.textContent = username || 'Usuario GOS';
      if (profileKeys) profileKeys.textContent = 'Claves RSA-4096 activas';
      if (keyStatusText) {
        keyStatusText.textContent = '✓ Activas';
        keyStatusText.className = 'text-sm text-green-500';
      }
      if (generateBtn) {
        generateBtn.textContent = '🔄 Regenerar Claves';
      }

      // Show public key
      if (publicKeyContainer) {
        const formattedKey = formatPublicKey(pubKey);
        publicKeyContainer.innerHTML = `
          <pre class="text-xs text-green-400 overflow-x-auto break-all max-h-48 overflow-y-auto">${escapeHtml(formattedKey)}</pre>
        `;
      }

      // Update verification
      const verifBadge = document.getElementById('verification-badge');
      if (verifBadge) {
        verifBadge.textContent = badge.text;
        verifBadge.className = `px-2 py-0.5 text-xs rounded-full ${badge.class}`;
      }

      // Update trust score
      updateTrustScore(level);

      // Hide generation form if keys exist
      const genSection = document.getElementById('generate-section');
      if (genSection && localStorage.getItem('gos_has_keys') === 'true') {
        // Keep visible but show "regenerate" option
      }
    } else {
      if (profileName) profileName.textContent = 'Sin identificar';
      if (profileKeys) profileKeys.textContent = 'Claves no generadas';
      if (keyStatusText) {
        keyStatusText.textContent = 'Sin claves';
        keyStatusText.className = 'text-sm text-gray-500';
      }
      updateTrustScore(0);
    }
  }

  function formatPublicKey(jwkString: string): string {
    try {
      const jwk = JSON.parse(jwkString);
      return JSON.stringify(jwk, null, 2);
    } catch {
      return jwkString;
    }
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Generate keys handler
  generateBtn?.addEventListener('click', async () => {
    const username = usernameInput?.value.trim();
    const password = passwordInput?.value;

    if (!username || !password) {
      if (generationStatus) {
        generationStatus.innerHTML = '<span class="text-red-400">Completa todos los campos</span>';
      }
      return;
    }

    if (password.length < 8) {
      if (generationStatus) {
        generationStatus.innerHTML = '<span class="text-red-400">La contraseña debe tener al menos 8 caracteres</span>';
      }
      return;
    }

    try {
      if (generationStatus) {
        generationStatus.innerHTML = '<span class="text-yellow-400">⏳ Generando par de claves RSA-4096... esto puede tardar.</span>';
      }
      generateBtn.disabled = true;
      generateBtn.textContent = 'Generando...';

      await generateKeyPair(password);
      localStorage.setItem('gos_username', username);

      if (generationStatus) {
        generationStatus.innerHTML = '<span class="text-green-400">✓ Claves generadas correctamente</span>';
      }

      await updateUI();

      setTimeout(() => {
        if (generationStatus) generationStatus.innerHTML = '';
      }, 3000);
    } catch (e) {
      console.error('Error generating keys:', e);
      if (generationStatus) {
        generationStatus.innerHTML = `<span class="text-red-400">Error: ${escapeHtml((e as Error).message)}</span>`;
      }
    } finally {
      if (generateBtn) {
        generateBtn.disabled = false;
        generateBtn.textContent = '🔑 Generar Claves RSA-4096';
      }
    }
  });

  // Copy public key handler
  copyBtn?.addEventListener('click', async () => {
    const pubKey = await getPublicKey();
    if (pubKey) {
      try {
        await navigator.clipboard.writeText(pubKey);
        if (copyBtn) {
          const originalText = copyBtn.textContent;
          copyBtn.textContent = '✓ Copiado';
          setTimeout(() => {
            if (copyBtn) copyBtn.textContent = originalText;
          }, 2000);
        }
      } catch {
        if (copyBtn) copyBtn.textContent = 'Error';
      }
    }
  });

  // Initial UI update
  updateUI();
</script>
