---
import { getCollection } from 'astro:content'
import { Badge, Button, Card, Icon } from '@swal/ui'
import graphData from '../../public/graph-data.json'
import GosGraph from '../components/GosGraph.svelte'
import '../lib/gos-icons'
import Layout from '../layouts/Layout.astro'
import { clampDescription } from '../lib/meta-description'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

// Los numeros salen del grafo generado, no de aproximaciones: si el contenido
// crece, la portada deja de mentir. Ver scripts/generate-graph.js.
const nodes = graphData.nodes
const edges = graphData.edges
const byType = (t: string) => nodes.filter((n) => n.type === t).length

const total = nodes.length

// Ingredientes con ficha propia, contados desde la content collection (la
// fuente real). El grafo tambien incluye los que solo citan las recetas, asi
// que no son la misma cifra: 554 en disco vs 2460 nodos en el grafo.
const ingFichas = (await getCollection('ingredients')).length

// Las 16 relaciones del grafo, con su conteo real y su lectura en lenguaje claro.
// El orden es por peso: primero lo que sostiene el grafo, despues la ciencia.
const RELATIONS: { type: string; from: string; to: string; reads: string }[] = [
  {
    type: 'USES',
    from: 'recipe',
    to: 'ingredient',
    reads: 'cada receta declara qué ingredientes usa',
  },
  {
    type: 'RELATED_DISHES',
    from: 'recipe',
    to: 'recipe',
    reads: 'recetas que comparten técnica o familia',
  },
  {
    type: 'HAS_FLAVOR',
    from: 'ingredient',
    to: 'flavor',
    reads: 'qué sabor aporta cada ingrediente',
  },
  {
    type: 'BELONGS_TO',
    from: 'dish*',
    to: 'category',
    reads: 'a qué categoría culinaria pertenece cada plato',
  },
  {
    type: 'HAS_TEXTURE',
    from: 'ingredient',
    to: 'texture',
    reads: 'la textura que aporta al plato',
  },
  {
    type: 'OFTEN_TOGETHER',
    from: 'ingredient',
    to: 'ingredient',
    reads: 'pares que aparecen juntos en las recetas',
  },
  {
    type: 'FROM_REGION',
    from: 'dish*',
    to: 'region',
    reads: 'de qué región es cada plato',
  },
  {
    type: 'HAS_NUTRIENT',
    from: 'ingredient',
    to: 'nutrient',
    reads: 'nutrientes que aporta',
  },
  {
    type: 'CONTAINS_VITAMIN',
    from: 'ingredient',
    to: 'vitamin',
    reads: 'vitaminas que contiene',
  },
  {
    type: 'HELPS_CONDITION',
    from: 'ingredient',
    to: 'condition',
    reads: 'afecciones que ayuda a aliviar',
  },
  {
    type: 'HAS_SUBSTANCE',
    from: 'ingredient',
    to: 'substance',
    reads: 'substancias bioactivas que contiene',
  },
  {
    type: 'FOUND_IN',
    from: 'substance',
    to: 'ingredient',
    reads: 'en qué ingredientes se hallan las substancias',
  },
  {
    type: 'PLACE',
    from: 'region',
    to: 'place',
    reads: 'dónde está la región en el mapa',
  },
  {
    type: 'FITS_DIET',
    from: 'dish*',
    to: 'diet',
    reads: 'qué dietas admite cada plato',
  },
  {
    type: 'TREATS',
    from: 'substance',
    to: 'condition',
    reads: 'qué sustancia actúa sobre qué afección',
  },
  {
    type: 'USES_TECHNIQUE',
    from: 'recipe',
    to: 'technique',
    reads: 'técnicas de cocción que requiere',
  },
]
const edgeCount = (t: string) => edges.filter((e) => e.type === t).length
const relations = RELATIONS.map((r) => ({
  ...r,
  count: edgeCount(r.type),
})).sort((a, b) => b.count - a.count)

// Capa científica. Leemos las mismas colecciones que usa /api/evidence.json,
// para que la portada y el endpoint no puedan discrepar. Solo entran las
// entradas que declaran al menos un estudio: una ficha sin estudio no es
// evidencia, y no aporta nada en una sección que habla de evidencia.
const KIND_META: Record<string, { label: string; route: string }> = {
  vitamin: { label: 'Vitaminas', route: 'vitamins' },
  substance: { label: 'Substancias bioactivas', route: 'substances' },
  diet: { label: 'Dietas', route: 'diets' },
}
const SHOWN_PER_KIND = 5

type EvStudy = {
  title?: string
  source?: string
  year?: number
  doi?: string
  pmid?: string
  status?: string
}
type EvEntry = { kind: string; id: string; name: string; study?: EvStudy }

/** Extrae los estudios de una entrada, igual que hace /api/evidence.json.
 *
 *  Las vitaminas y dietas declaran `studies:` en el frontmatter; las
 *  substancias los declaran anidados en `health_registry[].studies`. Leer solo
 *  el primer caso dejaba 30 de las 48 entradas sin ver, que es justo lo que la
 *  sección científica debe mostrar.
 */
function studiesOf(entry: unknown): EvStudy[] {
  const data = (entry as { data?: Record<string, unknown> })?.data
  if (!data) return []

  const out: EvStudy[] = []
  const collect = (raw: unknown) => {
    if (!Array.isArray(raw)) return
    for (const s of raw) {
      if (!s || typeof s !== 'object') continue
      const o = s as Record<string, unknown>
      out.push({
        title: typeof o.title === 'string' ? o.title : undefined,
        source: typeof o.source === 'string' ? o.source : undefined,
        year: typeof o.year === 'number' ? o.year : undefined,
        doi: typeof o.doi === 'string' ? o.doi : undefined,
        pmid: typeof o.pmid === 'string' ? o.pmid : undefined,
        status: typeof o.doi_status === 'string' ? o.doi_status : undefined,
      })
    }
  }

  collect(data.studies)
  const registry = data.health_registry
  if (Array.isArray(registry)) {
    for (const row of registry) {
      if (row && typeof row === 'object')
        collect((row as Record<string, unknown>).studies)
    }
  }
  // `doi_status: unverified` marca un DOI que no resuelve: se conserva en la
  // ficha pero no cuenta como verificado, igual que hace /api/evidence.json.
  return out.filter((s) => s.doi && s.status !== 'unverified')
}

const COL_KINDS = [
  { col: 'vitamins', kind: 'vitamin' },
  { col: 'substances', kind: 'substance' },
  { col: 'diets', kind: 'diet' },
] as const

const evEntries: EvEntry[] = (
  await Promise.all(
    COL_KINDS.map(async ({ col, kind }) => {
      const entries = (await getCollection(col as never)) as unknown as {
        id: string
        data: Record<string, unknown>
      }[]
      return entries.map((e): EvEntry | null => {
        const studies = studiesOf(e)
        const withDoi = studies.find((s) => s.doi) ?? studies[0]
        if (!withDoi) return null
        return {
          kind,
          id: e.id,
          name: String(e.data.name ?? e.id),
          study: withDoi,
        }
      })
    }),
  )
)
  .flat()
  .filter((x): x is EvEntry => x !== null)

// Description de portada con las cifras REALES del grafo generado
// (graph-data.json), no con numeros redondos inventados.
const homeDescription = clampDescription(
  `Grafo gastronomico abierto: ${byType('recipe')} recetas, ${ingFichas} ingredientes, ${byType('substance')} substancias y ${byType('condition')} afecciones, con ${nodes.length} nodos y ${edges.length} relaciones.`,
)

const ev = {
  withStudies: evEntries.length,
  withDoi: evEntries.filter((e) => e.study?.doi).length,
  kinds: Object.entries(KIND_META).map(([kind, meta]) => {
    const of = evEntries.filter((e) => e.kind === kind)
    return {
      ...meta,
      count: of.length,
      more: Math.max(0, of.length - SHOWN_PER_KIND),
      samples: of.slice(0, SHOWN_PER_KIND).map((e) => ({
        name: e.name,
        href: e.study?.doi
          ? `https://doi.org/${e.study.doi}`
          : `${base}/${meta.route}/${e.id}`,
        study: e.study,
      })),
    }
  }),
}

// Cifras del grafo y puerta de entrada a cada seccion (composicion de la
// landing de Fize: tarjetas con icono, insignia y una linea de descripcion).
const features = [
  {
    title: 'Grafo global',
    badge: `${total} nodos`,
    icon: 'graph',
    href: `${base}/graph`,
    desc: `Recetas, ingredientes, ciencia y territorio en un solo grafo, con ${edges.length} relaciones de ${relations.length} tipos, de USES a TREATS.`,
  },
  {
    title: 'Recetas',
    badge: String(byType('recipe') + byType('dish')),
    icon: 'book',
    href: `${base}/recipes`,
    desc: 'Con perfil sensorial, técnica, región y dietas que admiten.',
  },
  {
    title: 'Ingredientes',
    badge: `${ingFichas} fichas`,
    icon: 'leaf',
    href: `${base}/ingredients`,
    desc: `${byType('ingredient')} ingredientes en el grafo; ${ingFichas} con ficha científica, el resto son los que citan las recetas.`,
  },
  {
    title: 'Ciencia',
    badge: `${byType('vitamin')} vitaminas`,
    icon: 'flask',
    href: `${base}/scientific`,
    desc: `Micronutrientes, substancias bioactivas y ${byType('condition')} afecciones conectadas con los ingredientes que las respaldan.`,
  },
]
---

<Layout title="GOS — Grafo Gastronómico Global" description={homeDescription}>
  <section class="hero" aria-labelledby="hero-title">
    <Badge variant="neutral" size="md" dot>Grafo gastronómico abierto</Badge>
    <h1 id="hero-title" class="hero-title">
      <span class="brand">GOS</span>
      <span class="headline">Grafo gastronómico global: las recetas son nodos</span>
    </h1>
    <p class="hero-subtitle">
      Recetas e ingredientes de todo el mundo interconectados con <strong>vitaminas, sabores, técnicas, substancias bioactivas</strong> y <strong>afecciones</strong>, con las dietas que admite cada plato y los estudios que respaldan cada afirmación.
    </p>
    <div class="hero-ctas">
      <Button href={`${base}/graph`} variant="primary" size="lg">
        <Icon name="graph" size={18} />
        Explorar grafo global
      </Button>
      <Button href={`${base}/recipes`} variant="secondary" size="lg">
        <Icon name="book" size={18} />
        Ver recetas
      </Button>
      <Button href={`${base}/ingredients`} variant="secondary" size="lg">
        <Icon name="leaf" size={18} />
        Ingredientes científicos
      </Button>
    </div>
    <div class="meta">
      <span class="pill">Grafo interactivo · recetas ↔ ingredientes ↔ ciencia</span>
      <span class="pill">Funciona sin conexión (PWA) · modo claro, oscuro o del sistema</span>
    </div>
  </section>

  <section class="graph-shell" aria-label="Vista previa del grafo">
    <GosGraph client:load />
  </section>

  <section class="features" aria-labelledby="features-title">
    <header class="section-header">
      <h2 id="features-title" class="section-title">Qué contiene GOS</h2>
      <p class="section-subtitle">Cifras reales del grafo generado en cada build.</p>
    </header>
    <ul class="features-grid">
      {features.map(f => (
        <li>
          <a href={f.href} class="feature">
            <div class="feature-top">
              <span class="feature-icon"><Icon name={f.icon} size={22} /></span>
              <Badge variant="neutral">{f.badge}</Badge>
            </div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="model">
    <Card variant="elevated" padding="lg">
      <h2>Qué modela el grafo</h2>
      <p class="hint">
        Cada fila es una arista real del grafo, con el conteo que sale de
        <code>graph-data.json</code>. En el explorador puedes recorrerlas: haz clic en un
        nodo y verás a qué nodos conecta a dos saltos.
      </p>
      <table class="rels">
        <thead>
          <tr><th>Relación</th><th>De → a</th><th>Qué significa</th><th class="num">Aristas</th></tr>
        </thead>
        <tbody>
          {relations.map(r => (
            <tr>
              <td data-lbl="Relación"><code>{r.type}</code></td>
              <td data-lbl="Camino" class="path">{r.from} → {r.to}</td>
              <td data-lbl="Qué significa" class="reads">{r.reads}</td>
              <td data-lbl="Aristas" class="num">{r.count.toLocaleString('es-CO')}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="hint">
        <strong>Por qué importa:</strong> estas aristas son lo que convierte la base en
        grafo. No son recetas sueltas en una tabla — el camino de un ingrediente a una
        afección (ingrediente → sustancia → condición, con los estudios que lo sostienen)
        es lo que permite preguntar, por ejemplo, qué platos con cúrcuma tienen
        evidencia al respecto y citarla con su DOI.
      </p>
      <div class="actions">
        <Button href={`${base}/graph`} variant="primary">Abrir grafo interactivo</Button>
        <Button href={`${base}/scientific`} variant="secondary">Ver capa científica</Button>
      </div>
    </Card>
  </section>

  <section class="science">
    <div class="science-head">
      <div>
        <span class="eyebrow-text">LA CAPA CIENTÍFICA</span>
        <h2>Qué sostiene cada afirmación, y con qué estudio</h2>
        <p class="hint">
          Cada vitamina, sustancia y dieta de GOS declara los estudios que la respaldan:
          {ev.withStudies} entradas con evidencia, {ev.withDoi} de ellas apoyadas en un
          estudio con DOI verificable. Ninguna se cita sin fuente. El nivel de evidencia
          distingue un ensayo clínico de una revisión narrativa o de un estudio in vitro,
          para que no se confundan.
        </p>
      </div>
      <Button href={`${base}/api/evidence.json`} variant="secondary" size="sm">Ver el índice completo</Button>
    </div>

    <div class="ev-grid">
      {ev.kinds.map(k => (
        <div class="ev-card">
          <div class="ev-card-head">
            <span class="ev-kind">{k.label}</span>
            <span class="ev-count">{k.count}</span>
          </div>
          <ul class="ev-list">
            {k.samples.map(s => (
              <li>
                <a href={s.href} class="ev-name">{s.name}</a>
                {s.study && (
                  <span class="ev-study">
                    {s.study.source}{s.study.year ? `, ${s.study.year}` : ''}
                  </span>
                )}
              </li>
            ))}
          </ul>
          {k.more > 0 && <span class="ev-more">+{k.more} más en el índice</span>}
        </div>
      ))}
    </div>

    <div class="evidence-note">
      <strong>Alcance de la evidencia.</strong> Un DOI verificado significa que el estudio
      existe y trata del tema; no significa que GOS recomendene el consumo. Los niveles
      <code>Low</code>, <code>Medium</code> y <code>High</code> corresponden al diseño del
      estudio (in vitro, revisión narrativa, ensayo en humanos) y las fichas llevan la
      nota que delimita el alcance. Ninguna afirmación de GOS sustituye consejo médico.
    </div>
  </section>

  <section class="api-banner">
    <div class="api-copy">
      <span class="eyebrow-text">PARA AGENTES Y DESARROLLADORES</span>
      <h2>Usa los datos de GOS en tu app</h2>
      <p class="hint">
        Todo el grafo en JSON, con IDs estables y relaciones tipadas. Empieza por
        <code>llms.txt</code> para el mapa de endpoints, o por <code>graph-data.json</code>
        si quieres el grafo entero ({total} nodos, {edges.length} aristas, 3.2 MB).
      </p>
      <div class="actions">
        <Button href={`${base}/api`} variant="primary">Explorar la API</Button>
        <Button href={`${base}/llms.txt`} variant="secondary" target="_blank" rel="noopener">llms.txt</Button>
        <Button href="https://github.com/iberi22/gastronomic-open-standard-GOS/blob/main/API_README.md" variant="secondary" target="_blank" rel="noopener">Documentación</Button>
      </div>
    </div>
    <div class="api-code">
      <code>GET /llms.txt<br />GET /api/agent/knowledge.json<br />GET /api/evidence.json<br />GET /graph-data.json</code>
    </div>
  </section>

<style>
  /* Composicion de la landing de Fize: hero centrado, titular grande, CTAs y
     rejilla de tarjetas con icono. Todo con tokens --swal-*. */
  .hero { display:flex; flex-direction:column; align-items:center; text-align:center; gap:1.25rem; padding: clamp(0.5rem, 3vw, 2.5rem) 0 1.5rem; }
  .hero-title { display:flex; flex-direction:column; align-items:center; gap:0.5rem; margin-top:0.25rem; }
  .brand { font-size: clamp(3rem, 2rem + 5vw, 5rem); font-weight:700; line-height:1; letter-spacing:-0.04em; color: var(--swal-text); }
  .headline { font-size: clamp(1.375rem, 1rem + 1.6vw, 2rem); font-weight:500; line-height:1.2; letter-spacing:-0.015em; color: var(--swal-text-secondary); max-width:24ch; text-wrap:balance; }
  .hero-subtitle { font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem); line-height:1.6; color: var(--swal-text-secondary); max-width:62ch; text-wrap:pretty; }
  .hero-subtitle strong { color: var(--swal-text); font-weight:600; }
  .hero-ctas { display:flex; flex-wrap:wrap; justify-content:center; gap:0.75rem; margin-top:0.75rem; }
  @media (max-width: 480px) {
    .hero-ctas { flex-direction:column; align-self:stretch; }
    .hero-ctas :global(.swal-btn) { width:100%; }
  }
  .meta { display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-top:0.5rem; }
  .pill { font-size:11px; color: var(--swal-text-secondary); background: var(--swal-surface); border:1px solid var(--swal-border); padding:5px 10px; border-radius: var(--swal-radius-full); font-family: var(--swal-font-mono); }
  .eyebrow-text { font-size:12px; color: var(--swal-text-secondary); font-family: var(--swal-font-mono); letter-spacing:0.08em; }
  .graph-shell { margin-top: 1rem; }

  .features { display:flex; flex-direction:column; gap:1.75rem; margin-top: clamp(2.5rem, 5vw, 4rem); container-type:inline-size; }
  .section-header { display:flex; flex-direction:column; gap:0.5rem; text-align:center; }
  .section-title { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); font-weight:650; letter-spacing:-0.02em; color: var(--swal-text); text-wrap:balance; margin:0; }
  .section-subtitle { font-size:1rem; color: var(--swal-text-secondary); margin:0; }
  .features-grid { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr; gap:1rem; }
  @container (min-width: 560px) { .features-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @container (min-width: 960px) { .features-grid { grid-template-columns: repeat(4, minmax(0,1fr)); } }
  .feature { display:flex; flex-direction:column; gap:0.75rem; height:100%; padding:1.5rem; background: var(--swal-surface); border:1px solid var(--swal-border); border-radius: var(--swal-radius-lg); box-shadow: var(--swal-shadow-sm); text-decoration:none; color: var(--swal-text); transition: border-color var(--swal-transition-fast), transform var(--swal-transition-fast); }
  .feature:hover { border-color: var(--swal-border-strong); transform: translateY(-2px); }
  .feature-top { display:flex; justify-content:space-between; align-items:center; gap:0.75rem; }
  .feature-icon { display:grid; place-items:center; width:44px; height:44px; border-radius: var(--swal-radius); background: var(--swal-accent-muted); color: var(--swal-text); }
  .feature-title { font-size:1.0625rem; font-weight:600; letter-spacing:-0.01em; color: var(--swal-text); margin:0.25rem 0 0; }
  .feature-desc { font-size:0.9375rem; line-height:1.55; color: var(--swal-text-secondary); margin:0; }

  .model { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .model h2 { margin:0; font-size:1.25rem; font-weight:650; letter-spacing:-0.01em; color: var(--swal-text); }
  .list { margin:10px 0 0 18px; color: var(--swal-text-secondary); line-height:1.9; font-size:14px; }
  .rels { width:100%; border-collapse:collapse; margin-top:12px; font-size:12.5px; }
  .rels th { text-align:left; font-weight:600; color: var(--swal-text-muted); font-size:11px; text-transform:uppercase; letter-spacing:0.06em; padding:0 8px 7px 0; border-bottom:1px solid var(--swal-border); }
  .rels td { padding:7px 8px 7px 0; border-bottom:1px solid color-mix(in srgb, var(--swal-border) 45%, transparent); vertical-align:top; }
  .rels td code { font-family: var(--swal-font-mono); font-size:11.5px; color: var(--swal-accent); white-space:nowrap; }
  .rels td.path { font-family: var(--swal-font-mono); font-size:11px; color: var(--swal-text-secondary); white-space:nowrap; }
  .rels td.reads { color: var(--swal-text-secondary); line-height:1.5; }
  .rels td.num { text-align:right; font-variant-numeric: tabular-nums; color: var(--swal-text-muted); white-space:nowrap; }
  .rels tr:last-child td { border-bottom:none; }
  /* En movil la tabla de 4 columnas deja la descripcion en ~12 chars por
     linea, ilegible. Cada fila se convierte en una ficha apilada: el nombre de
     la columna va como etiqueta y el valor ocupa el ancho completo. */
  @media (max-width: 720px) {
    .rels thead { position:absolute; width:1px; height:1px; overflow:hidden; clip-path: inset(50%); }
    .rels, .rels tbody, .rels tr, .rels td { display:block; width:auto; }
    .rels tr { padding:11px 0; border-bottom:1px solid color-mix(in srgb, var(--swal-border) 45%, transparent); }
    .rels tr:last-child { border-bottom:none; }
    .rels td { border:none; padding:2px 0; }
    .rels td::before { content: attr(data-lbl) ": "; color: var(--swal-text-muted); font-size:10.5px; text-transform:uppercase; letter-spacing:0.05em; }
    .rels td:first-child::before { content:none; }
    .rels td.num { text-align:left; }
    .rels td.path, .rels td code { white-space:normal; }
  }
  .science { margin-top:22px; }
  .science-head { display:flex; gap:14px; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; }
  .science-head h2 { font-size:20px; font-weight:750; letter-spacing:-0.01em; margin:6px 0 0; color: var(--swal-text); }
  .science-head .hint { max-width:68ch; margin-top:6px; }
  .ev-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:12px; margin-top:16px; }
  .ev-card { border:1px solid var(--swal-border); background: var(--swal-surface); border-radius:16px; padding:14px; }
