---
// site/src/components/SearchBar.astro — client-side fuzzy search + faceted filtering
// Uses Fuse.js (already a dep). No server round-trip — pure client filtering of the static catalog.

export interface SearchItem {
  id: string
  name: string
  group?: string
  region?: string
  difficulty?: string
  scientific_name?: string
  health?: string
}

interface Props {
  items: SearchItem[]
  baseHref: string
  placeholder?: string
  facets?: string[] // optional facet fields to show as pills (group, region, difficulty)
  fuseKeys?: string[] // default: ['name', 'scientific_name', 'health']
}

const {
  items,
  baseHref,
  placeholder = 'Buscar...',
  facets = [],
  fuseKeys = ['name', 'scientific_name', 'health'],
} = Astro.props
---

<div class="search-container" data-items={JSON.stringify(items)} data-base={baseHref} data-fuse-keys={JSON.stringify(fuseKeys)}>
  <div class="search-row">
    <input type="search" class="search-input" placeholder={placeholder} aria-label="Search" />
    {facets.length > 0 && (
      <div class="facet-row">
        <button class="pill active" data-facet="" data-value="">Todas</button>
        {facets.map((f) => (
          <>
            <button class="pill" data-facet={f} data-value={f}>{f}</button>
          </>
        ))}
      </div>
    )}
  </div>
  <div class="result-count"><span class="count">0</span> resultados</div>
  <div class="search-results"></div>
</div>

<style>
  .search-container { margin: 16px 0; }
  .search-row { display: flex; flex-direction: column; gap: 8px; }
  .search-input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--swal-border);
    border-radius: 12px;
    background: var(--swal-bg);
    color: var(--swal-text);
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }
  .search-input:focus {
    border-color: var(--swal-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--swal-accent) 15%, transparent);
  }
  .facet-row { display: flex; gap: 6px; flex-wrap: wrap; }
  .pill {
    font-size: 11px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--swal-surface);
    border: 1px solid var(--swal-border);
    color: var(--swal-text-secondary);
    cursor: pointer;
    text-transform: capitalize;
    transition: all 0.12s;
    font-family: inherit;
  }
  .pill:hover { border-color: var(--swal-accent); color: var(--swal-text); }
  .pill.active {
    background: var(--swal-accent-muted);
    color: var(--swal-accent);
    border-color: color-mix(in srgb, var(--swal-accent) 30%, transparent);
  }
  .result-count {
    font-size: 12px;
    color: var(--swal-text-muted);
    font-family: var(--swal-font-mono);
    margin-top: 8px;
  }
  .search-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    margin-top: 12px;
  }
  .search-results :global(.result-card) {
    border: 1px solid var(--swal-border);
    background: var(--swal-surface);
    border-radius: 16px;
    padding: 14px;
    text-decoration: none;
    color: var(--swal-text);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.12s, border-color 0.12s;
  }
  .search-results :global(.result-card:hover) {
    border-color: color-mix(in srgb, var(--swal-accent) 30%, var(--swal-border));
    transform: translateY(-2px);
  }
  .search-results :global(.result-card .r-name) { font-weight: 700; }
  .search-results :global(.result-card .r-meta) {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .search-results :global(.result-card .r-meta .pill) { cursor: default; }
  .search-results :global(.result-card .r-sci) {
    font-style: italic;
    color: var(--swal-text-muted);
    font-size: 12px;
  }
</style>

<script>
  import Fuse from 'fuse.js';

  function init(container: HTMLElement) {
    const items = JSON.parse(container.dataset.items || '[]');
    const base = container.dataset.base || '';
    const fuseKeys = JSON.parse(container.dataset.fuseKeys || '["name"]');
    const input = container.querySelector('.search-input') as HTMLInputElement;
    const resultEl = container.querySelector('.search-results') as HTMLElement;
    const countEl = container.querySelector('.count') as HTMLElement;
    const facetButtons = container.querySelectorAll<HTMLButtonElement>('[data-facet]');
    const activeFacets: Record<string, string> = {};

    const fuse = new Fuse(items, {
      keys: fuseKeys,
      threshold: 0.3,
      includeScore: true,
    });

    function render(items: any[]) {
      countEl.textContent = String(items.length);
      resultEl.innerHTML = items
        .slice(0, 200)
        .map(
          (item) => `
            <a href="${base}/${item.id}" class="result-card">
              <div class="r-name">${escapeHtml(item.name)}</div>
              ${item.scientific_name ? `<div class="r-sci">${escapeHtml(item.scientific_name)}</div>` : ''}
              <div class="r-meta">
                ${item.group ? `<span class="pill">${escapeHtml(item.group)}</span>` : ''}
                ${item.region ? `<span class="pill">${escapeHtml(item.region)}</span>` : ''}
                ${item.difficulty ? `<span class="pill">${escapeHtml(item.difficulty)}</span>` : ''}
                ${item.health ? `<span class="pill">${escapeHtml(item.health)}</span>` : ''}
              </div>
            </a>`,
        )
        .join('');
      if (items.length === 0) {
        resultEl.innerHTML = '<div style="color: var(--swal-text-muted); padding: 24px; text-align: center; font-style: italic;">Sin resultados. Probá con otro término.</div>';
      }
    }

    function escapeHtml(s: string): string {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function applyFilters() {
      const query = (input?.value || '').trim();
      let result = query.length > 0 ? fuse.search(query).map((r) => r.item) : items;

      // Apply facets
      const facetKeys = Object.keys(activeFacets).filter((k) => activeFacets[k]);
      if (facetKeys.length > 0) {
        result = result.filter((item: any) =>
          facetKeys.every((k) => String(item[k] || '').toLowerCase() === activeFacets[k].toLowerCase()),
        );
      }
      render(result);
    }

    input?.addEventListener('input', () => applyFilters());

    facetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const facet = btn.dataset.facet || '';
        const value = btn.dataset.value || '';
        // Single-select per facet
        facetButtons.forEach((b) => {
          if (b.dataset.facet === facet) b.classList.remove('active');
        });
        btn.classList.add('active');
        activeFacets[facet] = value;
        applyFilters();
      });
    });

    // Initial render
    render(items);
  }

  document.querySelectorAll<HTMLElement>('.search-container').forEach((el) => init(el));
</script>