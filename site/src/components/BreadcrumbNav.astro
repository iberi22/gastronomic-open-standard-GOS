---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex items-center gap-1 text-xs">
  <a
    href="/"
    class="flex items-center text-gray-500 hover:text-primary transition-colors dark:text-gray-400 dark:hover:text-primary"
    aria-label="Home"
  >
    <span class="material-symbols-outlined text-sm">home</span>
  </a>

  {items.map((item, index) => (
    <>
      <span class="text-gray-400 dark:text-gray-600">/</span>
      {item.href && index < items.length - 1 ? (
        <a
          href={item.href}
          class="text-gray-500 hover:text-primary transition-colors dark:text-gray-400 dark:hover:text-primary"
        >
          {item.label}
        </a>
      ) : (
        <span class="text-primary dark:text-primary font-medium" aria-current="page">
          {item.label}
        </span>
      )}
    </>
  ))}
</nav>