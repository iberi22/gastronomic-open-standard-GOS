---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  label?: string;
}

const { size = 'md', label = 'Loading...' } = Astro.props;

const sizes = {
  sm: '2rem',
  md: '3rem',
  lg: '4rem',
};

const fontSize = {
  sm: '0.75rem',
  md: '0.875rem',
  lg: '1rem',
};

const spinnerSize = sizes[size];
const labelFontSize = fontSize[size];
---

<div
  id="loading-spinner"
  style="
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    gap: 1rem;
  "
>
  <div
    style={`
      width: ${spinnerSize};
      height: ${spinnerSize};
      border: 3px solid #1a1a2e;
      border-top-color: #e94560;
      border-radius: 50%;
      animation: gos-spin 0.8s linear infinite;
    `}
  ></div>
  <p
    style={`
      color: #a1a1aa;
      font-size: ${labelFontSize};
      font-family: 'Open Sans', sans-serif;
      margin: 0;
    `}
  >
    {label}
  </p>
</div>

<style>
  @keyframes gos-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
