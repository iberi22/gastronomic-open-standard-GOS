---
import Layout from '../layouts/Layout.astro';

interface Props {
  title?: string;
}

const { title = 'Graph - GOS' } = Astro.props;
---

<Layout title={title}>
  <div class="pwa-graph-container">
    <header class="pwa-graph-header">
      <h1 class="text-3xl font-display text-primary">PWA Graph</h1>
      <p class="text-gray-400 text-sm">Productos, Reviews y Usuarios</p>
    </header>

    <div class="pwa-graph-controls">
      <div class="pwa-graph-search">
        <input type="text" id="pwa-graph-search" placeholder="Buscar nodo..." class="pwa-graph-search-input" />
        <div id="pwa-graph-search-results" class="pwa-graph-search-results"></div>
      </div>
      <div class="pwa-graph-filters" id="pwa-graph-filters">
        <button class="pwa-graph-filter-btn on" data-type="product">Productos</button>
        <button class="pwa-graph-filter-btn on" data-type="review">Reviews</button>
        <button class="pwa-graph-filter-btn on" data-type="user">Usuarios</button>
      </div>
      <div class="pwa-graph-zoom-controls">
        <button id="pwa-graph-zoom-in" class="pwa-graph-zoom-btn">+</button>
        <button id="pwa-graph-zoom-out" class="pwa-graph-zoom-btn">−</button>
        <button id="pwa-graph-zoom-reset" class="pwa-graph-zoom-btn">⊙</button>
      </div>
    </div>

    <div class="pwa-graph-stats">
      <span>Nodos: <strong id="pwa-graph-node-count">0</strong></span>
      <span>Aristas: <strong id="pwa-graph-edge-count">0</strong></span>
      <span>Productos: <strong id="pwa-graph-product-count">0</strong></span>
    </div>

    <div id="pwa-graph-canvas" class="pwa-graph-canvas">
      <div id="pwa-graph-loading" class="pwa-graph-loading">Cargando datos...</div>
    </div>

    <div id="pwa-graph-tooltip" class="pwa-graph-tooltip" style="display:none;">
      <span id="pwa-graph-tt-type" class="pwa-graph-tt-type"></span>
      <span id="pwa-graph-tt-label" class="pwa-graph-tt-label"></span>
    </div>

    <div id="pwa-graph-minimap" class="pwa-graph-minimap"></div>

    <div id="pwa-graph-detail" class="pwa-graph-detail">
      <button id="pwa-graph-detail-close" class="pwa-graph-detail-close">×</button>
      <h2 id="pwa-graph-detail-title"></h2>
      <div id="pwa-graph-detail-body" class="pwa-graph-detail-body"></div>
    </div>
  </div>
</Layout>

<script>
  import * as d3 from 'd3';

  const canvas = document.getElementById('pwa-graph-canvas') as HTMLElement;
  const loading = document.getElementById('pwa-graph-loading') as HTMLElement;
  const searchInput = document.getElementById('pwa-graph-search') as HTMLInputElement;
  const searchResults = document.getElementById('pwa-graph-search-results') as HTMLElement;
  const filtersEl = document.getElementById('pwa-graph-filters') as HTMLElement;
  const detail = document.getElementById('pwa-graph-detail') as HTMLElement;
  const detailTitle = document.getElementById('pwa-graph-detail-title') as HTMLElement;
  const detailBody = document.getElementById('pwa-graph-detail-body') as HTMLElement;
  const tooltip = document.getElementById('pwa-graph-tooltip') as HTMLElement;
  const ttType = document.getElementById('pwa-graph-tt-type') as HTMLElement;
  const ttLabel = document.getElementById('pwa-graph-tt-label') as HTMLElement;
  const minimapEl = document.getElementById('pwa-graph-minimap') as HTMLElement;
  const nodeCountEl = document.getElementById('pwa-graph-node-count') as HTMLElement;
  const edgeCountEl = document.getElementById('pwa-graph-edge-count') as HTMLElement;
  const productCountEl = document.getElementById('pwa-graph-product-count') as HTMLElement;

  interface GraphNode {
    id: string;
    type: 'product' | 'review' | 'user' | 'recipe' | 'ingredient';
    name?: string;
    alias?: string;
    rating?: number;
    trustScore?: number;
    reviewCount?: number;
    brand?: string;
    country?: string;
    averageRating?: number;
    photoCount?: number;
    verificationLevel?: number;
    signature?: string;
    comment?: string;
    reviewsCount?: number;
    isHuman?: boolean;
    x?: number;
    y?: number;
    fx?: number | null;
    fy?: number | null;
  }

  interface GraphEdge {
    source: string | GraphNode;
    target: string | GraphNode;
  }

  interface GraphData {
    nodes: GraphNode[];
    edges: GraphEdge[];
  }

  // Load data from window.GOS_GRAPH_DATA or GunDB
  let graphData: GraphData = { nodes: [], edges: [] };

  if ((window as any).GOS_GRAPH_DATA) {
    graphData = (window as any).GOS_GRAPH_DATA;
  } else {
    // Load from GunDB
    loadFromGunDB();
  }

  async function loadFromGunDB() {
    try {
      const { getGunData } = await import('../lib/gundb');
      const data = await getGunData('pwa_graph');
      if (data) {
        graphData = data;
      } else {
        // Use sample data for demo
        graphData = getSampleData();
      }
    } catch {
      graphData = getSampleData();
    }
  }

  function getSampleData(): GraphData {
    return {
      nodes: [
        { id: 'p1', type: 'product', name: 'Arepa de Huevo', brand: 'Casera', country: 'CO', averageRating: 4.5, reviewCount: 128 },
        { id: 'p2', type: 'product', name: 'Bandeja Paisa', brand: 'Typical', country: 'CO', averageRating: 4.2, reviewCount: 89 },
        { id: 'p3', type: 'product', name: 'Ceviche', brand: 'Peruvian', country: 'PE', averageRating: 4.8, reviewCount: 201 },
        { id: 'u1', type: 'user', name: 'Maria G.', trustScore: 85, verificationLevel: 4, reviewsCount: 45, isHuman: true },
        { id: 'u2', type: 'user', name: 'Carlos R.', trustScore: 62, verificationLevel: 3, reviewsCount: 23, isHuman: true },
        { id: 'u3', type: 'user', name: 'Ana L.', trustScore: 40, verificationLevel: 2, reviewsCount: 8, isHuman: false },
        { id: 'r1', type: 'review', name: 'Review #1', rating: 5, photoCount: 3, verificationLevel: 3, signature: 'RSA-4096...', comment: 'Excelente producto' },
        { id: 'r2', type: 'review', name: 'Review #2', rating: 3, photoCount: 1, verificationLevel: 2 },
        { id: 'r3', type: 'review', name: 'Review #3', rating: 4, photoCount: 2, verificationLevel: 4 },
      ],
      edges: [
        { source: 'u1', target: 'r1' },
        { source: 'r1', target: 'p1' },
        { source: 'u2', target: 'r2' },
        { source: 'r2', target: 'p2' },
        { source: 'u3', target: 'r3' },
        { source: 'r3', target: 'p3' },
        { source: 'u1', target: 'p1' },
        { source: 'u2', target: 'p2' },
      ]
    };
  }

  // PWA Graph visualization
  var simulation: d3.Simulation<GraphNode, undefined>;
  var svg: d3.Selection<SVGSVGElement, unknown, null, undefined>;
  var g: d3.Selection<SVGGElement, unknown, null, undefined>;
  var link: d3.Selection<SVGLineElement, GraphEdge, SVGGElement, unknown>;
  var node: d3.Selection<SVGGElement, GraphNode, SVGGElement, unknown>;
  var labels: d3.Selection<SVGTextElement, GraphNode, SVGGElement, unknown>;
  var width: number;
  var height: number;
  var activeFilters: Record<string, boolean> = { product: true, review: true, user: true, recipe: true, ingredient: true };

  function getNodeColor(d: GraphNode): string {
    if (d.type === 'product') return '#00d4ff';
    if (d.type === 'review') {
      if ((d.rating || 0) >= 5) return '#00ff66';
      if ((d.rating || 0) >= 4) return '#7dff00';
      if ((d.rating || 0) >= 3) return '#ffe66d';
      if ((d.rating || 0) >= 2) return '#ff9f43';
      return '#ff6b6b';
    }
    if (d.type === 'user') {
      if ((d.trustScore || 0) >= 70) return '#00ff66';
      if ((d.trustScore || 0) >= 40) return '#ffe66d';
      return '#ff6b6b';
    }
    return '#4a4a6a';
  }

  function getNodeRadius(d: GraphNode): number {
    if (d.type === 'product') return 12 + Math.min(d.reviewCount || 0, 10);
    if (d.type === 'user') return 8 + Math.min(d.trustScore || 50, 20) / 5;
    if (d.type === 'review') return 6;
    return 8;
  }

  function init() {
    width = canvas.clientWidth;
    height = canvas.clientHeight;

    svg = d3.select(canvas).append('svg')
      .attr('width', '100%')
      .attr('height', '100%')
      .attr('viewBox', `0 0 ${width} ${height}`);

    // Arrow markers for edges
    svg.append('defs').selectAll('marker')
      .data(['review'])
      .join('marker')
      .attr('id', (d: string) => 'arrow-' + d)
      .attr('viewBox', '0 -5 10 10')
      .attr('refX', 20)
      .attr('refY', 0)
      .attr('markerWidth', 6)
      .attr('markerHeight', 6)
      .attr('orient', 'auto')
      .append('path')
      .attr('fill', '#4a4a6a')
      .attr('d', 'M0,-5L10,0L0,5');

    // Zoom behavior
    const zoom = d3.zoom<SVGSVGElement, unknown>()
      .scaleExtent([0.1, 4])
      .on('zoom', (event) => {
        g.attr('transform', event.transform.toString());
        if (minimapEl) {
          minimapEl.style.backgroundPosition = (-event.transform.x * 0.1) + 'px ' + (-event.transform.y * 0.1) + 'px';
        }
      });

    svg.call(zoom);

    g = svg.append('g');

    // Links
    link = g.append('g').attr('class', 'links').selectAll('line');

    // Nodes
    node = g.append('g').attr('class', 'nodes').selectAll('g');

    // Labels
    labels = g.append('g').attr('class', 'labels').selectAll('text');

    // Init simulation
    simulation = d3.forceSimulation<GraphNode>();

    update();

    // Center view
    svg.call(zoom.transform, d3.zoomIdentity.translate(width / 2, height / 2).scale(0.8));
  }

  function update() {
    const nodesFiltered = graphData.nodes.filter(d => activeFilters[d.type]);
    const nodeIds = new Set(nodesFiltered.map(d => d.id));
    const linksFiltered = graphData.edges.filter(e => {
      const sourceId = typeof e.source === 'string' ? e.source : e.source.id;
      const targetId = typeof e.target === 'string' ? e.target : e.target.id;
      return nodeIds.has(sourceId) && nodeIds.has(targetId);
    });

    // Update links
    link = link.data(linksFiltered, (d: GraphEdge) => {
      const sourceId = typeof d.source === 'string' ? d.source : d.source.id;
      const targetId = typeof d.target === 'string' ? d.target : d.target.id;
      return sourceId + '-' + targetId;
    });
    link.exit().remove();
    link = link.enter().append('line')
      .attr('stroke', '#2a2a3e')
      .attr('stroke-width', 1)
      .attr('stroke-opacity', 0.6)
      .merge(link);

    // Update nodes
    node = node.data(nodesFiltered, (d: GraphNode) => d.id);
    node.exit().remove();

    const nodeEnter = node.enter().append('g')
      .attr('cursor', 'pointer')
      .call(d3.drag<SVGGElement, GraphNode>()
        .on('start', dragstarted)
        .on('drag', dragged)
        .on('end', dragended) as any)
      .on('click', (_event: MouseEvent, d: GraphNode) => showDetail(d))
      .on('mouseenter', (event: MouseEvent, d: GraphNode) => showTooltip(event, d))
      .on('mouseleave', hideTooltip);

    nodeEnter.append('circle')
      .attr('r', (d: GraphNode) => getNodeRadius(d))
      .attr('fill', (d: GraphNode) => getNodeColor(d))
      .attr('stroke', '#0a0a0f')
      .attr('stroke-width', 2);

    nodeEnter.append('text')
      .attr('dy', (d: GraphNode) => getNodeRadius(d) + 14)
      .attr('text-anchor', 'middle')
      .attr('fill', '#c0c0e0')
      .attr('font-size', '10px')
      .text((d: GraphNode) => d.name || d.alias || d.type);

    node = nodeEnter.merge(node);
    node.select('circle')
      .attr('r', (d: GraphNode) => getNodeRadius(d))
      .attr('fill', (d: GraphNode) => getNodeColor(d));
    node.select('text')
      .text((d: GraphNode) => d.name || d.alias || d.type);

    // Update counts
    if (nodeCountEl) nodeCountEl.textContent = nodesFiltered.length.toString();
    if (edgeCountEl) edgeCountEl.textContent = linksFiltered.length.toString();
    if (productCountEl) {
      productCountEl.textContent = nodesFiltered.filter(d => d.type === 'product').length.toString();
    }

    // Simulation
    simulation.nodes(nodesFiltered);
    simulation.force('link', d3.forceLink<GraphNode, GraphEdge>(linksFiltered).id(d => d.id).distance(80));
    simulation.force('charge', d3.forceManyBody().strength(-200));
    simulation.force('center', d3.forceCenter(width / 2, height / 2));
    simulation.force('collision', d3.forceCollide().radius((d: GraphNode) => getNodeRadius(d) + 10));
    simulation.on('tick', ticked);
  }

  function ticked() {
    link
      .attr('x1', (d: GraphEdge) => (d.source as GraphNode).x || 0)
      .attr('y1', (d: GraphEdge) => (d.source as GraphNode).y || 0)
      .attr('x2', (d: GraphEdge) => (d.target as GraphNode).x || 0)
      .attr('y2', (d: GraphEdge) => (d.target as GraphNode).y || 0);

    node.attr('transform', (d: GraphNode) => {
      d.x = Math.max(20, Math.min(width - 20, d.x || 0));
      d.y = Math.max(20, Math.min(height - 20, d.y || 0));
      return 'translate(' + d.x + ',' + d.y + ')';
    });

    labels
      .attr('x', (d: GraphNode) => d.x || 0)
      .attr('y', (d: GraphNode) => d.y || 0);
  }

  function dragstarted(event: d3.D3DragEvent<SVGGElement, GraphNode, GraphNode>, d: GraphNode) {
    if (!event.active) simulation.alphaTarget(0.3).restart();
    d.fx = d.x;
    d.fy = d.y;
  }

  function dragged(event: d3.D3DragEvent<SVGGElement, GraphNode, GraphNode>, d: GraphNode) {
    d.fx = event.x;
    d.fy = event.y;
  }

  function dragended(event: d3.D3DragEvent<SVGGElement, GraphNode, GraphNode>, d: GraphNode) {
    if (!event.active) simulation.alphaTarget(0);
    d.fx = null;
    d.fy = null;
  }

  function showDetail(d: GraphNode) {
    if (!detailTitle || !detailBody) return;

    detailTitle.textContent = d.name || d.alias || d.type;
    if (ttType) {
      ttType.textContent = d.type;
      ttType.style.background = getNodeColor(d) + '22';
      ttType.style.color = getNodeColor(d);
    }

    let html = '<div class="pwa-graph-meta-grid">';

    if (d.type === 'product') {
      html += '<div class="pwa-graph-meta-item"><div class="l">Marca</div><div class="v">' + (d.brand || 'N/A') + '</div></div>';
      html += '<div class="pwa-graph-meta-item"><div class="l">País</div><div class="v">' + (d.country || 'N/A') + '</div></div>';
      html += '<div class="pwa-graph-meta-item"><div class="l">Rating</div><div class="v">' + (d.averageRating || 0).toFixed(1) + ' ⭐</div></div>';
      html += '<div class="pwa-graph-meta-item"><div class="l">Reviews</div><div class="v">' + (d.reviewCount || 0) + '</div></div>';
    } else if (d.type === 'user') {
      html += '<div class="pwa-graph-meta-item"><div class="l">País</div><div class="v">' + (d.country || 'N/A') + '</div></div>';
      html += '<div class="pwa-graph-meta-item"><div class="l">Trust Score</div><div class="v">' + (d.trustScore || 0) + '/100</div></div>';
      html += '<div class="pwa-graph-meta-item"><div class="l">Nivel</div><div class="v">' + (d.verificationLevel || 0) + '</div></div>';
      html += '<div class="pwa-graph-meta-item"><div class="l">Reviews</div><div class="v">' + (d.reviewsCount || 0) + '</div></div>';
      html += '<div class="pwa-graph-meta-item"><div class="l">isHuman</div><div class="v">' + (d.isHuman ? '✓ Humano' : '❓ Pendiente') + '</div></div>';
    } else if (d.type === 'review') {
      html += '<div class="pwa-graph-meta-item"><div class="l">Rating</div><div class="v">' + (d.rating || 0) + ' ⭐</div></div>';
      html += '<div class="pwa-graph-meta-item"><div class="l">Fotos</div><div class="v">' + (d.photoCount || 0) + '</div></div>';
      html += '<div class="pwa-graph-meta-item"><div class="l">Verificación</div><div class="v">Level ' + (d.verificationLevel || 0) + '</div></div>';
      if (d.signature) {
        html += '<div class="pwa-graph-meta-item" style="grid-column:1/-1"><div class="l">Firma</div><div class="v" style="font-size:10px;word-break:break-all">' + d.signature + '</div></div>';
      }
      if (d.comment) {
        html += '<div style="margin-top:12px;padding:10px;background:#12121a;border-radius:8px;font-size:12px;color:#c0c0e0;grid-column:1/-1">' + d.comment + '</div>';
      }
    }

    html += '</div>';
    detailBody.innerHTML = html;
    detail.classList.add('open');
  }

  function showTooltip(event: MouseEvent, d: GraphNode) {
    if (!tooltip || !ttType || !ttLabel) return;
    ttType.textContent = d.type;
    ttLabel.textContent = d.name || d.alias || d.type;
    tooltip.style.display = 'block';
    tooltip.style.left = (event.pageX + 15) + 'px';
    tooltip.style.top = (event.pageY - 10) + 'px';
  }

  function hideTooltip() {
    if (tooltip) tooltip.style.display = 'none';
  }

  // Search
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      const q = this.value.toLowerCase();
      if (!q) {
        searchResults.classList.remove('active');
        return;
      }
      const matches = graphData.nodes.filter(d => (d.name || d.alias || '').toLowerCase().includes(q)).slice(0, 8);
      searchResults.innerHTML = matches.map(d =>
        '<div class="pwa-graph-search-item" data-id="' + d.id + '">' +
        '<span class="dot" style="background:' + getNodeColor(d) + '"></span>' +
        '<span class="t">' + (d.name || d.alias) + '</span>' +
        '<span class="sub">' + d.type + '</span></div>'
      ).join('');
      searchResults.classList.add('active');
    });
  }

  // Search results click
  if (searchResults) {
    searchResults.addEventListener('click', function(e) {
      const item = (e.target as HTMLElement).closest('.pwa-graph-search-item') as HTMLElement;
      if (!item) return;
      const id = item.dataset.id;
      const d = graphData.nodes.find(n => n.id === id);
      if (d) {
        showDetail(d);
        searchResults.classList.remove('active');
        if (searchInput) searchInput.value = '';
      }
    });
  }

  // Close search on outside click
  document.addEventListener('click', function(e) {
    if (searchInput && !searchInput.contains(e.target as Node) && searchResults) {
      searchResults.classList.remove('active');
    }
  });

  // Filters
  if (filtersEl) {
    filtersEl.querySelectorAll('.pwa-graph-filter-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const type = (this as HTMLElement).dataset.type || '';
        activeFilters[type] = !activeFilters[type];
        this.classList.toggle('on', activeFilters[type]);
        update();
      });
    });
  }

  // Detail close
  const detailCloseBtn = document.getElementById('pwa-graph-detail-close');
  if (detailCloseBtn) {
    detailCloseBtn.addEventListener('click', function() {
      detail.classList.remove('open');
    });
  }

  // Zoom controls
  const zoomInBtn = document.getElementById('pwa-graph-zoom-in');
  const zoomOutBtn = document.getElementById('pwa-graph-zoom-out');
  const zoomResetBtn = document.getElementById('pwa-graph-zoom-reset');

  if (zoomInBtn) zoomInBtn.addEventListener('click', () => svg.transition().call(d3.zoom<SVGSVGElement, unknown>().scaleBy as any, 1.3));
  if (zoomOutBtn) zoomOutBtn.addEventListener('click', () => svg.transition().call(d3.zoom<SVGSVGElement, unknown>().scaleBy as any, 0.7));
  if (zoomResetBtn) zoomResetBtn.addEventListener('click', () => svg.transition().call(d3.zoom<SVGSVGElement, unknown>().transform as any, d3.zoomIdentity));

  // Init
  init();
  if (loading) loading.style.display = 'none';
</script>

<style>
  .pwa-graph-container {
    position: relative;
    width: 100%;
    height: calc(100vh - 120px);
    background: #0a0a0f;
    overflow: hidden;
  }

  .pwa-graph-header {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 10;
  }

  .pwa-graph-controls {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 10;
  }

  .pwa-graph-search {
    position: relative;
  }

  .pwa-graph-search-input {
    width: 200px;
    padding: 8px 12px;
    background: #1a1a2e;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
    color: #c0c0e0;
    font-size: 14px;
  }

  .pwa-graph-search-results {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #1a1a2e;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
    display: none;
    max-height: 300px;
    overflow-y: auto;
  }

  .pwa-graph-search-results.active {
    display: block;
  }

  .pwa-graph-search-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    cursor: pointer;
  }

  .pwa-graph-search-item:hover {
    background: #2a2a3e;
  }

  .pwa-graph-search-item .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .pwa-graph-search-item .t {
    color: #fff;
    flex: 1;
  }

  .pwa-graph-search-item .sub {
    color: #666;
    font-size: 12px;
  }

  .pwa-graph-filters {
    display: flex;
    gap: 8px;
  }

  .pwa-graph-filter-btn {
    padding: 6px 12px;
    background: #1a1a2e;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
    color: #666;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .pwa-graph-filter-btn.on {
    background: #e9456033;
    border-color: #e94560;
    color: #e94560;
  }

  .pwa-graph-zoom-controls {
    display: flex;
    gap: 4px;
  }

  .pwa-graph-zoom-btn {
    width: 32px;
    height: 32px;
    background: #1a1a2e;
    border: 1px solid #2a2a3e;
    border-radius: 6px;
    color: #c0c0e0;
    font-size: 18px;
    cursor: pointer;
  }

  .pwa-graph-zoom-btn:hover {
    background: #2a2a3e;
  }

  .pwa-graph-stats {
    position: absolute;
    bottom: 16px;
    left: 16px;
    display: flex;
    gap: 16px;
    padding: 8px 16px;
    background: #1a1a2e;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
    font-size: 12px;
    color: #888;
    z-index: 10;
  }

  .pwa-graph-stats strong {
