---
// GraphExplorer - D3.js Knowledge Graph Visualization
---

<style>
  .graph-container {
    width: 100%;
    height: 700px;
    border: 1px solid #000;
    background: #fafafa;
    position: relative;
    overflow: hidden;
  }
  
  .controls {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 10;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    background: #fff;
    padding: 10px;
    border: 1px solid #000;
  }
  
  .filter-group {
    display: flex;
    gap: 5px;
    align-items: center;
  }
  
  .filter-group label {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: bold;
  }
  
  .filter-group select {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    padding: 4px 8px;
    border: 1px solid #000;
    background: #fff;
    cursor: pointer;
  }
  
  .legend {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: #fff;
    border: 1px solid #000;
    padding: 12px;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
  }
  
  .legend-title {
    font-weight: bold;
    margin-bottom: 8px;
    border-bottom: 1px solid #000;
    padding-bottom: 4px;
  }
  
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0;
  }
  
  .legend-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid #000;
  }
  
  .legend-dot.recipe { background: #e63946; }
  .legend-dot.ingredient { background: #2a9d8f; }
  .legend-dot.region { background: #457b9d; }
  
  .info-panel {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 280px;
    background: #fff;
    border: 1px solid #000;
    padding: 15px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    display: none;
    max-height: 400px;
    overflow-y: auto;
  }
  
  .info-panel.visible { display: block; }
  .info-panel h3 { margin: 0 0 10px 0; font-size: 14px; border-bottom: 1px solid #000; padding-bottom: 8px; }
  .info-panel dl { margin: 0; }
  .info-panel dt { font-weight: bold; margin-top: 10px; font-size: 10px; text-transform: uppercase; }
  .info-panel dd { margin: 4px 0 0 0; font-size: 12px; }
  
  .close-btn {
    position: absolute;
    top: 8px;
    right: 10px;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    font-family: 'Space Mono', monospace;
  }
  
  .stats {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: #fff;
    border: 1px solid #000;
    padding: 8px 12px;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
  }
</style>

<div class="graph-container" id="graph-container">
  <div class="controls">
    <div class="filter-group">
      <label>REGION:</label>
      <select id="region-filter">
        <option value="all">ALL</option>
        <option value="china">CHINA</option>
        <option value="colombia">COLOMBIA</option>
        <option value="peru">PERU</option>
      </select>
    </div>
    <div class="filter-group">
      <label>TYPE:</label>
      <select id="type-filter">
        <option value="all">ALL</option>
        <option value="recipe">RECIPES</option>
        <option value="ingredient">INGREDIENTS</option>
        <option value="region">REGIONS</option>
      </select>
    </div>
  </div>
  
  <div class="info-panel" id="info-panel">
    <button class="close-btn" id="close-info">X</button>
    <h3 id="node-title">NODE INFO</h3>
    <dl>
      <dt>TYPE</dt><dd id="node-type">-</dd>
      <dt>REGION</dt><dd id="node-region">-</dd>
      <dt>CATEGORY</dt><dd id="node-category">-</dd>
      <dt>CONNECTIONS</dt><dd id="node-connections">-</dd>
    </dl>
  </div>
  
  <div class="stats" id="stats">
    <div class="stats-item">NODES: <span id="node-count">0</span></div>
    <div class="stats-item">LINKS: <span id="link-count">0</span></div>
  </div>
  
  <div class="legend">
    <div class="legend-title">LEGEND</div>
    <div class="legend-item"><div class="legend-dot recipe"></div><span>RECIPES</span></div>
    <div class="legend-item"><div class="legend-dot ingredient"></div><span>INGREDIENTS</span></div>
    <div class="legend-item"><div class="legend-dot region"></div><span>REGIONS</span></div>
  </div>
  
  <svg id="graph-svg"></svg>
</div>

<script is:inline>
(function() {
  const container = document.getElementById('graph-container');
  if (!container) return;
  
  const width = container.clientWidth || 800;
  const height = container.clientHeight || 600;
  
  const svg = d3.select('#graph-svg')
    .attr('width', width)
    .attr('height', height);
  
  const g = svg.append('g');
  
  fetch('/graph.json')
    .then(r => r.json())
    .then(data => {
      const nodes = data.nodes || [];
      const links = data.links || [];
      
      document.getElementById('node-count').textContent = nodes.length;
      document.getElementById('link-count').textContent = links.length;
      
      if (nodes.length === 0) {
        g.append('text')
          .attr('x', width / 2)
          .attr('y', height / 2)
          .attr('text-anchor', 'middle')
          .attr('font-family', 'Space Mono, monospace')
          .attr('font-size', '14px')
          .text('NO DATA');
        return;
      }
      
      const getColor = (type) => {
        if (type === 'recipe') return '#e63946';
        if (type === 'region') return '#457b9d';
        return '#2a9d8f';
      };
      
      const getSize = (type) => {
        if (type === 'recipe') return 12;
        if (type === 'region') return 18;
        return 8;
      };
      
      const simulation = d3.forceSimulation(nodes)
        .force('link', d3.forceLink(links).id(d => d.id).distance(80))
        .force('charge', d3.forceManyBody().strength(-200))
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force('collision', d3.forceCollide().radius(25));
      
      const link = g.append('g')
        .selectAll('line')
        .data(links)
        .join('line')
        .attr('stroke', '#999')
        .attr('stroke-opacity', 0.4)
        .attr('stroke-width', d => Math.sqrt(d.value || 1));
      
      const node = g.append('g')
        .selectAll('circle')
        .data(nodes)
        .join('circle')
        .attr('r', d => getSize(d.type))
        .attr('fill', d => getColor(d.type))
        .attr('stroke', '#000')
        .attr('stroke-width', 1)
        .style('cursor', 'pointer')
        .call(d3.drag()
          .on('start', (event, d) => {
            if (!event.active) simulation.alphaTarget(0.3).restart();
            d.fx = d.x;
            d.fy = d.y;
          })
          .on('drag', (event, d) => {
            d.fx = event.x;
            d.fy = event.y;
          })
          .on('end', (event, d) => {
            if (!event.active) simulation.alphaTarget(0);
            d.fx = null;
            d.fy = null;
          }));
      
      const label = g.append('g')
        .selectAll('text')
        .data(nodes)
        .join('text')
        .text(d => d.id)
        .attr('font-size', '8px')
        .attr('font-family', 'Space Mono, monospace')
        .attr('fill', '#000')
        .attr('pointer-events', 'none');
      
      simulation.on('tick', () => {
        link
          .attr('x1', d => d.source.x)
          .attr('y1', d => d.source.y)
          .attr('x2', d => d.target.x)
          .attr('y2', d => d.target.y);
        node
          .attr('cx', d => d.x)
          .attr('cy', d => d.y);
        label
          .attr('x', d => d.x)
          .attr('y', d => d.y + getSize(d.type) + 12);
      });
      
      node.on('click', (event, d) => {
        const connections = links.filter(l => 
          l.source.id === d.id || l.target.id === d.id
        ).length;
        document.getElementById('node-title').textContent = (d.id || 'UNKNOWN').toUpperCase();
        document.getElementById('node-type').textContent = (d.type || '-').toUpperCase();
        document.getElementById('node-region').textContent = (d.region || '-').toUpperCase();
        document.getElementById('node-category').textContent = (d.category || '-').toUpperCase();
        document.getElementById('node-connections').textContent = connections;
        document.getElementById('info-panel').classList.add('visible');
      });
      
      document.getElementById('close-info').onclick = () => {
        document.getElementById('info-panel').classList.remove('visible');
      };
      
      const regionSelect = document.getElementById('region-filter');
      const typeSelect = document.getElementById('type-filter');
      
      function applyFilters() {
        const regionVal = regionSelect.value;
        const typeVal = typeSelect.value;
        
        node.style('display', d => {
          if (typeVal !== 'all' && d.type !== typeVal) return 'none';
          if (regionVal !== 'all' && d.region !== regionVal) return 'none';
          return 'block';
        });
        
        label.style('display', d => {
          if (typeVal !== 'all' && d.type !== typeVal) return 'none';
          if (regionVal !== 'all' && d.region !== regionVal) return 'none';
          return 'block';
        });
        
        link.style('display', d => {
          const s = nodes.find(n => n.id === d.source.id || n.id === d.source);
          const t = nodes.find(n => n.id === d.target.id || n.id === d.target);
          const sVisible = !node.filter(n => n.id === s?.id).empty();
          const tVisible = !node.filter(n => n.id === t?.id).empty();
          return sVisible && tVisible ? 'block' : 'none';
        });
      }
      
      regionSelect.onchange = applyFilters;
      typeSelect.onchange = applyFilters;
    })
    .catch(err => {
      console.error('Error loading graph:', err);
      g.append('text')
        .attr('x', width / 2)
        .attr('y', height / 2)
        .attr('text-anchor', 'middle')
        .attr('font-family', 'Space Mono, monospace')
        .attr('font-size', '14px')
        .text('ERROR LOADING DATA');
    });
})();
</script>
