---
// GraphExplorer - Premium D3.js Knowledge Graph for GOS
// Data: /graph-data.json (1176 nodes, 1465 edges)
---

<style>
  .ge-wrapper { width:100%; height:720px; background:#0a0a0f; position:relative; overflow:hidden; border-radius:12px; border:1px solid #1e1e2e; font-family:Inter,system-ui,sans-serif; }
  .ge-topbar { position:absolute; top:0; left:0; right:0; height:56px; background:rgba(10,10,15,0.92); backdrop-filter:blur(12px); border-bottom:1px solid #1e1e2e; display:flex; align-items:center; padding:0 16px; gap:10px; z-index:20; }
  .ge-title { font-size:12px; font-weight:700; color:#7d61ff; letter-spacing:0.08em; text-transform:uppercase; white-space:nowrap; }
  .ge-search { flex:1; max-width:320px; position:relative; }
  .ge-search input { width:100%; background:#12121a; border:1px solid #2a2a3e; border-radius:8px; color:#e0e0ff; font-size:12px; padding:7px 12px 7px 34px; outline:none; transition:border-color 0.2s; box-sizing:border-box; }
  .ge-search input:focus { border-color:#7d61ff; }
  .ge-search input::placeholder { color:#4a4a6a; }
  .ge-search-icon { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#4a4a6a; font-size:13px; }
  .ge-search-results { position:absolute; top:calc(100% + 4px); left:0; right:0; background:#12121a; border:1px solid #2a2a3e; border-radius:8px; max-height:240px; overflow-y:auto; display:none; z-index:30; }
  .ge-search-results.active { display:block; }
  .ge-search-item { padding:8px 12px; font-size:12px; color:#c0c0e0; cursor:pointer; border-bottom:1px solid #1a1a2a; display:flex; align-items:center; gap:8px; transition:background 0.15s; }
  .ge-search-item:last-child { border-bottom:none; }
  .ge-search-item:hover { background:#1e1e30; color:#fff; }
  .ge-search-item .dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .ge-search-item .t { font-weight:600; color:#fff; flex:1; }
  .ge-search-item .sub { font-size:10px; color:#666; }
  .ge-filters { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
  .ge-filter-btn { background:#12121a; border:1px solid #2a2a3e; border-radius:6px; color:#8080a0; font-size:10px; font-weight:600; padding:4px 9px; cursor:pointer; letter-spacing:0.05em; text-transform:uppercase; transition:all 0.15s; display:flex; align-items:center; gap:5px; }
  .ge-filter-btn .dot { width:7px; height:7px; border-radius:50%; }
  .ge-filter-btn.on { color:#fff; }
  .ge-filter-btn.on.recipe { color:#ff6b35; border-color:#ff6b35; }
  .ge-filter-btn.on.ingredient { color:#00ff66; border-color:#00ff66; }
  .ge-filter-btn.on.flavor { color:#ffe66d; border-color:#ffe66d; }
  .ge-filter-btn.on.texture { color:#f38181; border-color:#f38181; }
  .ge-filter-btn.on.aroma { color:#a8e6cf; border-color:#a8e6cf; }
  .ge-filter-btn.on.region { color:#7d61ff; border-color:#7d61ff; }
  .ge-filter-btn.on.nutrition { color:#f9c74f; border-color:#f9c74f; }
  .ge-filter-btn.on.category { color:#90be6d; border-color:#90be6d; }
  .ge-canvas { position:absolute; top:56px; left:0; right:0; bottom:0; }
  .ge-canvas svg { width:100%; height:100%; display:block; }
  .ge-detail { position:absolute; top:56px; right:0; width:300px; height:calc(100% - 56px); background:rgba(12,12,20,0.97); border-left:1px solid #1e1e2e; transform:translateX(100%); transition:transform 0.3s cubic-bezier(0.4,0,0.2,1); z-index:15; overflow-y:auto; }
  .ge-detail.open { transform:translateX(0); }
  .ge-detail-header { padding:14px 16px; border-bottom:1px solid #1e1e2e; display:flex; align-items:flex-start; justify-content:space-between; position:sticky; top:0; background:rgba(12,12,20,0.98); z-index:2; }
  .ge-detail-type { font-size:9px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; padding:3px 8px; border-radius:4px; margin-bottom:7px; display:inline-block; }
  .ge-detail-title { font-size:15px; font-weight:700; color:#fff; line-height:1.3; }
  .ge-detail-close { background:none; border:none; color:#4a4a6a; font-size:18px; cursor:pointer; padding:0; line-height:1; flex-shrink:0; margin-left:8px; }
  .ge-detail-close:hover { color:#fff; }
  .ge-detail-body { padding:14px 16px; }
  .ge-meta-grid { display:grid; grid-template-columns:1fr 1fr; gap:7px; margin-bottom:14px; }
  .ge-meta-item { background:#12121a; border-radius:8px; padding:7px 10px; }
  .ge-meta-item .l { font-size:9px; font-weight:600; text-transform:uppercase; color:#4a4a6a; letter-spacing:0.08em; margin-bottom:3px; }
  .ge-meta-item .v { font-size:13px; color:#e0e0ff; font-weight:500; }
  .ge-section-title { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:#4a4a6a; margin:14px 0 7px 0; padding-bottom:5px; border-bottom:1px solid #1a1a2a; }
  .ge-tag-list { display:flex; flex-wrap:wrap; gap:5px; }
  .ge-tag { background:#1a1a2a; border:1px solid #2a2a3e; border-radius:4px; padding:3px 8px; font-size:10px; color:#9090b0; }
  .ge-conn-group { margin-bottom:10px; }
  .ge-conn-label { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#3a3a5a; margin-bottom:5px; }
  .ge-conn-items { display:flex; flex-direction:column; gap:3px; }
  .ge-conn-item { background:#0f0f18; border-radius:6px; padding:6px 9px; font-size:11px; color:#c0c0e0; cursor:pointer; display:flex; align-items:center; gap:7px; transition:background 0.15s; border:1px solid transparent; }
  .ge-conn-item:hover { background:#1a1a2e; border-color:#2a2a3e; color:#fff; }
  .ge-conn-item .dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .ge-legend { position:absolute; bottom:12px; left:12px; background:rgba(10,10,15,0.88); backdrop-filter:blur(8px); border:1px solid #1e1e2e; border-radius:10px; padding:9px 14px; display:flex; flex-wrap:wrap; gap:8px 14px; max-width:420px; z-index:10; }
  .ge-zoom-btn:hover { background:#1e1e30; color:#fff; }
  .ge-tooltip { position:absolute; background:rgba(10,10,20,0.96); border:1px solid #2a2a3e; border-radius:8px; padding:8px 12px; font-size:11px; color:#e0e0ff; pointer-events:none; z-index:25; max-width:200px; box-shadow:0 4px 20px rgba(0,0,0,0.6); display:none; white-space:nowrap; }
  .ge-tooltip .tt-type { font-size:9px; text-transform:uppercase; letter-spacing:0.08em; font-weight:700; margin-bottom:3px; }
  .ge-tooltip .tt-label { font-weight:600; color:#fff; margin-bottom:3px; }
  .ge-tooltip .tt-meta { font-size:10px; color:#8080a0; }
  .ge-minimap { position:absolute; right:12px; bottom:48px; width:130px; height:90px; background:rgba(10,10,15,0.88); border:1px solid #1e1e2e; border-radius:8px; overflow:hidden; z-index:10; }
  .ge-minimap svg { width:100%; height:100%; display:block; }
  .ge-minimap-label { position:absolute; top:4px; left:6px; font-size:8px; color:#4a4a6a; text-transform:uppercase; letter-spacing:0.08em; font-weight:700; pointer-events:none; }
  .ge-legend-item { display:flex; align-items:center; gap:6px; font-size:10px; color:#6060a0; font-weight:500; transition:color 0.15s; cursor:pointer; }
  .ge-legend-item:hover { color:#fff; }
  .ge-legend-item .dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
  .ge-legend-item.dimmed { opacity:0.3; }
  .ge-image-placeholder { width:100%; height:110px; border-radius:8px; margin-bottom:14px; display:flex; align-items:center; justify-content:center; font-size:44px; background:#12121a; border:1px solid #1e1e2e; flex-shrink:0; }
  .ge-image-thumb { width:100%; height:110px; border-radius:8px; margin-bottom:14px; overflow:hidden; flex-shrink:0; }
  .ge-image-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
  .ge-instructions { background:#0f0f18; border-radius:8px; padding:10px 12px; font-size:11px; color:#b0b0d0; line-height:1.65; border-left:3px solid #ff6b35; margin-bottom:14px; }
  .ge-nutrition-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:6px; margin-bottom:14px; }
  .ge-nutrition-item { background:#12121a; border-radius:6px; padding:6px 8px; text-align:center; }
  .ge-nutrition-item .nv { font-size:13px; font-weight:600; color:#f9c74f; }
  .ge-nutrition-item .nl { font-size:8px; text-transform:uppercase; color:#4a4a6a; letter-spacing:0.08em; margin-top:2px; }
  .ge-history { background:#0f0f18; border-radius:8px; padding:10px 12px; font-size:11px; color:#b0b0d0; line-height:1.65; border-left:3px solid #7d61ff; margin-bottom:14px; }
  .ge-technique { display:inline-flex; align-items:center; gap:5px; background:#1a1a2a; border:1px solid #2a2a3e; border-radius:4px; padding:3px 8px; font-size:10px; color:#a8e6cf; margin-bottom:14px; }
  .ge-related-label { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#3a3a5a; margin-bottom:5px; }
  .ge-related-items { display:flex; flex-direction:column; gap:3px; }
  .ge-related-item { background:#0f0f18; border-radius:6px; padding:6px 9px; font-size:11px; color:#c0c0e0; cursor:pointer; display:flex; align-items:center; gap:7px; transition:background 0.15s; border:1px solid transparent; }
  .ge-related-item:hover { background:#1a1a2e; border-color:#2a2a3e; color:#fff; }
  .ge-related-item .dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .ge-conn-item .emoji { font-size:14px; width:20px; text-align:center; }
  .ge-meta-item.full-width { grid-column:1/-1; }

  .ge-stats { position:absolute; bottom:12px; right:12px; background:rgba(10,10,15,0.88); backdrop-filter:blur(8px); border:1px solid #1e1e2e; border-radius:8px; padding:7px 12px; font-size:10px; color:#4a4a6a; display:flex; gap:14px; z-index:10; }
  .ge-stats .s { color:#8080c0; font-weight:600; }
  .ge-loading { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:12px; color:#4a4a6a; font-size:12px; z-index:5; }
  .ge-spinner { width:32px; height:32px; border:2px solid #1e1e2e; border-top-color:#7d61ff; border-radius:50%; animation:ge-spin 0.8s linear infinite; }
  @keyframes ge-spin { to{transform:rotate(360deg)} }
  .ge-zoom-btns { position:absolute; right:12px; top:68px; display:flex; flex-direction:column; gap:4px; z-index:10; }
  .ge-zoom-btn { width:30px; height:30px; background:rgba(12,12,20,0.9); border:1px solid #2a2a3e; border-radius:6px; color:#8080a0; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.15s; }
  .ge-zoom-btn:hover { background:#1e1e30; color:#fff; }
</style>

<div class="ge-wrapper" id="ge-wrapper">
  <div class="ge-topbar">
    <div class="ge-title">GOS Knowledge Graph</div>
    <div class="ge-search">
      <span class="ge-search-icon">&#8981;</span>
      <input type="text" id="ge-search-input" placeholder="Search recipes, ingredients..." autocomplete="off"/>
      <div class="ge-search-results" id="ge-search-results"></div>
    </div>
    <div class="ge-filters" id="ge-filters"></div>
  </div>
  <div class="ge-canvas" id="ge-canvas">
    <div class="ge-loading" id="ge-loading"><div class="ge-spinner"></div><span>Loading knowledge graph...</span></div>
  </div>
  <div class="ge-zoom-btns">
    <button class="ge-zoom-btn" id="ge-zoom-in">+</button>
    <button class="ge-zoom-btn" id="ge-zoom-out">&#8722;</button>
    <button class="ge-zoom-btn" id="ge-zoom-reset">&#8635;</button>
  </div>
  <div class="ge-tooltip" id="ge-tooltip">
    <div class="tt-type" id="ge-tt-type"></div>
    <div class="tt-label" id="ge-tt-label"></div>
    <div class="tt-meta" id="ge-tt-meta"></div>
  </div>
  <div class="ge-minimap" id="ge-minimap">
    <span class="ge-minimap-label">Overview</span>
  </div>
  <div class="ge-detail" id="ge-detail">
    <div class="ge-detail-header">
      <div>
        <div class="ge-detail-type" id="ge-detail-type">NODE</div>
        <div class="ge-detail-title" id="ge-detail-title">-</div>
      </div>
      <button class="ge-detail-close" id="ge-detail-close">&#10005;</button>
    </div>
    <div class="ge-detail-body" id="ge-detail-body"></div>
  </div>
  <div class="ge-legend" id="ge-legend"></div>
  <div class="ge-stats">
    <span>NODES <span class="s" id="ge-node-count">0</span></span>
    <span>EDGES <span class="s" id="ge-edge-count">0</span></span>
    <span>RECIPES <span class="s" id="ge-recipe-count">0</span></span>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7"></script>
<script is:inline>
(function() {
  var COLORS = { recipe:'#FF6B6B', ingredient:'#4ECDC4', flavor:'#FFE66D', texture:'#F38181', aroma:'#A8E6CF', region:'#FFE66D', technique:'#AA96DA', nutrition:'#F9C74F', category:'#A8D8A8', place:'#B2E2F2' };
  var EDGE_COLORS = { HAS_RECIPE:'#7d61ff', USES:'#4ECDC4', USES_INGREDIENT:'#4ECDC4', BELONGS_TO:'#A8D8A8', HAS_FLAVOR:'#FFE66D', HAS_TEXTURE:'#F38181', HAS_AROMA:'#A8E6CF', HAS_MACRO:'#F9C74F', FROM_REGION:'#FFE66D', RELATED_DISHES:'#FF6B6B', PLACE:'#B2E2F2', USES_TECHNIQUE:'#AA96DA', OFTEN_TOGETHER:'#95E1D3' };
  var EDGE_DIST = { HAS_RECIPE:130, USES:55, USES_INGREDIENT:55, BELONGS_TO:80, HAS_FLAVOR:45, HAS_TEXTURE:45, HAS_AROMA:45, HAS_MACRO:35, FROM_REGION:90, RELATED_DISHES:120, PLACE:70, USES_TECHNIQUE:60, OFTEN_TOGETHER:50 };
  var TYPE_LABELS = { recipe:'Recipes', ingredient:'Ingredients', flavor:'Flavors', texture:'Textures', aroma:'Aromas', region:'Regions', nutrition:'Nutrition', category:'Categories', place:'Places', technique:'Techniques' };
  var TYPE_ORDER = ['recipe','region','ingredient','flavor','texture','technique','aroma','nutrition','category','place'];

  var NODE_EMOJI = { recipe:'\uD83C\uDF72', ingredient:'\uD83E\uDD57', flavor:'\uD83C\uDF36', texture:'\uD83E\uDE79', aroma:'\uD83C\uDF43', region:'\uD83C\uDF0D', nutrition:'\uD83E\uDD57', category:'\uD83C\uDF74' };
  var TYPE_SINGULAR = { recipe:'Recipe', ingredient:'Ingredient', flavor:'Flavor', texture:'Texture', aroma:'Aroma', region:'Region', nutrition:'Nutrition', category:'Category' };
  var ETYPE_LABELS = { HAS_RECIPE:'Recipes', USES:'Ingredients', USES_INGREDIENT:'Ingredients', BELONGS_TO:'Category', HAS_FLAVOR:'Flavors', HAS_TEXTURE:'Textures', HAS_AROMA:'Aromas', HAS_MACRO:'Nutrition', FROM_REGION:'Region', RELATED_DISHES:'Related Dishes', PLACE:'Places', USES_TECHNIQUE:'Techniques', OFTEN_TOGETHER:'Often Together' };

  var wrapper = document.getElementById('ge-wrapper');
  var canvas = document.getElementById('ge-canvas');
  var loading = document.getElementById('ge-loading');
  var detail = document.getElementById('ge-detail');
  var detailBody = document.getElementById('ge-detail-body');
  var detailTitle = document.getElementById('ge-detail-title');
  var detailType = document.getElementById('ge-detail-type');
  var searchInput = document.getElementById('ge-search-input');
  var searchResults = document.getElementById('ge-search-results');
  var filtersEl = document.getElementById('ge-filters');
  var legendEl = document.getElementById('ge-legend');
  var nodeCountEl = document.getElementById('ge-node-count');
  var edgeCountEl = document.getElementById('ge-edge-count');
  var recipeCountEl = document.getElementById('ge-recipe-count');
  var tooltip = document.getElementById('ge-tooltip');
  var minimapEl = document.getElementById('ge-minimap');
  var ttType = document.getElementById('ge-tt-type');
  var ttLabel = document.getElementById('ge-tt-label');
  var ttMeta = document.getElementById('ge-tt-meta');

  var W, H;
  var graphData = null;
  var filteredNodes = null;
  var filteredLinks = null;
  var simulation = null;
  var svgSel = null;
  var gSel = null;
  var zoomBehavior = null;
  var currentTransform = d3.zoomIdentity;
  var activeTypes = new Set(Object.keys(COLORS));

  function resize() {
    W = canvas.clientWidth || 900;
    H = canvas.clientHeight || 660;
  }
  resize();

  var ETYPE_LABELS = { HAS_RECIPE:'Recipes', USES_INGREDIENT:'Ingredients', BELONGS_TO:'Category', HAS_FLAVOR:'Flavors', HAS_TEXTURE:'Textures', HAS_AROMA:'Aromas', HAS_MACRO:'Nutrition' };

  fetch('/graph-data.json').then(function(r) { return r.json(); }).then(function(data) {
    graphData = data;
    filteredNodes = data.nodes.map(function(n) { return Object.assign({}, n); });
    filteredLinks = data.edges.map(function(e) { return Object.assign({}, e); });

    var connCount = {};
    data.edges.forEach(function(e) {
      var s = e.source && (e.source.id || e.source);
      var t = e.target && (e.target.id || e.target);
      if (s) connCount[s] = (connCount[s] || 0) + 1;
      if (t) connCount[t] = (connCount[t] || 0) + 1;
    });
    filteredNodes.forEach(function(n) { n.connections = connCount[n.id] || 0; });

    var recipeNodes = data.nodes.filter(function(n) { return n.type === 'recipe'; });
    nodeCountEl.textContent = data.nodes.length;
    edgeCountEl.textContent = data.edges.length;
    recipeCountEl.textContent = recipeNodes.length;

    buildFilters(data.nodes);
    buildLegend(data.nodes);
    initGraph();
    loading.style.display = 'none';
  }).catch(function() {
    loading.innerHTML = '<span style="color:#f38181">Error loading graph data</span>';
  });

  function buildFilters(nodes) {
    var counts = {};
    nodes.forEach(function(n) { counts[n.type] = (counts[n.type] || 0) + 1; });
    filtersEl.innerHTML = '';
    TYPE_ORDER.forEach(function(t) {
      if (!counts[t]) return;
      var btn = document.createElement('button');
      btn.className = 'ge-filter-btn ' + t + ' on';
      btn.dataset.type = t;
      var dot = document.createElement('span');
      dot.className = 'dot';
      dot.style.background = COLORS[t];
      btn.appendChild(dot);
      btn.appendChild(document.createTextNode(TYPE_LABELS[t] + ' (' + counts[t] + ')'));
      btn.onclick = function() { toggleType(t, btn); };
      filtersEl.appendChild(btn);
    });
  }

  function toggleType(t, btn) {
    if (activeTypes.has(t)) {
      activeTypes.delete(t);
      btn.classList.remove('on');
    } else {
      activeTypes.add(t);
      btn.classList.add('on');
    }
    applyFilters();
  }

  function buildLegend(nodes) {
    var counts = {};
    nodes.forEach(function(n) { counts[n.type] = (counts[n.type] || 0) + 1; });
    legendEl.innerHTML = '';
    TYPE_ORDER.forEach(function(t) {
      if (!counts[t]) return;
      var item = document.createElement('div');
      item.className = 'ge-legend-item';
      var dot = document.createElement('span');
      dot.className = 'dot';
      dot.style.background = COLORS[t];
      item.appendChild(dot);
      item.appendChild(document.createTextNode(TYPE_LABELS[t] + ' (' + counts[t] + ')'));
      legendEl.appendChild(item);
    });
  }

  function applyFilters() {
    filteredNodes = graphData.nodes.filter(function(n) {
      return activeTypes.has(n.type) && (n.connections || 0) >= 0;
    });
    var nodeIds = {};
    filteredNodes.forEach(function(n) { nodeIds[n.id] = true; });
    filteredLinks = graphData.edges.filter(function(e) {
      var s = e.source && (e.source.id || e.source);
      var t = e.target && (e.target.id || e.target);
      return nodeIds[s] && nodeIds[t];
    });
    updateGraph();
  }

  function initGraph() {
    svgSel = d3.select(canvas).append('svg').attr('width', '100%').attr('height', '100%');

    var defs = svgSel.append('defs');
    Object.keys(COLORS).forEach(function(type) {
      var f = defs.append('filter').attr('id', 'glow-' + type).attr('x','-50%').attr('y','-50%').attr('width','200%').attr('height','200%');
      f.append('feGaussianBlur').attr('stdDeviation','3').attr('result','blur');
      var merge = f.append('feMerge');
      merge.append('feMergeNode').attr('in','blur');
      merge.append('feMergeNode').attr('in','SourceGraphic');
    });

    defs.append('clipPath').attr('id','clip').append('rect').attr('width',W).attr('height',H);

    zoomBehavior = d3.zoom().scaleExtent([0.08, 10]).on('zoom', function(e) {
      currentTransform = e.transform;
      gSel.attr('transform', e.transform);
    });
    svgSel.call(zoomBehavior).on('dblclick.zoom', null);

    gSel = svgSel.append('g').attr('clip-path', 'url(#clip)');
    gSel.append('g').attr('class', 'edges');
    gSel.append('g').attr('class', 'nodes');

    simulation = d3.forceSimulation(filteredNodes)
      .force('link', d3.forceLink(filteredLinks).id(function(n) { return n.id; }).distance(function(e) { return EDGE_DIST[e.type] || 70; }).strength(0.5))
      .force('charge', d3.forceManyBody().strength(-160).distanceMax(350))
      .force('center', d3.forceCenter(W/2, H/2))
      .force('collision', d3.forceCollide().radius(function(n) { return (n.size || 8) + 10; }))
      .force('x', d3.forceX(W/2).strength(0.025))
      .force('y', d3.forceY(H/2).strength(0.025))
      .alphaDecay(0.022);

    simulation.on('tick', ticked);
    updateGraph();

    var drag = d3.drag()
      .on('start', function(e, d) { if (!e.active) simulation.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; })
      .on('drag', function(e, d) { d.fx = e.x; d.fy = e.y; })
      .on('end', function(e, d) { if (!e.active) simulation.alphaTarget(0); d.fx = null; d.fy = null; });
    svgSel.call(drag);
  }

  function ticked() {
    gSel.select('.edges').selectAll('line')
      .attr('x1', function(d) { return Math.max(0, Math.min(W, d.source.x || 0)); })
      .attr('y1', function(d) { return Math.max(0, Math.min(H, d.source.y || 0)); })
      .attr('x2', function(d) { return Math.max(0, Math.min(W, d.target.x || 0)); })
      .attr('y2', function(d) { return Math.max(0, Math.min(H, d.target.y || 0)); });
    gSel.select('.nodes').selectAll('circle')
      .attr('cx', function(d) { return Math.max(0, Math.min(W, d.x || 0)); })
      .attr('cy', function(d) { return Math.max(0, Math.min(H, d.y || 0)); });
    gSel.select('.nodes').selectAll('text')
      .attr('x', function(d) { return Math.max(0, Math.min(W, d.x || 0)); })
      .attr('y', function(d) { return Math.max(0, Math.min(H, (d.y || 0) + (d.size || 8) + 13)); })
      .attr('opacity', currentTransform.k > 1.3 ? 1 : 0);
  }

  function updateGraph() {
    if (!gSel || !simulation) return;

    var edgeData = filteredLinks;
    var nodeIds = {};
    filteredNodes.forEach(function(n) { nodeIds[n.id] = true; });

    var edges = gSel.select('.edges').selectAll('line')
      .data(edgeData, function(d) {
        var s = d.source && (d.source.id || d.source);
        var t = d.target && (d.target.id || d.target);
        return s + '-' + t;
      });
    edges.enter().append('line')
      .attr('stroke', function(d) { return EDGE_COLORS[d.type] || '#333'; })
      .attr('stroke-opacity', 0.45)
      .attr('stroke-width', 1.5)
      .merge(edges)
      .attr('stroke', function(d) { return EDGE_COLORS[d.type] || '#333'; });
    edges.exit().remove();

    var nodes = gSel.select('.nodes').selectAll('circle')
      .data(filteredNodes, function(d) { return d.id; });
    nodes.enter().append('circle')
      .attr('r', function(d) { return d.size || 8; })
      .attr('fill', function(d) { return COLORS[d.type] || '#888'; })
      .attr('stroke', '#000').attr('stroke-width', 0.5)
      .style('cursor', 'pointer')
      .on('click', function(e, d) { e.stopPropagation(); showDetail(d); })
      .on('mouseover', function(e, d) {
        var typeColor = COLORS[d.type] || '#888';
        ttType.textContent = TYPE_SINGULAR[d.type] || d.type;
        ttType.style.color = typeColor;
        ttLabel.textContent = d.label || d.id;
        var meta = [];
        if (d.region) meta.push(d.region);
        if (d.connections !== undefined) meta.push(d.connections + ' connections');
        ttMeta.textContent = meta.join(' · ');
        tooltip.style.display = 'block';
        tooltip.style.left = (e.offsetX + 14) + 'px';
        tooltip.style.top = (e.offsetY - 10) + 'px';
      })
      .on('mousemove', function(e) {
        tooltip.style.left = (e.offsetX + 14) + 'px';
        tooltip.style.top = (e.offsetY - 10) + 'px';
      })
      .on('mouseout', function() {
        tooltip.style.display = 'none';
      })
      .merge(nodes)
      .attr('r', function(d) { return d.size || 8; })
      .attr('fill', function(d) { return COLORS[d.type] || '#888'; });
    nodes.exit().remove();

    var labels = gSel.select('.nodes').selectAll('text')
      .data(filteredNodes, function(d) { return d.id; });
    labels.enter().append('text')
      .text(function(d) { return d.label || d.id; })
      .attr('font-size', '9px')
      .attr('font-family', 'Inter, system-ui, sans-serif')
      .attr('fill', '#5050a0')
      .attr('text-anchor', 'middle')
      .attr('pointer-events', 'none')
      .merge(labels)
      .text(function(d) { return d.label || d.id; })
      .attr('opacity', currentTransform.k > 1.3 ? 1 : 0);
    labels.exit().remove();

    simulation.nodes(filteredNodes);
    simulation.force('link').links(edgeData);
    simulation.alpha(0.6).restart();
  }

  function showDetail(node) {
    detailTitle.textContent = node.label || node.id;
    detailType.textContent = (node.type || 'node').toUpperCase();
    detailType.style.background = COLORS[node.type] || '#333';
    detailType.style.color = '#000';

    var conns = {};
    graphData.edges.forEach(function(e) {
      var s = e.source && (e.source.id || e.source);
      var t = e.target && (e.target.id || e.target);
      if (s === node.id || t === node.id) {
        var other = s === node.id ? t : s;
        if (!conns[e.type]) conns[e.type] = [];
        var otherNode = graphData.nodes.find(function(n) { return n.id === other; });
        if (otherNode) conns[e.type].push(otherNode);
      }
    });

    var connTotal = graphData.edges.filter(function(e) {
      var s = e.source && (e.source.id || e.source);
      var t = e.target && (e.target.id || e.target);
      return s === node.id || t === node.id;
    }).length;

    var html = '';

    if (node.region || node.difficulty || node.prep_time || node.cook_time) {
      html += '<div class="ge-meta-grid">';
      if (node.region) html += '<div class="ge-meta-item"><div class="l">Region</div><div class="v">'+node.region+'</div></div>';
      if (node.difficulty) html += '<div class="ge-meta-item"><div class="l">Difficulty</div><div class="v">'+node.difficulty+'</div></div>';
      if (node.prep_time) html += '<div class="ge-meta-item"><div class="l">Prep</div><div class="v">'+node.prep_time+'</div></div>';
      if (node.cook_time) html += '<div class="ge-meta-item"><div class="l">Cook</div><div class="v">'+node.cook_time+'</div></div>';
      html += '</div>';
    }

    html += '<div class="ge-meta-item" style="margin-bottom:14px"><div class="l">Connections</div><div class="v">'+connTotal+'</div></div>';

    if (node.tags && node.tags.length) {
      html += '<div class="ge-section-title">Tags</div><div class="ge-tag-list">';
      node.tags.forEach(function(t) { html += '<span class="ge-tag">'+t+'</span>'; });
      html += '</div>';
    }
    if (node.categories && node.categories.length) {
      html += '<div class="ge-section-title">Categories</div><div class="ge-tag-list">';
      node.categories.forEach(function(c) { html += '<span class="ge-tag">'+c+'</span>'; });
      html += '</div>';
    }

    Object.keys(conns).sort().forEach(function(type) {
      var items = conns[type];
      if (!items || !items.length) return;
      html += '<div class="ge-conn-group">';
      html += '<div class="ge-conn-label">' + (ETYPE_LABELS[type] || type) + ' (' + items.length + ')</div>';
      html += '<div class="ge-conn-items">';
      items.slice(0, 25).forEach(function(other) {
        var color = COLORS[other.type] || '#888';
        html += '<div class="ge-conn-item" onclick="window.focusNode(\''+other.id+'\')">';
        html += '<div class="dot" style="background:'+color+'"></div>';
        html += '<span>' + (other.label || other.id) + '</span>';
        html += '</div>';
      });
      if (items.length > 25) html += '<div class="ge-conn-item" style="color:#4a4a6a;cursor:default">+' + (items.length - 25) + ' more</div>';
      html += '</div></div>';
    });

    detailBody.innerHTML = html;
    detail.classList.add('open');
  }

  searchInput.addEventListener('input', function(e) {
    var q = e.target.value.toLowerCase().trim();
    searchResults.classList.remove('active');
    if (q.length < 2) return;
    var results = graphData.nodes.filter(function(n) {
      return (n.label || n.id).toLowerCase().includes(q);
    }).slice(0, 12);
    if (!results.length) return;
    searchResults.innerHTML = results.map(function(n) {
      return '<div class="ge-search-item" onclick="window.focusNode(\''+n.id+'\')">' +
        '<div class="dot" style="background:'+(COLORS[n.type]||'#888')+'"></div>' +
        '<span class="t">'+(n.label||n.id)+'</span>' +
        '<span class="sub">'+n.type+'</span></div>';
    }).join('');
    searchResults.classList.add('active');
  });
  searchInput.addEventListener('blur', function() { setTimeout(function() { searchResults.classList.remove('active'); }, 150); });

  window.focusNode = function(id) {
    var node = graphData && graphData.nodes.find(function(n) { return n.id === id; });
    if (!node) return;
    searchResults.classList.remove('active');
    searchInput.value = '';
    showDetail(node);
    if (node.x !== undefined && node.y !== undefined) {
      var scale = 3;
      var tx = W/2 - node.x * scale;
      var ty = H/2 - node.y * scale;
      svgSel.transition().duration(800).call(zoomBehavior.transform, d3.zoomIdentity.translate(tx, ty).scale(scale));
    }
  };

  document.getElementById('ge-zoom-in').onclick = function() { svgSel.transition().duration(300).call(zoomBehavior.scaleBy, 1.5); };
  document.getElementById('ge-zoom-out').onclick = function() { svgSel.transition().duration(300).call(zoomBehavior.scaleBy, 0.67); };
  document.getElementById('ge-zoom-reset').onclick = function() { svgSel.transition().duration(500).call(zoomBehavior.transform, d3.zoomIdentity); };
  document.getElementById('ge-detail-close').onclick = function() { detail.classList.remove('open'); };

  window.addEventListener('resize', function() {
    resize();
    if (svgSel) {
      svgSel.attr('width', W).attr('height', H);
      svgSel.select('#clip rect').attr('width', W).attr('height', H);
      if (simulation) { simulation.force('center', d3.forceCenter(W/2, H/2)); simulation.alpha(0.3).restart(); }
    }
  });
})();
</script>
