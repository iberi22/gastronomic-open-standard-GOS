---
// GraphExplorer — sigma.js/WebGL, estilo "paper & ink".
// Referencia de estilo: aicodingdictionary.com (three.js + d3-force monocromo).
// Aquí: 2 tonos (papel + tinta), cero bordes, jerarquía por grado (tamaño+opacidad),
// tipografía mono, etiquetas con halo, layout re-encuadrado al aspecto del viewport.
// Datos: /graph-data.json (posiciones FA2 precomputadas en build).
// NOTA: <style is:global> a propósito — los controles (filtros, resultados, ficha)
// se construyen por JS y el scope de Astro no alcanza nodos creados en runtime.
---

<style is:global>
  /* ============ 2 tonos: papel + tinta ============ */
  .ge-wrapper {
    --g-paper: #eaeae8;
    --g-ink: #171717;
    --g-rgb: 23, 23, 23;
    --g-edge-a: 0.26;
    --g-hair: color-mix(in srgb, var(--g-ink) 16%, transparent);
    --g-hair-soft: color-mix(in srgb, var(--g-ink) 9%, transparent);
    --g-faint: color-mix(in srgb, var(--g-ink) 60%, transparent);
    --g-muted: color-mix(in srgb, var(--g-ink) 76%, transparent);
    --g-sheet: color-mix(in srgb, var(--g-ink) 4%, var(--g-paper));
    --g-hover: color-mix(in srgb, var(--g-ink) 6%, transparent);
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    height: clamp(480px, 80vh, 860px);
    background: var(--g-paper);
    overflow: hidden;
    font-family: var(--swal-font-mono, monospace);
    color: var(--g-ink);
    isolation: isolate;
  }
  [data-theme="antigravity"] .ge-wrapper {
    --g-paper: #0b0b0c;
    --g-ink: #dededa;
    --g-rgb: 222, 222, 218;
    --g-edge-a: 0.2;
  }
  .ge-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='0.05'/></svg>");
  }
  [data-theme="antigravity"] .ge-grain { mix-blend-mode: screen; opacity: 0.35; }

  /* ============ chrome mínimo (sin bordes) ============ */
  .ge-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    padding: 20px 26px 40px;
    display: flex;
    flex-direction: column;
    gap: 13px;
    background: linear-gradient(to bottom, var(--g-paper) 0%, color-mix(in srgb, var(--g-paper) 82%, transparent) 55%, transparent 100%);
    pointer-events: none;
  }
  /* solo los controles reciben eventos: el resto de la franja deja pasar el grafo */
  .ge-search { pointer-events: auto; }
  .ge-filter-btn { pointer-events: auto; }
  .ge-row-top { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; }
  .ge-search { position: relative; flex: 0 1 290px; min-width: 170px; display: flex; align-items: center; gap: 9px; }
  .ge-search-icon { width: 15px; height: 15px; flex: none; color: var(--g-faint); }
  .ge-search input {
    width: 100%;
    background: none;
    border: 0;
    outline: none;
    padding: 3px 0;
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--g-ink);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }
  .ge-search input::placeholder { color: var(--g-faint); }
  .ge-search input:focus { border-bottom-color: var(--g-hair); }
  .ge-search-results {
    position: absolute;
    top: calc(100% + 10px);
    left: -12px;
    right: -12px;
    background: var(--g-paper);
    border: 1px solid var(--g-hair-soft);
    border-radius: 10px;
    max-height: 288px;
    overflow-y: auto;
    display: none;
    z-index: 30;
    box-shadow: 0 20px 44px color-mix(in srgb, var(--g-ink) 12%, transparent);
  }
  .ge-search-results.active { display: block; }
  .ge-search-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 13px;
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--g-muted);
    cursor: pointer;
    border-bottom: 1px solid var(--g-hair-soft);
    transition: background 0.18s ease, color 0.18s ease;
  }
  .ge-search-item:last-child { border-bottom: 0; }
  .ge-search-item:hover { background: var(--g-hover); color: var(--g-ink); }
  .ge-search-item .t { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ge-search-item .sub { font-size: 9px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--g-faint); }
  .ge-search-empty { padding: 11px 13px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--g-faint); }

  .ge-filters { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; }
  .ge-filter-btn {
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--g-faint);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .ge-filter-btn .n { color: color-mix(in srgb, var(--g-ink) 36%, transparent); margin-left: 7px; letter-spacing: 0.06em; }
  .ge-filter-btn:hover { color: var(--g-muted); }
  .ge-filter-btn.on { color: var(--g-ink); }
  .ge-filter-btn.on .n { color: var(--g-faint); }

  /* ============ lienzo ============ */
  .ge-canvas { position: absolute; inset: 0; z-index: 1; }
  /* velo inferior: mantiene legibles stats y controles sobre el grafo */
  .ge-bottom-veil {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 112px;
    z-index: 11;
    pointer-events: none;
    background: linear-gradient(to top, var(--g-paper) 0%, color-mix(in srgb, var(--g-paper) 88%, transparent) 45%, transparent 100%);
  }
  .ge-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--g-faint);
  }
  .ge-loader { width: 140px; height: 1px; background: var(--g-hair-soft); overflow: hidden; }
  .ge-loader i { display: block; width: 40%; height: 100%; background: var(--g-ink); animation: ge-sweep 1.4s ease-in-out infinite; }
  @keyframes ge-sweep { 0% { transform: translateX(-110%); } 100% { transform: translateX(320%); } }

  /* ============ controles flotantes ============ */
  .ge-zooms { position: absolute; right: 24px; bottom: 22px; z-index: 12; display: flex; gap: 16px; align-items: center; }
  .ge-zoom-btn {
    background: none;
    border: 0;
    padding: 2px;
    width: 26px;
    height: 26px;
    font-family: inherit;
    font-size: 15px;
    line-height: 1;
    color: var(--g-muted);
    cursor: pointer;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .ge-zoom-btn:hover { color: var(--g-ink); }
  .ge-zoom-btn:active { transform: scale(0.9); }

  .ge-bottom {
    position: absolute;
    left: 26px;
    bottom: 20px;
    z-index: 12;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--g-faint);
    pointer-events: none;
  }
  .ge-stats { display: flex; gap: 16px; }
  .ge-stats .s { color: var(--g-muted); }
  .ge-hint { color: color-mix(in srgb, var(--g-ink) 52%, transparent); }

  .ge-hl-chip {
    position: absolute;
    top: 100px;
    left: 26px;
    z-index: 14;
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--g-muted);
    cursor: pointer;
    max-width: 62%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: left;
    transition: color 0.2s ease;
  }
  .ge-hl-chip:hover { color: var(--g-ink); }
  .ge-hl-chip[hidden] { display: none; }

  /* ============ ficha (hoja sin bordes) ============ */
  .ge-detail {
    position: absolute;
    top: 0;
    right: 0;
    width: 360px;
    height: 100%;
    background: var(--g-sheet);
    backdrop-filter: blur(16px);
    transform: translateX(101%);
    transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 15;
    overflow-y: auto;
    box-shadow: -1px 0 0 var(--g-hair-soft);
  }
  .ge-detail.open { transform: translateX(0); }
  .ge-detail-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; padding: 22px 24px 12px; }
  .ge-detail-type { font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--g-faint); }
  .ge-detail-close {
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    font-size: 13px;
    line-height: 1;
    color: var(--g-faint);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .ge-detail-close:hover { color: var(--g-ink); }
  .ge-detail-title { padding: 0 24px 16px; font-size: 19px; font-weight: 500; line-height: 1.25; letter-spacing: -0.01em; color: var(--g-ink); }
  .ge-detail-body { padding: 0 24px 28px; }

  .ge-rows { display: flex; flex-direction: column; border-top: 1px solid var(--g-hair-soft); }
  .ge-row { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 9px 0; border-bottom: 1px solid var(--g-hair-soft); }
  .ge-row .k { font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--g-faint); }
  .ge-row .v { font-size: 12px; letter-spacing: 0.02em; color: var(--g-ink); text-align: right; }

  .ge-section-title { margin: 22px 0 9px; font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--g-faint); }
  .ge-prose { font-family: var(--swal-font, sans-serif); font-size: 12.5px; line-height: 1.65; color: var(--g-muted); }
  .ge-tag-list { display: flex; flex-wrap: wrap; gap: 5px; }
  .ge-tag {
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--g-muted);
    background: color-mix(in srgb, var(--g-ink) 5%, transparent);
    border-radius: 3px;
    padding: 3px 7px;
  }
  a.ge-tag { text-decoration: none; transition: color 0.2s ease, background 0.2s ease; }
  a.ge-tag:hover { color: var(--g-ink); background: color-mix(in srgb, var(--g-ink) 10%, transparent); }

  .ge-ficha-btn {
    display: inline-block;
    margin-bottom: 4px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--g-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--g-hair);
    padding-bottom: 2px;
    transition: border-color 0.2s ease;
  }
  .ge-ficha-btn:hover { border-color: var(--g-ink); }

  .ge-conn-group { margin-top: 18px; }
  .ge-conn-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--g-faint); margin-bottom: 7px; }
  .ge-conn-items { display: flex; flex-direction: column; }
  .ge-conn-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 8px;
    margin: 0 -8px;
    font-size: 11.5px;
    color: var(--g-muted);
    cursor: pointer;
    border-radius: 4px;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .ge-conn-item:hover { background: var(--g-hover); color: var(--g-ink); }
  .ge-conn-item .cn { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ge-conn-item .ct { font-size: 8.5px; text-transform: uppercase; letter-spacing: 0.12em; color: color-mix(in srgb, var(--g-ink) 55%, transparent); }
  .ge-conn-item.more { color: var(--g-faint); cursor: default; justify-content: flex-start; }
  .ge-conn-item.more:hover { background: none; color: var(--g-faint); }

  @media (max-width: 680px) {
    .ge-top { padding: 15px 16px 34px; gap: 11px; }
    .ge-search { flex: 1 1 100%; }
    .ge-filters { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 3px; scrollbar-width: none; -webkit-mask-image: linear-gradient(to right, #000 88%, transparent); mask-image: linear-gradient(to right, #000 88%, transparent); }
    .ge-filters::-webkit-scrollbar { display: none; }
    .ge-filter-btn { white-space: nowrap; }
    .ge-hl-chip { top: 96px; left: 16px; }
    .ge-detail { width: 100%; }
    .ge-detail-header { padding: 18px 16px 10px; }
    .ge-detail-title { padding: 0 16px 14px; font-size: 17px; }
    .ge-detail-body { padding: 0 16px 24px; }
    .ge-bottom { left: 16px; bottom: 16px; }
    .ge-zooms { right: 14px; bottom: 16px; }
    .ge-hint { display: none; }
  }
</style>

<div class="ge-wrapper" id="ge-wrapper">
  <div class="ge-grain" aria-hidden="true"></div>

  <div class="ge-top">
    <div class="ge-row-top">
      <div class="ge-search">
        <svg class="ge-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
        <input type="text" id="ge-search-input" aria-label="Buscar en el grafo" placeholder="Buscar en el grafo…" autocomplete="off" />
        <div class="ge-search-results" id="ge-search-results"></div>
      </div>
      <div class="ge-filters" id="ge-filters"></div>
    </div>
  </div>

  <div class="ge-canvas" id="ge-canvas">
    <div class="ge-loading" id="ge-loading"><div class="ge-loader"><i></i></div><span>Cargando grafo…</span></div>
  </div>

  <button class="ge-hl-chip" id="ge-hl-chip" hidden></button>
  <div class="ge-bottom-veil" aria-hidden="true"></div>

  <div class="ge-detail" id="ge-detail">
    <div class="ge-detail-header">
      <div class="ge-detail-type" id="ge-detail-type">NODO</div>
      <button class="ge-detail-close" id="ge-detail-close" aria-label="Cerrar detalle">✕</button>
    </div>
    <div class="ge-detail-title" id="ge-detail-title">—</div>
    <div class="ge-detail-body" id="ge-detail-body"></div>
  </div>

  <div class="ge-bottom">
    <div class="ge-stats">
      <span>Visibles <span class="s" id="ge-visible-count">0</span></span>
      <span>Nodos <span class="s" id="ge-node-count">0</span></span>
      <span>Aristas <span class="s" id="ge-edge-count">0</span></span>
      <span>Recetas <span class="s" id="ge-recipe-count">0</span></span>
    </div>
    <div class="ge-hint">Arrastra para mover · rueda para acercar · clic en un nodo · los tipos de arriba encienden o apagan capas</div>
  </div>
  <div class="ge-zooms">
    <button class="ge-zoom-btn" id="ge-zoom-in" aria-label="Acercar">+</button>
    <button class="ge-zoom-btn" id="ge-zoom-out" aria-label="Alejar">−</button>
    <button class="ge-zoom-btn" id="ge-zoom-reset" aria-label="Restablecer vista">↺</button>
  </div>
</div>

<script>
// @ts-nocheck — explorer vanilla (sigma/graphology). Paper & ink: 2 tonos,
// jerarquía por grado (tamaño + opacidad), aristas hairline, etiquetas mono con
// halo solo en nodos importantes, cero física en cliente (FA2 precomputado).
// El layout se re-encuadra al aspecto real del contenedor (sin bandas vacías).
import Sigma from 'sigma';
import Graph from 'graphology';
(function() {
  var TYPE_LABELS = {
    recipe: 'Recetas', ingredient: 'Ingredientes', substance: 'Substancias', condition: 'Afecciones',
    diet: 'Dietas', flavor: 'Sabores', texture: 'Texturas', aroma: 'Aromas',
    region: 'Regiones', category: 'Categorías', place: 'Lugares', technique: 'Técnicas',
    vitamin: 'Vitaminas', nutrient: 'Nutrientes'
  };
  var TYPE_ORDER = ['recipe','ingredient','vitamin','nutrient','substance','condition','diet','flavor','texture','aroma','region','category','place','technique'];
  var ETYPE_LABELS = {
    HAS_RECIPE: 'Recetas', USES: 'Ingredientes', USES_INGREDIENT: 'Ingredientes', BELONGS_TO: 'Categoría',
    HAS_FLAVOR: 'Sabores', HAS_TEXTURE: 'Texturas', HAS_AROMA: 'Aromas', HAS_MACRO: 'Nutrición',
    FROM_REGION: 'Región', RELATED_DISHES: 'Platos relacionados', PLACE: 'Lugares', USES_TECHNIQUE: 'Técnicas',
    OFTEN_TOGETHER: 'Suelen ir juntos', HELPS_CONDITION: 'Ayuda contra', TREATS: 'Trata',
    HAS_SUBSTANCE: 'Substancias', CONTAINS_VITAMIN: 'Vitaminas',
    HAS_NUTRIENT: 'Nutrientes', FOUND_IN: 'Presente en', SUBSTITUTE_FOR: 'Sustitutos'
  };
  // Tipos densos arrancan apagados: 3.6k nodos juntos = bola de pelo ilegible.
  var OFF_BY_DEFAULT = ['ingredient', 'flavor', 'texture'];
  var FIT_PADDING = 0.955;   // margen del encuadre
  var MAX_STRETCH = 3.4;     // límite de estiramiento del layout para llenar el viewport

  var wrapper = document.getElementById('ge-wrapper');
  var canvas = document.getElementById('ge-canvas');
  var loading = document.getElementById('ge-loading');
  var detail = document.getElementById('ge-detail');
  var detailBody = document.getElementById('ge-detail-body');
  var detailTitle = document.getElementById('ge-detail-title');
  var detailType = document.getElementById('ge-detail-type');
  var searchInput = document.getElementById('ge-search-input');
  var searchResults = document.getElementById('ge-search-results');
  var filtersEl = document.getElementById('ge-filters');
  var nodeCountEl = document.getElementById('ge-node-count');
  var edgeCountEl = document.getElementById('ge-edge-count');
  var recipeCountEl = document.getElementById('ge-recipe-count');
  var visibleCountEl = document.getElementById('ge-visible-count');
  var hlChip = document.getElementById('ge-hl-chip');

  var graphData = null;
  var graph = null;
  var renderer = null;
  var degrees = {};
  var maxDeg = 1;
  var rawPos = {};           // id -> { x0, y0 } tal como salen de build (FA2)
  var activeTypes = new Set(Object.keys(TYPE_LABELS));
  OFF_BY_DEFAULT.forEach(function(t) { activeTypes.delete(t); });
  var highlightedNodeId = null;
  var fitState = { x: 0.5, y: 0.5, angle: 0, ratio: 1 };

  var baseUrl = (document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/').replace(/\/$/, '');
  var candidates = [baseUrl + '/graph-data.json', '/graph-data.json', './graph-data.json', 'graph-data.json'];

  function cssVar(name) { return getComputedStyle(wrapper).getPropertyValue(name).trim(); }
  function inkRgb() { return cssVar('--g-rgb') || '23,23,23'; }
  function rgba(a) { return 'rgba(' + inkRgb() + ',' + a + ')'; }
  function edgeAlpha() { return parseFloat(cssVar('--g-edge-a')) || 0.24; }

  // sangrado exacto al ancho del cliente (sin el hueco de la barra de scroll).
  // Se mide la propia caja: robusto a cualquier contenedor y a shifts del layout.
  function applyBleed() {
    var vw = document.documentElement.clientWidth;
    if (!vw || !wrapper.isConnected) return;
    var rect = wrapper.getBoundingClientRect();
    var ml = parseFloat(getComputedStyle(wrapper).marginLeft) || 0;
    wrapper.style.width = vw + 'px';
    wrapper.style.marginLeft = (ml - rect.left) + 'px';
    wrapper.style.marginRight = '0px';
  }
  applyBleed();

  function loadData(index) {
    if (index >= candidates.length) { loading.innerHTML = '<span>Sin datos del grafo</span>'; return; }
    fetch(candidates[index]).then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    }).then(onDataLoaded).catch(function() { loadData(index + 1); });
  }
  loadData(0);

  // jerarquía: grado → tamaño y opacidad (hubs oscuros y grandes, como la referencia)
  function importance(id) { return Math.sqrt(degrees[id] || 0) / Math.sqrt(maxDeg || 1); }
  function nodeSize(id) { return 2 + 7.5 * importance(id); }
  function nodeAlpha(id) { return 0.22 + 0.64 * importance(id); }
  function labelAlpha(id) { return 0.52 + 0.38 * importance(id); }

  function onDataLoaded(data) {
    graphData = data;
    degrees = {};
    maxDeg = 1;
    data.edges.forEach(function(e) {
      degrees[e.source] = (degrees[e.source] || 0) + 1;
      degrees[e.target] = (degrees[e.target] || 0) + 1;
    });
    data.nodes.forEach(function(n) {
      rawPos[n.id] = { x0: typeof n.x === 'number' ? n.x : 0.5, y0: typeof n.y === 'number' ? n.y : 0.5 };
      if ((degrees[n.id] || 0) > maxDeg) maxDeg = degrees[n.id];
    });
    nodeCountEl.textContent = data.nodes.length.toLocaleString('es');
    edgeCountEl.textContent = data.edges.length.toLocaleString('es');
    recipeCountEl.textContent = data.nodes.filter(function(n) { return n.type === 'recipe'; }).length.toLocaleString('es');
    visibleCountEl.textContent = data.nodes.filter(function(n) { return activeTypes.has(n.type); }).length.toLocaleString('es');
    buildFilters(data.nodes);
    applyBleed();
    initSigma();
    var params = new URLSearchParams(window.location.search);
    var targetNode = params.get('node');
    var filterQuery = params.get('filter');
    if (targetNode) setTimeout(function() { focusAndShowNode(targetNode); }, 900);
    else if (filterQuery) {
      var parts = filterQuery.split(':');
      if (parts.length === 2) {
        var fVal = parts[1].toLowerCase();
        var match = data.nodes.find(function(n) {
          return n.type === parts[0] && (n.id.toLowerCase().includes(fVal) || (n.label && n.label.toLowerCase().includes(fVal)));
        });
        if (match) setTimeout(function() { focusAndShowNode(match.id); }, 900);
      }
    }
  }

  function buildFilters(nodes) {
    var counts = {};
    nodes.forEach(function(n) { counts[n.type] = (counts[n.type] || 0) + 1; });
    filtersEl.innerHTML = '';
    TYPE_ORDER.forEach(function(t) {
      if (!counts[t]) return;
      var btn = document.createElement('button');
      btn.className = 'ge-filter-btn' + (activeTypes.has(t) ? ' on' : '');
      btn.dataset.type = t;
      btn.appendChild(document.createTextNode(TYPE_LABELS[t] || t));
      var n = document.createElement('span');
      n.className = 'n';
      n.textContent = counts[t].toLocaleString('es');
      btn.appendChild(n);
      btn.onclick = function() { toggleType(t, btn); };
      filtersEl.appendChild(btn);
    });
  }

  function toggleType(t, btn) {
    if (activeTypes.has(t)) { activeTypes.delete(t); btn.classList.remove('on'); }
    else { activeTypes.add(t); btn.classList.add('on'); }
    applyFilters();
  }

  function applyFilters() {
    if (!graph || !renderer || !graphData) return;
    var visible = {};
    graph.forEachNode(function(id, attrs) {
      var show = activeTypes.has(attrs.ntype);
      graph.setNodeAttribute(id, 'hidden', !show);
      if (show) visible[id] = true;
    });
    graph.forEachEdge(function(id, attrs, source, target) {
      graph.setEdgeAttribute(id, 'hidden', !(visible[source] && visible[target]));
    });
    if (visibleCountEl) visibleCountEl.textContent = Object.keys(visible).length.toLocaleString('es');
    resetHighlight();
    fitLayout();          // re-encuadra sobre la capa visible
    renderer.refresh();
  }

  /* ---- encuadre: estira el layout al aspecto del contenedor y lo lleva a
     unidades tipo-píxel (así sigma con autoRescale:false lo encaja exacto).
     Los nodos ocultos se aparcan en el centro: no se ven y no deforman la
     extensión que sigma usa para normalizar. ---- */
  function fitLayout() {
    if (!graph) return;
    var W = canvas.clientWidth || wrapper.clientWidth;
    var H = canvas.clientHeight || wrapper.clientHeight;
    if (!W || !H) return;
    var minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    var any = false;
    var xs = [], ys = [];
    graph.forEachNode(function(id, attrs) {
      if (attrs.hidden) return;
      var p = rawPos[id];
      if (!p) return;
      any = true;
      xs.push(p.x0); ys.push(p.y0);
    });
    if (!any) return;
    // extensión robusta: recorta el 1% extremo por lado para que un puñado de
    // outliers no encoja el encuadre (los outliers quedan al borde, como en la referencia)
    xs.sort(function(a, b) { return a - b; });
    ys.sort(function(a, b) { return a - b; });
    var trim = Math.floor(xs.length * 0.01);
    minX = xs[trim]; maxX = xs[xs.length - 1 - trim];
    minY = ys[trim]; maxY = ys[ys.length - 1 - trim];
    var gw0 = Math.max(maxX - minX, 1e-6);
    var gh0 = Math.max(maxY - minY, 1e-6);
    var targetAspect = W / H;
    var ga = gw0 / gh0;
    var sx = 1, sy = 1;
    if (ga < targetAspect) sx = Math.min(targetAspect / ga, MAX_STRETCH);
    else sy = Math.min(ga / targetAspect, MAX_STRETCH);
    var gw = gw0 * sx, gh = gh0 * sy;
    // caja = FIT_PADDING del contenedor, en unidades tipo-píxel
    var k = (FIT_PADDING * W) / gw;
    var boxW = gw * k, boxH = gh * k;
    var ox = (W - boxW) / 2, oy = (H - boxH) / 2;
    graph.forEachNode(function(id, attrs) {
      var p = rawPos[id];
      if (!p) return;
      if (attrs.hidden) { graph.setNodeAttribute(id, 'x', W / 2); graph.setNodeAttribute(id, 'y', H / 2); return; }
      // los outliers se anclan al borde de la caja: siguen visibles y clicables
      var nx = (p.x0 - minX) * sx * k + ox;
      var ny = (p.y0 - minY) * sy * k + oy;
      graph.setNodeAttribute(id, 'x', Math.min(Math.max(nx, ox + 10), ox + boxW - 10));
      graph.setNodeAttribute(id, 'y', Math.min(Math.max(ny, oy + 10), oy + boxH - 10));
    });
  }

  /* ---- etiquetas mono con halo del color del papel + anti-colisión por frame ---- */
  var labelBoxes = [];
  function drawHaloLabel(context, data, settings) {
    if (!data.label) return;
    var size = settings.labelSize;
    var weight = settings.labelWeight;
    var color = settings.labelColor.attribute
      ? (data[settings.labelColor.attribute] || settings.labelColor.color || '#000')
      : settings.labelColor.color;
    context.font = weight + ' ' + size + 'px ' + settings.labelFont;
    context.textAlign = 'center';
    context.textBaseline = 'top';
    var x = data.x;
    var y = data.y + (data.size || 0) + 4;
    // anti-colisión: si la caja del texto pisa otra etiqueta ya dibujada, se omite
    var w = context.measureText(data.label).width;
    var box = { x0: x - w / 2 - 3, x1: x + w / 2 + 3, y0: y - 2, y1: y + size + 3 };
    for (var i = 0; i < labelBoxes.length; i++) {
      var b = labelBoxes[i];
      if (box.x1 > b.x0 && box.x0 < b.x1 && box.y1 > b.y0 && box.y0 < b.y1) return;
    }
    labelBoxes.push(box);
    context.lineJoin = 'round';
    context.lineWidth = 3.5;
    context.strokeStyle = cssVar('--g-paper');
    context.strokeText(data.label, x, y);
    context.fillStyle = color;
    context.fillText(data.label, x, y);
  }

  /* ---- hover minimalista: anillo fino, sin caja de etiqueta ---- */
  function drawRingHover(context, data) {
    context.beginPath();
    context.arc(data.x, data.y, (data.size || 3) + 2.5, 0, Math.PI * 2);
    context.strokeStyle = rgba(0.55);
    context.lineWidth = 1;
    context.stroke();
  }

  function initSigma() {
    graph = new Graph({ multi: true });
    graphData.nodes.forEach(function(n) {
      graph.addNode(n.id, {
        label: (n.label || n.id).toUpperCase(),
        size: nodeSize(n.id),
        color: rgba(nodeAlpha(n.id)),
        lcolor: rgba(labelAlpha(n.id)),
        x: rawPos[n.id] ? rawPos[n.id].x0 : 0.5,
        y: rawPos[n.id] ? rawPos[n.id].y0 : 0.5,
        ntype: n.type,
        hidden: !activeTypes.has(n.type),
      });
    });
    graphData.edges.forEach(function(e, idx) {
      if (!graph.hasNode(e.source) || !graph.hasNode(e.target)) return;
      var key = (e.id ? e.id + '-' + idx : e.source + '-' + e.target + '-' + idx);
      try {
        graph.addEdgeWithKey(key, e.source, e.target, {
          color: rgba(edgeAlpha()),
          size: 0.5,
          hidden: !(activeTypes.has(graph.getNodeAttribute(e.source, 'ntype')) && activeTypes.has(graph.getNodeAttribute(e.target, 'ntype'))),
        });
      } catch (err) {}
    });

    if (renderer) renderer.kill();
    renderer = new Sigma(graph, canvas, {
      autoRescale: false,          // el encuadre lo controla fitLayout()
      defaultEdgeColor: rgba(edgeAlpha()),
      defaultEdgeType: 'line',
      defaultNodeColor: rgba(0.4),
      labelFont: "'Geist Mono', ui-monospace, monospace",
      labelSize: 10,
      labelWeight: '500',
      labelColor: { attribute: 'lcolor', color: rgba(0.4) },
      labelDensity: 0.75,
      labelGridCellSize: 100,
      labelRenderedSizeThreshold: 5.7,
      defaultDrawNodeLabel: drawHaloLabel,
      defaultDrawNodeHover: drawRingHover,
      renderEdgeLabels: false,
      minEdgeThickness: 1,
      // fluidez: inercia al arrastrar, zoom amortiguado, sin rotación accidental
      inertiaDuration: 520,
      inertiaRatio: 4,
      zoomDuration: 460,
      zoomingRatio: 1.35,
      doubleClickZoomingDuration: 560,
      doubleClickZoomingRatio: 2,
      hideLabelsOnMove: true,
      enableCameraRotation: false,
      minCameraRatio: 0.02,
      maxCameraRatio: 6,
    });
    fitLayout();
    fitState = { x: 0.5, y: 0.5, angle: 0, ratio: 1 };
    // entrada suave: arranca algo alejado y se asienta
    renderer.getCamera().setState({ x: 0.5, y: 0.5, angle: 0, ratio: 1.55 });
    renderer.getCamera().animate(fitState, { duration: 1100, easing: 'quadraticOut' });

    loading.style.display = 'none';
    window.__ge = { renderer: renderer, graph: graph };  // sonda de verificación

    renderer.on('clickNode', function(params) {
      highlightNeighborhood(params.node);
      showDetailById(params.node);
    });
    // reinicia el registro de colisiones de etiquetas en cada frame
    renderer.on('beforeRender', function() { labelBoxes.length = 0; });
    renderer.on('clickStage', function() {
      resetHighlight();
      detail.classList.remove('open');
    });
    renderer.on('enterNode', function(params) {
      if (!highlightedNodeId) highlightNeighborhood(params.node);
    });
    renderer.on('leaveNode', function() {
      if (!highlightedNodeId) resetHighlight();
    });

    // hook de verificación (e2e / debug): bbox real en pantalla vs ventana visible,
    // ambos en el espacio normalizado de sigma (medición empírica, sin teoría).
    window.__geDebug = function() {
      var c = renderer.getCamera().getState();
      var ext = graphExtent();
      var W = canvas.clientWidth || 1, H = canvas.clientHeight || 1;
      var minDim = Math.min(W, H), maxDim = Math.max(W, H);
      var gW = Math.max(ext.maxX - ext.minX, 1e-9), gH = Math.max(ext.maxY - ext.minY, 1e-9);
      var vr = H / W, gr = gH / gW;
      var cr = ((vr < 1 && gr > 1) || (vr > 1 && gr < 1)) ? 1 : Math.min(Math.max(gr, 1 / gr), Math.max(1 / vr, vr));
      var winW = W * c.ratio / (minDim * cr), winH = H * c.ratio / (minDim * cr);
      // bbox normalizado (lo que sigma dibuja)
      var minNX = Infinity, maxNX = -Infinity, minNY = Infinity, maxNY = -Infinity;
      graph.forEachNode(function(id, a) {
        if (a.hidden) return;
        var d = renderer.getNodeDisplayData(id);
        if (!d) return;
        if (d.x < minNX) minNX = d.x; if (d.x > maxNX) maxNX = d.x;
        if (d.y < minNY) minNY = d.y; if (d.y > maxNY) maxNY = d.y;
      });
      var covX = (maxNX - minNX) / winW, covY = (maxNY - minNY) / winH;
      return {
        camera: c,
        nodes: graph.order,
        edges: graph.size,
        visible: graph.nodes().filter(function(id) { return !graph.getNodeAttribute(id, 'hidden'); }).length,
        container: { w: W, h: H },
        extent: ext,
        bbox: { minX: minNX, maxX: maxNX, minY: minNY, maxY: maxNY },
        window: { w: winW, h: winH },
        coverage: { x: covX, y: covY, fill: Math.min(covX, covY) },
      };
    };
  }

  function graphExtent() {
    var minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    graph.forEachNode(function(id, attrs) {
      if (attrs.hidden) return;
      if (attrs.x < minX) minX = attrs.x; if (attrs.x > maxX) maxX = attrs.x;
      if (attrs.y < minY) minY = attrs.y; if (attrs.y > maxY) maxY = attrs.y;
    });
    return { minX: minX, maxX: maxX, minY: minY, maxY: maxY };
  }

  /* ---- cambio de tema: repinta toda la paleta (papel ↔ tinta) ---- */
  function repaintPalette() {
    if (!graph || !renderer) return;
    graph.forEachNode(function(id, a) {
      graph.setNodeAttribute(id, 'color', rgba(nodeAlpha(id)));
      graph.setNodeAttribute(id, 'lcolor', rgba(labelAlpha(id)));
    });
    graph.forEachEdge(function(id) { graph.setEdgeAttribute(id, 'color', rgba(edgeAlpha())); });
    renderer.setSetting('defaultEdgeColor', rgba(edgeAlpha()));
    renderer.setSetting('labelColor', { attribute: 'lcolor', color: rgba(0.4) });
    resetHighlight();
    renderer.refresh();
  }
  new MutationObserver(repaintPalette).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  function highlightNeighborhood(nodeId) {
    if (!graph || !renderer) return;
    highlightedNodeId = nodeId;
    if (hlChip && graphData) {
      var hlNode = graphData.nodes.find(function(n) { return n.id === nodeId; });
      hlChip.textContent = 'Resaltando ' + ((hlNode && (hlNode.label || hlNode.id)) || nodeId) + ' — limpiar';
      hlChip.hidden = false;
    }
    var keep = {};
    keep[nodeId] = true;
    graph.neighbors(nodeId).forEach(function(n) { keep[n] = true; });
    var keepEdges = {};
    graph.edges(nodeId).forEach(function(e) { keepEdges[e] = true; });

    renderer.setSetting('nodeReducer', function(node, data) {
      var res = Object.assign({}, data);
      if (!keep[node]) {
        res.color = rgba(0.05);
        res.label = '';
      } else if (node === nodeId) {
        res.color = rgba(0.94);
        res.size = Math.max(data.size, 8);
        res.labelColor = rgba(0.95);
      } else {
        res.color = rgba(0.82);
        res.size = Math.max(data.size, 6.3);
        res.labelColor = rgba(0.88);
      }
      return res;
    });
    renderer.setSetting('edgeReducer', function(edge, data) {
      var res = Object.assign({}, data);
      if (!keepEdges[edge]) { res.hidden = true; }
      else { res.color = rgba(0.55); res.size = 1.2; res.hidden = false; }
      return res;
    });
    renderer.refresh();
  }

  function resetHighlight() {
    if (!renderer) return;
    highlightedNodeId = null;
    if (hlChip) hlChip.hidden = true;
    renderer.setSetting('nodeReducer', null);
    renderer.setSetting('edgeReducer', null);
    renderer.refresh();
  }

  function focusAndShowNode(id) {
    if (!graphData || !renderer || !graph || !graph.hasNode(id)) return;
    highlightedNodeId = id;
    var t = graph.getNodeAttribute(id, 'ntype');
    if (t && !activeTypes.has(t)) {
      activeTypes.add(t);
      var btn = filtersEl.querySelector('[data-type="' + t + '"]');
      if (btn) btn.classList.add('on');
      applyFilters();
    }
    highlightNeighborhood(id);
    showDetailById(id);
    var attrs = graph.getNodeAttributes(id);
    renderer.getCamera().animate({ x: attrs.x, y: attrs.y, ratio: 0.22 }, { duration: 900, easing: 'quadraticOut' });
  }
  window.focusNode = function(id) {
    searchResults.classList.remove('active');
    searchInput.value = '';
    focusAndShowNode(id);
  };

  function showDetailById(nodeId) {
    var rawNode = graphData.nodes.find(function(n) { return n.id === nodeId; });
    if (!rawNode) return;
    showDetail(rawNode);
  }

  function showDetail(node) {
    detailTitle.textContent = node.label || node.id;
    detailType.textContent = (TYPE_LABELS[node.type] || node.type || 'nodo').toUpperCase();

    var fichaUrl = null;
    var fichaLabel = 'Ver ficha completa →';
    if (node.type === 'recipe' && node.slug) fichaUrl = baseUrl + '/recipes/' + node.slug;
    else if (node.type === 'substance') { fichaUrl = baseUrl + '/substances'; fichaLabel = 'Catálogo de substancias →'; }
    else if (node.type === 'ingredient') { fichaUrl = baseUrl + '/ingredients'; fichaLabel = 'Catálogo de ingredientes →'; }

    var conns = {};
    var connTotal = 0;
    var nodeIndex = {};
    graphData.nodes.forEach(function(n) { nodeIndex[n.id] = n; });
    graphData.edges.forEach(function(e) {
      if (e.source !== node.id && e.target !== node.id) return;
      connTotal++;
      var other = e.source === node.id ? e.target : e.source;
      if (!conns[e.type]) conns[e.type] = [];
      if (nodeIndex[other]) conns[e.type].push(nodeIndex[other]);
    });

    var rows = '';
    if (node.region) rows += '<div class="ge-row"><span class="k">Región</span><span class="v">' + node.region + '</span></div>';
    if (node.difficulty) rows += '<div class="ge-row"><span class="k">Dificultad</span><span class="v">' + node.difficulty + '</span></div>';
    if (node.prep_time) rows += '<div class="ge-row"><span class="k">Preparación</span><span class="v">' + node.prep_time + '</span></div>';
    if (node.cook_time) rows += '<div class="ge-row"><span class="k">Cocción</span><span class="v">' + node.cook_time + '</span></div>';
    rows += '<div class="ge-row"><span class="k">Conexiones</span><span class="v">' + connTotal.toLocaleString('es') + '</span></div>';

    var html = '';
    if (fichaUrl) html += '<a href="' + fichaUrl + '" class="ge-ficha-btn">' + fichaLabel + '</a>';
    html += '<div class="ge-rows" style="margin-top:14px">' + rows + '</div>';

    if (node.active_compounds && node.active_compounds.length) {
      html += '<div class="ge-section-title">Compuestos activos</div><div class="ge-tag-list">';
      node.active_compounds.forEach(function(c) { html += '<span class="ge-tag">' + c + '</span>'; });
      html += '</div>';
    }
    if (node.mechanism) html += '<div class="ge-section-title">Mecanismo de acción</div><div class="ge-prose">' + node.mechanism + '</div>';
    if (node.studies && node.studies.length) {
      html += '<div class="ge-section-title">Estudios / PubMed</div><div class="ge-tag-list">';
      node.studies.forEach(function(s) {
        html += '<a href="' + (s.url || '#') + '" target="_blank" rel="noopener" class="ge-tag">' + (s.title || s.id || 'Estudio') + '</a>';
      });
      html += '</div>';
    }
    if (node.tags && node.tags.length) {
      html += '<div class="ge-section-title">Etiquetas</div><div class="ge-tag-list">';
      node.tags.forEach(function(t) { html += '<span class="ge-tag">' + t + '</span>'; });
      html += '</div>';
    }
    if (node.categories && node.categories.length) {
      html += '<div class="ge-section-title">Categorías</div><div class="ge-tag-list">';
      node.categories.forEach(function(c) { html += '<span class="ge-tag">' + c + '</span>'; });
      html += '</div>';
    }

    Object.keys(conns).sort().forEach(function(type) {
      var items = conns[type];
      if (!items || !items.length) return;
      html += '<div class="ge-conn-group">';
      html += '<div class="ge-conn-label">' + (ETYPE_LABELS[type] || type) + ' · ' + items.length + '</div>';
      html += '<div class="ge-conn-items">';
      items.slice(0, 25).forEach(function(other) {
        html += '<div class="ge-conn-item" onclick="window.focusNode(\'' + other.id + '\')">';
        html += '<span class="cn">' + (other.label || other.id) + '</span>';
        html += '<span class="ct">' + (TYPE_LABELS[other.type] || other.type || '') + '</span>';
        html += '</div>';
      });
      if (items.length > 25) html += '<div class="ge-conn-item more">+' + (items.length - 25) + ' más</div>';
      html += '</div></div>';
    });

    detailBody.innerHTML = html;
    detail.classList.add('open');
  }

  searchInput.addEventListener('input', function(e) {
    var q = e.target.value.toLowerCase().trim();
    searchResults.classList.remove('active');
    if (q.length < 2 || !graphData) return;
    var results = graphData.nodes.filter(function(n) { return (n.label || n.id).toLowerCase().includes(q); }).slice(0, 12);
    if (!results.length) {
      searchResults.innerHTML = '<div class="ge-search-empty">Sin resultados</div>';
      searchResults.classList.add('active');
      return;
    }
    searchResults.innerHTML = results.map(function(n) {
      return '<div class="ge-search-item" onclick="window.focusNode(\'' + n.id + '\')">' +
        '<span class="t">' + (n.label || n.id) + '</span>' +
        '<span class="sub">' + (TYPE_LABELS[n.type] || n.type) + '</span></div>';
    }).join('');
    searchResults.classList.add('active');
  });
  searchInput.addEventListener('blur', function() { setTimeout(function() { searchResults.classList.remove('active'); }, 160); });

  document.getElementById('ge-zoom-in').onclick = function() { if (renderer) renderer.getCamera().animatedZoom({ duration: 420 }); };
  document.getElementById('ge-zoom-out').onclick = function() { if (renderer) renderer.getCamera().animatedUnzoom({ duration: 420 }); };
  document.getElementById('ge-zoom-reset').onclick = function() { if (renderer) renderer.getCamera().animate(fitState, { duration: 700, easing: 'quadraticOut' }); };
  if (hlChip) hlChip.onclick = function() { resetHighlight(); };
  document.getElementById('ge-detail-close').onclick = function() {
    detail.classList.remove('open');
    resetHighlight();
  };

  var resizeTimer = null;
  function scheduleResize() {
    if (!renderer) return;
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() { applyBleed(); fitLayout(); renderer.refresh(); }, 160);
  }
  window.addEventListener('resize', scheduleResize);
  if (window.ResizeObserver) {
    // el contenedor puede cambiar de tamaño sin evento de window (móvil, zoom de UI)
    new ResizeObserver(scheduleResize).observe(wrapper);
  }
})();
</script>
