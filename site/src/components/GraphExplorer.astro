---
// GraphExplorer - Premium vis-network Knowledge Graph for GOS
// Data: /graph-data.json (3260 nodes, 24k edges)
---

<style>
  .ge-wrapper { width:100%; height:720px; background:#0a0a0f; position:relative; overflow:hidden; border-radius:12px; border:1px solid #1e1e2e; font-family:Inter,system-ui,sans-serif; }
  .ge-topbar { position:absolute; top:0; left:0; right:0; height:56px; background:rgba(10,10,15,0.92); backdrop-filter:blur(12px); border-bottom:1px solid #1e1e2e; display:flex; align-items:center; padding:0 16px; gap:10px; z-index:20; }
  .ge-title { font-size:12px; font-weight:700; color:#7d61ff; letter-spacing:0.08em; text-transform:uppercase; white-space:nowrap; }
  .ge-search { flex:1; max-width:320px; position:relative; }
  .ge-search input { width:100%; background:#12121a; border:1px solid #2a2a3e; border-radius:8px; color:#e0e0ff; font-size:12px; padding:7px 12px 7px 34px; outline:none; transition:border-color 0.2s; box-sizing:border-box; }
  .ge-search input:focus { border-color:#7d61ff; }
  .ge-search input::placeholder { color:#4a4a6a; }
  .ge-search-icon { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#4a4a6a; font-size:13px; }
  .ge-search-results { position:absolute; top:calc(100% + 4px); left:0; right:0; background:#12121a; border:1px solid #2a2a3e; border-radius:8px; max-height:240px; overflow-y:auto; display:none; z-index:30; }
  .ge-search-results.active { display:block; }
  .ge-search-item { padding:8px 12px; font-size:12px; color:#c0c0e0; cursor:pointer; border-bottom:1px solid #1a1a2a; display:flex; align-items:center; gap:8px; transition:background 0.15s; }
  .ge-search-item:last-child { border-bottom:none; }
  .ge-search-item:hover { background:#1e1e30; color:#fff; }
  .ge-search-item .dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .ge-search-item .t { font-weight:600; color:#fff; flex:1; }
  .ge-search-item .sub { font-size:10px; color:#666; }
  .ge-filters { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
  .ge-filter-btn { background:#12121a; border:1px solid #2a2a3e; border-radius:6px; color:#8080a0; font-size:10px; font-weight:600; padding:4px 9px; cursor:pointer; letter-spacing:0.05em; text-transform:uppercase; transition:all 0.15s; display:flex; align-items:center; gap:5px; }
  .ge-filter-btn .dot { width:7px; height:7px; border-radius:50%; }
  .ge-filter-btn.on { color:#fff; }
  .ge-filter-btn.on.recipe { color:#ff6b35; border-color:#ff6b35; }
  .ge-filter-btn.on.ingredient { color:#00ff66; border-color:#00ff66; }
  .ge-filter-btn.on.flavor { color:#ffe66d; border-color:#ffe66d; }
  .ge-filter-btn.on.texture { color:#f38181; border-color:#f38181; }
  .ge-filter-btn.on.aroma { color:#a8e6cf; border-color:#a8e6cf; }
  .ge-filter-btn.on.region { color:#7d61ff; border-color:#7d61ff; }
  .ge-filter-btn.on.nutrition { color:#f9c74f; border-color:#f9c74f; }
  .ge-filter-btn.on.category { color:#90be6d; border-color:#90be6d; }
  .ge-filter-btn.on.substance { color:#9d4edd; border-color:#9d4edd; }
  .ge-filter-btn.on.condition { color:#f94144; border-color:#f94144; }
  .ge-filter-btn.on.diet { color:#06d6a0; border-color:#06d6a0; }
  .ge-canvas { position:absolute; top:56px; left:0; right:0; bottom:0; }
  .ge-detail { position:absolute; top:56px; right:0; width:340px; height:calc(100% - 56px); background:rgba(12,12,20,0.97); border-left:1px solid #1e1e2e; transform:translateX(100%); transition:transform 0.3s cubic-bezier(0.4,0,0.2,1); z-index:15; overflow-y:auto; }
  .ge-detail.open { transform:translateX(0); }
  .ge-detail-header { padding:14px 16px; border-bottom:1px solid #1e1e2e; display:flex; align-items:flex-start; justify-content:space-between; position:sticky; top:0; background:rgba(12,12,20,0.98); z-index:2; }
  .ge-detail-type { font-size:9px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; padding:3px 8px; border-radius:4px; margin-bottom:7px; display:inline-block; }
  .ge-detail-title { font-size:15px; font-weight:700; color:#fff; line-height:1.3; }
  .ge-detail-close { background:none; border:none; color:#4a4a6a; font-size:18px; cursor:pointer; padding:0; line-height:1; flex-shrink:0; margin-left:8px; }
  .ge-detail-close:hover { color:#fff; }
  .ge-detail-body { padding:14px 16px; }
  .ge-meta-grid { display:grid; grid-template-columns:1fr 1fr; gap:7px; margin-bottom:14px; }
  .ge-meta-item { background:#12121a; border-radius:8px; padding:7px 10px; }
  .ge-meta-item .l { font-size:9px; font-weight:600; text-transform:uppercase; color:#4a4a6a; letter-spacing:0.08em; margin-bottom:3px; }
  .ge-meta-item .v { font-size:13px; color:#e0e0ff; font-weight:500; }
  .ge-section-title { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:#4a4a6a; margin:14px 0 7px 0; padding-bottom:5px; border-bottom:1px solid #1a1a2a; }
  .ge-tag-list { display:flex; flex-wrap:wrap; gap:5px; }
  .ge-tag { background:#1a1a2a; border:1px solid #2a2a3e; border-radius:4px; padding:3px 8px; font-size:10px; color:#9090b0; }
  .ge-conn-group { margin-bottom:10px; }
  .ge-conn-label { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#3a3a5a; margin-bottom:5px; }
  .ge-conn-items { display:flex; flex-direction:column; gap:3px; }
  .ge-conn-item { background:#0f0f18; border-radius:6px; padding:6px 9px; font-size:11px; color:#c0c0e0; cursor:pointer; display:flex; align-items:center; gap:7px; transition:background 0.15s; border:1px solid transparent; }
  .ge-conn-item:hover { background:#1a1a2e; border-color:#2a2a3e; color:#fff; }
  .ge-conn-item .dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .ge-legend { position:absolute; bottom:12px; left:12px; background:rgba(10,10,15,0.88); backdrop-filter:blur(8px); border:1px solid #1e1e2e; border-radius:10px; padding:9px 14px; display:flex; flex-wrap:wrap; gap:8px 14px; max-width:480px; z-index:10; }
  .ge-zoom-btn:hover { background:#1e1e30; color:#fff; }
  .ge-legend-item { display:flex; align-items:center; gap:6px; font-size:10px; color:#6060a0; font-weight:500; transition:color 0.15s; cursor:pointer; }
  .ge-legend-item:hover { color:#fff; }
  .ge-legend-item .dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
  .ge-stats { position:absolute; bottom:12px; right:12px; background:rgba(10,10,15,0.88); backdrop-filter:blur(8px); border:1px solid #1e1e2e; border-radius:8px; padding:7px 12px; font-size:10px; color:#4a4a6a; display:flex; gap:14px; z-index:10; }
  .ge-stats .s { color:#8080c0; font-weight:600; }
  .ge-loading { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:12px; color:#4a4a6a; font-size:12px; z-index:5; background:rgba(10,10,15,0.9); }
  .ge-spinner { width:32px; height:32px; border:2px solid #1e1e2e; border-top-color:#7d61ff; border-radius:50%; animation:ge-spin 0.8s linear infinite; }
  @keyframes ge-spin { to{transform:rotate(360deg)} }
  .ge-zoom-btns { position:absolute; right:12px; top:68px; display:flex; flex-direction:column; gap:4px; z-index:10; }
  .ge-zoom-btn { width:30px; height:30px; background:rgba(12,12,20,0.9); border:1px solid #2a2a3e; border-radius:6px; color:#8080a0; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.15s; }
  .ge-zoom-btn:hover { background:#1e1e30; color:#fff; }
</style>

<div class="ge-wrapper" id="ge-wrapper">
  <div class="ge-topbar">
    <div class="ge-title">GOS Knowledge Graph</div>
    <div class="ge-search">
      <span class="ge-search-icon">&#8981;</span>
      <input type="text" id="ge-search-input" placeholder="Search recipes, ingredients, compounds..." autocomplete="off"/>
      <div class="ge-search-results" id="ge-search-results"></div>
    </div>
    <div class="ge-filters" id="ge-filters"></div>
  </div>
  <div class="ge-canvas" id="ge-canvas">
    <div class="ge-loading" id="ge-loading"><div class="ge-spinner"></div><span>Stabilizing knowledge graph...</span></div>
  </div>
  <div class="ge-zoom-btns">
    <button class="ge-zoom-btn" id="ge-zoom-in">+</button>
    <button class="ge-zoom-btn" id="ge-zoom-out">&#8722;</button>
    <button class="ge-zoom-btn" id="ge-zoom-reset">&#8635;</button>
  </div>
  <div class="ge-detail" id="ge-detail">
    <div class="ge-detail-header">
      <div>
        <div class="ge-detail-type" id="ge-detail-type">NODE</div>
        <div class="ge-detail-title" id="ge-detail-title">-</div>
      </div>
      <button class="ge-detail-close" id="ge-detail-close">&#10005;</button>
    </div>
    <div class="ge-detail-body" id="ge-detail-body"></div>
  </div>
  <div class="ge-legend" id="ge-legend"></div>
  <div class="ge-stats">
    <span>NODES <span class="s" id="ge-node-count">0</span></span>
    <span>EDGES <span class="s" id="ge-edge-count">0</span></span>
    <span>RECIPES <span class="s" id="ge-recipe-count">0</span></span>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/vis-network@9.1.9/standalone/umd/vis-network.min.js"></script>
<script is:inline>
(function() {
  var COLORS = {
    recipe: '#FF6B6B', ingredient: '#4ECDC4', vitamin: '#F9C74F', nutrient: '#F9C74F',
    substance: '#9D4EDD', condition: '#F94144', diet: '#06D6A0', flavor: '#FFE66D',
    texture: '#F38181', aroma: '#A8E6CF', region: '#7D61FF', category: '#90BE6D',
    place: '#B2E2F2', technique: '#AA96DA'
  };

  var TYPE_LABELS = {
    recipe: 'Recipes', ingredient: 'Ingredients', substance: 'Substances', condition: 'Conditions',
    diet: 'Diets', flavor: 'Flavors', texture: 'Textures', aroma: 'Aromas',
    region: 'Regions', category: 'Categories', place: 'Places', technique: 'Techniques'
  };

  var TYPE_ORDER = ['recipe','ingredient','substance','condition','diet','flavor','texture','aroma','region','category','place','technique'];

  var ETYPE_LABELS = {
    HAS_RECIPE: 'Recipes', USES: 'Ingredients', USES_INGREDIENT: 'Ingredients', BELONGS_TO: 'Category',
    HAS_FLAVOR: 'Flavors', HAS_TEXTURE: 'Textures', HAS_AROMA: 'Aromas', HAS_MACRO: 'Nutrition',
    FROM_REGION: 'Region', RELATED_DISHES: 'Related Dishes', PLACE: 'Places', USES_TECHNIQUE: 'Techniques',
    OFTEN_TOGETHER: 'Often Together', HELPS_CONDITION: 'Helps Condition', TREATS: 'Treats',
    HAS_SUBSTANCE: 'Substances', CONTAINS_VITAMIN: 'Vitamins'
  };

  var canvas = document.getElementById('ge-canvas');
  var loading = document.getElementById('ge-loading');
  var detail = document.getElementById('ge-detail');
  var detailBody = document.getElementById('ge-detail-body');
  var detailTitle = document.getElementById('ge-detail-title');
  var detailType = document.getElementById('ge-detail-type');
  var searchInput = document.getElementById('ge-search-input');
  var searchResults = document.getElementById('ge-search-results');
  var filtersEl = document.getElementById('ge-filters');
  var legendEl = document.getElementById('ge-legend');
  var nodeCountEl = document.getElementById('ge-node-count');
  var edgeCountEl = document.getElementById('ge-edge-count');
  var recipeCountEl = document.getElementById('ge-recipe-count');

  var graphData = null;
  var network = null;
  var nodesDataSet = null;
  var edgesDataSet = null;
  var activeTypes = new Set(Object.keys(COLORS));
  var highlightedNodeId = null;

  var baseUrl = (document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/').replace(/\/$/, '');
  var candidates = [baseUrl + '/graph-data.json', '/graph-data.json', './graph-data.json', 'graph-data.json'];

  function loadData(index) {
    if (index >= candidates.length) {
      loading.innerHTML = '<span style="color:#f38181">Error loading graph data</span>';
      return;
    }
    fetch(candidates[index]).then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    }).then(function(data) {
      onDataLoaded(data);
    }).catch(function() {
      loadData(index + 1);
    });
  }

  loadData(0);

  function onDataLoaded(data) {
    graphData = data;
    var recipeNodes = data.nodes.filter(function(n) { return n.type === 'recipe'; });
    nodeCountEl.textContent = data.nodes.length;
    edgeCountEl.textContent = data.edges.length;
    recipeCountEl.textContent = recipeNodes.length;

    buildFilters(data.nodes);
    buildLegend(data.nodes);
    initVisNetwork();

    // Check for query parameters ?node= or ?filter=
    var params = new URLSearchParams(window.location.search);
    var targetNode = params.get('node');
    var filterQuery = params.get('filter');

    if (targetNode) {
      setTimeout(function() { focusAndShowNode(targetNode); }, 800);
    } else if (filterQuery) {
      var parts = filterQuery.split(':');
      if (parts.length === 2) {
        var fType = parts[0];
        var fVal = parts[1].toLowerCase();
        var match = graphData.nodes.find(function(n) {
          return n.type === fType && (n.id.toLowerCase().includes(fVal) || (n.label && n.label.toLowerCase().includes(fVal)));
        });
        if (match) {
          setTimeout(function() { focusAndShowNode(match.id); }, 800);
        }
      }
    }
  }

  function buildFilters(nodes) {
    var counts = {};
    nodes.forEach(function(n) { counts[n.type] = (counts[n.type] || 0) + 1; });
    filtersEl.innerHTML = '';
    TYPE_ORDER.forEach(function(t) {
      if (!counts[t]) return;
      var btn = document.createElement('button');
      btn.className = 'ge-filter-btn ' + t + ' on';
      btn.dataset.type = t;
      var dot = document.createElement('span');
      dot.className = 'dot';
      dot.style.background = COLORS[t] || '#888';
      btn.appendChild(dot);
      btn.appendChild(document.createTextNode((TYPE_LABELS[t] || t) + ' (' + counts[t] + ')'));
      btn.onclick = function() { toggleType(t, btn); };
      filtersEl.appendChild(btn);
    });
  }

  function toggleType(t, btn) {
    if (activeTypes.has(t)) {
      activeTypes.delete(t);
      btn.classList.remove('on');
    } else {
      activeTypes.add(t);
      btn.classList.add('on');
    }
    applyFilters();
  }

  function buildLegend(nodes) {
    var counts = {};
    nodes.forEach(function(n) { counts[n.type] = (counts[n.type] || 0) + 1; });
    legendEl.innerHTML = '';
    TYPE_ORDER.forEach(function(t) {
      if (!counts[t]) return;
      var item = document.createElement('div');
      item.className = 'ge-legend-item';
      var dot = document.createElement('span');
      dot.className = 'dot';
      dot.style.background = COLORS[t] || '#888';
      item.appendChild(dot);
      item.appendChild(document.createTextNode((TYPE_LABELS[t] || t) + ' (' + counts[t] + ')'));
      legendEl.appendChild(item);
    });
  }

  function applyFilters() {
    if (!nodesDataSet || !edgesDataSet || !graphData) return;

    var filteredNodes = graphData.nodes.filter(function(n) {
      return activeTypes.has(n.type);
    }).map(formatVisNode);

    var validNodeIds = new Set(filteredNodes.map(function(n) { return n.id; }));

    var filteredEdges = graphData.edges.filter(function(e) {
      return validNodeIds.has(e.source) && validNodeIds.has(e.target);
    }).map(formatVisEdge);

    nodesDataSet.clear();
    edgesDataSet.clear();
    nodesDataSet.add(filteredNodes);
    edgesDataSet.add(filteredEdges);
  }

  function formatVisNode(n) {
    var color = COLORS[n.type] || '#888888';
    var size = n.size ? Math.max(10, Math.min(25, n.size / 2)) : 12;
    return {
      id: n.id,
      label: n.label || n.id,
      shape: 'dot',
      size: size,
      color: {
        background: color,
        border: '#000000',
        highlight: { background: color, border: '#ffffff' },
        hover: { background: color, border: '#ffffff' }
      },
      font: { color: '#e0e0ff', size: 11, face: 'Inter, system-ui, sans-serif' },
      type: n.type,
      raw: n
    };
  }

  function formatVisEdge(e, idx) {
    return {
      id: e.id ? (e.id + '-' + idx) : (e.source + '-' + e.target + '-' + idx),
      from: e.source,
      to: e.target,
      color: { color: '#2a2a3e', highlight: '#7d61ff', hover: '#7d61ff', opacity: 0.5 },
      width: 1,
      raw: e
    };
  }

  function initVisNetwork() {
    var initialNodes = graphData.nodes.map(formatVisNode);
    var validNodeIds = new Set(initialNodes.map(function(n) { return n.id; }));
    var initialEdges = graphData.edges.filter(function(e) {
      return validNodeIds.has(e.source) && validNodeIds.has(e.target);
    }).map(formatVisEdge);

    nodesDataSet = new vis.DataSet(initialNodes);
    edgesDataSet = new vis.DataSet(initialEdges);

    var visData = { nodes: nodesDataSet, edges: edgesDataSet };

    var options = {
      nodes: {
        borderWidth: 1,
        shadow: true
      },
      edges: {
        smooth: { type: 'continuous' }
      },
      interaction: {
        hover: true,
        hoverConnectedEdges: true,
        selectConnectedEdges: true,
        tooltipDelay: 200
      },
      physics: {
        solver: 'barnesHut',
        barnesHut: {
          gravitationalConstant: -4000,
          centralGravity: 0.3,
          springLength: 95,
          springConstant: 0.04,
          damping: 0.09
        },
        maxVelocity: 50,
        minVelocity: 0.75,
        stabilization: {
          enabled: true,
          iterations: 100,
          updateInterval: 25
        }
      }
    };

    network = new vis.Network(canvas, visData, options);

    network.on('stabilizationProgress', function(params) {
      var progress = Math.round((params.iteration / params.total) * 100);
      loading.querySelector('span').textContent = 'Stabilizing knowledge graph... ' + progress + '%';
    });

    network.on('stabilizationIterationsDone', function() {
      loading.style.display = 'none';
      network.setOptions({ physics: { enabled: false } }); // Freeze after fast stabilization for performance
    });

    // Fallback timer for physics stabilization < 3s
    setTimeout(function() {
      if (loading.style.display !== 'none') {
        loading.style.display = 'none';
        network.setOptions({ physics: { enabled: false } });
      }
    }, 2800);

    // Click Node Event
    network.on('click', function(params) {
      if (params.nodes.length > 0) {
        var nodeId = params.nodes[0];
        highlightNeighborhood(nodeId);
        showDetailById(nodeId);
      } else {
        resetHighlight();
        detail.classList.remove('open');
      }
    });

    // Hover Node Event
    network.on('hoverNode', function(params) {
      if (!highlightedNodeId) {
        highlightNeighborhood(params.node);
      }
    });

    network.on('blurNode', function() {
      if (!highlightedNodeId) {
        resetHighlight();
      }
    });
  }

  function highlightNeighborhood(nodeId) {
    if (!network || !nodesDataSet || !edgesDataSet) return;

    var connectedNodes = network.getConnectedNodes(nodeId);
    var connectedEdges = network.getConnectedEdges(nodeId);
    var allNodes = nodesDataSet.get();
    var allEdges = edgesDataSet.get();

    var connectedNodeSet = new Set(connectedNodes);
    connectedNodeSet.add(nodeId);
    var connectedEdgeSet = new Set(connectedEdges);

    var updatedNodes = [];
    allNodes.forEach(function(n) {
      var isConnected = connectedNodeSet.has(n.id);
      var opacity = isConnected ? 1.0 : 0.15;
      var color = COLORS[n.type] || '#888';
      updatedNodes.push({
        id: n.id,
        color: {
          background: isConnected ? color : 'rgba(40,40,60,0.3)',
          border: isConnected ? (n.id === nodeId ? '#ffffff' : '#000000') : 'rgba(20,20,30,0.3)'
        },
        font: { color: isConnected ? '#ffffff' : 'rgba(100,100,140,0.3)' }
      });
    });

    var updatedEdges = [];
    allEdges.forEach(function(e) {
      var isConnected = connectedEdgeSet.has(e.id);
      updatedEdges.push({
        id: e.id,
        color: { color: isConnected ? '#7d61ff' : 'rgba(30,30,50,0.1)', opacity: isConnected ? 0.9 : 0.05 },
        width: isConnected ? 2 : 1
      });
    });

    nodesDataSet.update(updatedNodes);
    edgesDataSet.update(updatedEdges);
  }

  function resetHighlight() {
    if (!nodesDataSet || !edgesDataSet) return;
    highlightedNodeId = null;

    var allNodes = nodesDataSet.get();
    var allEdges = edgesDataSet.get();

    var updatedNodes = allNodes.map(function(n) {
      var color = COLORS[n.type] || '#888';
      return {
        id: n.id,
        color: {
          background: color,
          border: '#000000'
        },
        font: { color: '#e0e0ff' }
      };
    });

    var updatedEdges = allEdges.map(function(e) {
      return {
        id: e.id,
        color: { color: '#2a2a3e', opacity: 0.5 },
        width: 1
      };
    });

    nodesDataSet.update(updatedNodes);
    edgesDataSet.update(updatedEdges);
  }

  function focusAndShowNode(id) {
    if (!graphData || !network) return;
    highlightedNodeId = id;
    highlightNeighborhood(id);
    showDetailById(id);
    network.focus(id, {
      scale: 1.2,
      animation: { duration: 600, easingFunction: 'easeInOutQuad' }
    });
  }

  window.focusNode = function(id) {
    searchResults.classList.remove('active');
    searchInput.value = '';
    focusAndShowNode(id);
  };

  function showDetailById(nodeId) {
    var rawNode = graphData.nodes.find(function(n) { return n.id === nodeId; });
    if (!rawNode) return;
    showDetail(rawNode);
  }

  function showDetail(node) {
    detailTitle.textContent = node.label || node.id;
    detailType.textContent = (node.type || 'node').toUpperCase();
    detailType.style.background = COLORS[node.type] || '#333';
    detailType.style.color = '#000';

    var conns = {};
    graphData.edges.forEach(function(e) {
      var s = e.source;
      var t = e.target;
      if (s === node.id || t === node.id) {
        var other = s === node.id ? t : s;
        if (!conns[e.type]) conns[e.type] = [];
        var otherNode = graphData.nodes.find(function(n) { return n.id === other; });
        if (otherNode) conns[e.type].push(otherNode);
      }
    });

    var connTotal = graphData.edges.filter(function(e) {
      return e.source === node.id || e.target === node.id;
    }).length;

    var html = '';

    if (node.region || node.difficulty || node.prep_time || node.cook_time) {
      html += '<div class="ge-meta-grid">';
      if (node.region) html += '<div class="ge-meta-item"><div class="l">Region</div><div class="v">'+node.region+'</div></div>';
      if (node.difficulty) html += '<div class="ge-meta-item"><div class="l">Difficulty</div><div class="v">'+node.difficulty+'</div></div>';
      if (node.prep_time) html += '<div class="ge-meta-item"><div class="l">Prep</div><div class="v">'+node.prep_time+'</div></div>';
      if (node.cook_time) html += '<div class="ge-meta-item"><div class="l">Cook</div><div class="v">'+node.cook_time+'</div></div>';
      html += '</div>';
    }

    html += '<div class="ge-meta-item" style="margin-bottom:14px"><div class="l">Connections</div><div class="v">'+connTotal+'</div></div>';

    // Scientific details: compounds, mechanism, studies, linked recipes
    if (node.active_compounds && node.active_compounds.length) {
      html += '<div class="ge-section-title">Active Compounds</div><div class="ge-tag-list">';
      node.active_compounds.forEach(function(c) { html += '<span class="ge-tag" style="border-color:#9d4edd;color:#c896ff">'+c+'</span>'; });
      html += '</div>';
    }

    if (node.mechanism) {
      html += '<div class="ge-section-title">Action Mechanism</div>';
      html += '<div class="ge-instructions" style="border-left-color:#9d4edd">'+node.mechanism+'</div>';
    }

    if (node.studies && node.studies.length) {
      html += '<div class="ge-section-title">Scientific Studies / PubMed</div><div class="ge-tag-list">';
      node.studies.forEach(function(s) {
        html += '<a href="'+(s.url || '#')+'" target="_blank" rel="noopener" class="ge-tag" style="color:#00ff66;text-decoration:underline">'+(s.title || s.id || 'Study')+'</a>';
      });
      html += '</div>';
    }

    if (node.tags && node.tags.length) {
      html += '<div class="ge-section-title">Tags</div><div class="ge-tag-list">';
      node.tags.forEach(function(t) { html += '<span class="ge-tag">'+t+'</span>'; });
      html += '</div>';
    }

    if (node.categories && node.categories.length) {
      html += '<div class="ge-section-title">Categories</div><div class="ge-tag-list">';
      node.categories.forEach(function(c) { html += '<span class="ge-tag">'+c+'</span>'; });
      html += '</div>';
    }

    Object.keys(conns).sort().forEach(function(type) {
      var items = conns[type];
      if (!items || !items.length) return;
      html += '<div class="ge-conn-group">';
      html += '<div class="ge-conn-label">' + (ETYPE_LABELS[type] || type) + ' (' + items.length + ')</div>';
      html += '<div class="ge-conn-items">';
      items.slice(0, 25).forEach(function(other) {
        var color = COLORS[other.type] || '#888';
        html += '<div class="ge-conn-item" onclick="window.focusNode(\''+other.id+'\')">';
        html += '<div class="dot" style="background:'+color+'"></div>';
        html += '<span>' + (other.label || other.id) + '</span>';
        html += '</div>';
      });
      if (items.length > 25) html += '<div class="ge-conn-item" style="color:#4a4a6a;cursor:default">+' + (items.length - 25) + ' more</div>';
      html += '</div></div>';
    });

    detailBody.innerHTML = html;
    detail.classList.add('open');
  }

  // Search input handler
  searchInput.addEventListener('input', function(e) {
    var q = e.target.value.toLowerCase().trim();
    searchResults.classList.remove('active');
    if (q.length < 2) return;
    var results = graphData.nodes.filter(function(n) {
      return (n.label || n.id).toLowerCase().includes(q);
    }).slice(0, 12);
    if (!results.length) return;
    searchResults.innerHTML = results.map(function(n) {
      return '<div class="ge-search-item" onclick="window.focusNode(\''+n.id+'\')">' +
        '<div class="dot" style="background:'+(COLORS[n.type]||'#888')+'"></div>' +
        '<span class="t">'+(n.label||n.id)+'</span>' +
        '<span class="sub">'+n.type+'</span></div>';
    }).join('');
    searchResults.classList.add('active');
  });

  searchInput.addEventListener('blur', function() { setTimeout(function() { searchResults.classList.remove('active'); }, 150); });

  document.getElementById('ge-zoom-in').onclick = function() {
    if (network) {
      var scale = network.getScale();
      network.moveTo({ scale: scale * 1.3, animation: { duration: 300 } });
    }
  };
  document.getElementById('ge-zoom-out').onclick = function() {
    if (network) {
      var scale = network.getScale();
      network.moveTo({ scale: scale * 0.7, animation: { duration: 300 } });
    }
  };
  document.getElementById('ge-zoom-reset').onclick = function() {
    if (network) {
      network.fit({ animation: { duration: 500 } });
    }
  };
  document.getElementById('ge-detail-close').onclick = function() {
    detail.classList.remove('open');
    resetHighlight();
  };

  window.addEventListener('resize', function() {
    if (network) network.redraw();
  });
})();
</script>
