---
interface Props {
  id?: string;
}

const { id = 'rating' } = Astro.props;
---

<div class="flex gap-2" id={`${id}-container`}>
  {[1, 2, 3, 4, 5].map(value => (
    <label class="cursor-pointer">
      <input type="radio" name={id} value={value} class="hidden peer" />
      <span class="text-3xl text-gray-600 peer-checked:text-yellow-400 hover:text-yellow-300 transition-colors">
        ⭐
      </span>
    </label>
  ))}
</div>

<script>
  // Add hover preview effect
  const container = document.getElementById('rating-container');
  if (container) {
    const stars = container.querySelectorAll('input[type="radio"]');
    const labels = container.querySelectorAll('span');

    labels.forEach((label, index) => {
      label.addEventListener('mouseenter', () => {
        labels.forEach((l, i) => {
          l.classList.toggle('text-yellow-400', i <= index);
          l.classList.toggle('text-gray-600', i > index);
        });
      });
    });

    container.addEventListener('mouseleave', () => {
      const checked = container.querySelector('input:checked');
      const checkedIndex = checked ? parseInt((checked as HTMLInputElement).value) - 1 : -1;
      labels.forEach((l, i) => {
        l.classList.toggle('text-yellow-400', i <= checkedIndex);
        l.classList.toggle('text-gray-600', i > checkedIndex);
      });
    });
  }
</script>

<style>
  input:checked + span {
    color: #facc15;
  }
</style>