---
interface Props {
  fallbackMessage?: string;
}

const { fallbackMessage = 'Something went wrong loading this content.' } = Astro.props;
---

<div id="error-boundary-wrapper" class="error-boundary">
  <slot />
</div>

<script is:inline>
  (function() {
    const wrapper = document.getElementById('error-boundary-wrapper');
    if (!wrapper) return;

    // Capture any errors in child content
    window.addEventListener('error', function(e) {
      showError(e.message || 'Unknown error occurred');
    });

    window.addEventListener('unhandledrejection', function(e) {
      showError(e.reason?.message || 'An unexpected error happened');
    });

    function showError(message) {
      if (wrapper && !wrapper.querySelector('.error-fallback')) {
        wrapper.innerHTML = `
          <div class="error-fallback" style="
            background: #0a0a0f;
            border: 1px solid #e94560;
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            margin: 1rem 0;
          ">
            <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
            <h3 style="color: #e94560; font-size: 1.25rem; margin-bottom: 0.5rem; font-family: 'Patrick Hand', cursive;">
              Error Loading Content
            </h3>
            <p style="color: #a1a1aa; margin-bottom: 1rem; font-size: 0.875rem;">
              ${message}
            </p>
            <button
              onclick="location.reload()"
              style="
                background: #e94560;
                color: #fff;
                border: none;
                padding: 0.5rem 1.5rem;
                border-radius: 8px;
                cursor: pointer;
                font-size: 0.875rem;
                transition: opacity 0.2s;
              "
              onmouseover="this.style.opacity='0.8'"
              onmouseout="this.style.opacity='1'"
            >
              🔄 Retry
            </button>
          </div>
        `;
      }
    }
  })();
</script>
