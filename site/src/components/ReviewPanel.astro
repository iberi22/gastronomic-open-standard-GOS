---
import StarRating from './StarRating.astro';
---

<div class="p-6 bg-white/5 rounded-xl border border-white/10">
  <form id="review-form" class="space-y-4">
    <div>
      <label for="place-name" class="block text-sm text-gray-400 mb-1">Nombre del lugar</label>
      <input type="text" id="place-name" required placeholder="Restaurante La Casona"
        class="w-full px-4 py-2 bg-white/10 border border-white/20 rounded-lg focus:border-primary focus:outline-none" />
    </div>

    <div>
      <label for="location" class="block text-sm text-gray-400 mb-1">Ubicación</label>
      <input type="text" id="location" placeholder="Bogotá, Colombia"
        class="w-full px-4 py-2 bg-white/10 border border-white/20 rounded-lg focus:border-primary focus:outline-none" />
    </div>

    <div>
      <label class="block text-sm text-gray-400 mb-2">Calificación</label>
      <StarRating id="rating" />
    </div>

    <div>
      <label for="comment" class="block text-sm text-gray-400 mb-1">Tu reseña</label>
      <textarea id="comment" rows="4" placeholder="Cuéntanos tu experiencia..."
        class="w-full px-4 py-2 bg-white/10 border border-white/20 rounded-lg focus:border-primary focus:outline-none resize-none"></textarea>
    </div>

    <button type="submit" class="w-full px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/80 transition-colors font-display text-lg">
      Publicar Review
    </button>
  </form>

  <div id="review-status" class="mt-4 text-sm"></div>
</div>

<script>
  import { saveReview } from '../lib/gundb';

  const form = document.getElementById('review-form') as HTMLFormElement;
  const status = document.getElementById('review-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const placeName = (document.getElementById('place-name') as HTMLInputElement)?.value;
    const location = (document.getElementById('location') as HTMLInputElement)?.value;
    const ratingInput = document.querySelector('input[name="rating"]:checked') as HTMLInputElement;
    const rating = parseInt(ratingInput?.value || '0');
    const comment = (document.getElementById('comment') as HTMLTextAreaElement)?.value;

    if (!placeName || rating === 0) {
      if (status) {
        status.innerHTML = '<span class="text-red-400">Completa el nombre y la calificación</span>';
      }
      return;
    }

    try {
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Guardando...';

      const review = {
        id: crypto.randomUUID(),
        placeName,
        location,
        rating,
        comment,
        timestamp: Date.now(),
        country: localStorage.getItem('gos_country') || 'unknown'
      };

      await saveReview(review);

      if (status) {
        status.innerHTML = '<span class="text-green-400">✓ Review guardada</span>';
      }

      form.reset();

      // Reload reviews after short delay
      setTimeout(() => {
        location.reload();
      }, 1000);
    } catch (err) {
      console.error('Error saving review:', err);
      if (status) {
        status.innerHTML = '<span class="text-red-400">Error al guardar: ' + (err as Error).message + '</span>';
      }
    } finally {
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = false;
      btn.textContent = 'Publicar Review';
    }
  });
</script>