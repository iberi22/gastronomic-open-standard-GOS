{
  "name": "gos-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "GOS — Gastronomic Open Standard · grafo global recetas↔ingredientes↔vitaminas↔sabores↔afecciones↔dietas↔substancias — Astro 7 + Svelte 5 + @swal/ui antigravity",
  "scripts": {
    "dev": "astro dev",
    "generate": "node scripts/copy-content.js && node scripts/generate-api.js && node scripts/generate-catalog.js && node scripts/enrich-ingredients.js && node scripts/generate-graph.js && node scripts/export-vectors.mjs && node scripts/generate-llms.mjs && node scripts/generate-sitemap.js",
    "prebuild": "pnpm run generate",
    "build": "pnpm run prebuild && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@swal/ui": "github:iberi22/swal-ui",
    "@xenova/transformers": "^2.17.2",
    "astro": "^7.3.2",
    "diff": "^8.0.4",
    "fuse.js": "7.5.0",
    "glob": "^13.0.6",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "gray-matter": "^4.0.3",
    "idb": "8.0.3",
    "sharp": "^0.35.3",
    "sigma": "3.0.3",
    "y-indexeddb": "9.0.12",
    "y-webrtc": "10.3.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/svelte": "^7.2.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "autoprefixer": "10.5.6",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.0",
    "wrangler": "^4.131.0"
  },
  "overrides": {
    "js-yaml@3": "3.15.0",
    "js-yaml@4": "4.3.0",
    "sharp": "^0.35.3"
  }
