{
  "manifest_version": 3,
  "name": "GOS Scraper",
  "version": "1.0.0",
  "description": "Extrae datos de restaurantes y productos alimenticios a GOS",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.yelp.com/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.openstreetmap.org/*",
    "https://*.wikipedia.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.yelp.com/*",
        "https://*.google.com/maps/*",
        "https://www.google.com/maps/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}