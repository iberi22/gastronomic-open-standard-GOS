{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gos.swal.network/schemas/ecosystem/v1/workout-session.schema.json",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "schema": {
          "const": "swal.health/v1/workout-session"
        }
      },
      "type": "object"
    }
  ],
  "$defs": {
    "drop": {
      "type": "object",
      "properties": {
        "weightKg": {
          "type": "number",
          "minimum": 0
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["weightKg", "reps"],
      "additionalProperties": false
    },
    "cluster": {
      "type": "object",
      "properties": {
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "restSec": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["reps", "restSec"],
      "additionalProperties": false
    },
    "side": {
      "type": "object",
      "properties": {
        "weightKg": {
          "type": "number",
          "minimum": 0
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "durationS": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0
        },
        "rir": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "rpe": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "weightOrigin": {
          "const": "manual"
        },
        "drops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drop"
          },
          "minItems": 1
        },
        "clusters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cluster"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "not": {
        "type": "object",
        "properties": {
          "rir": true,
          "rpe": true
        },
        "required": ["rir", "rpe"]
      }
    },
    "set": {
      "type": "object",
      "properties": {
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "weightKg": {
          "type": "number",
          "minimum": 0
        },
        "rir": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "rpe": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "durationS": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0
        },
        "distanceM": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0
        },
        "speedKph": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0
        },
        "phase": {
          "type": "string",
          "enum": ["warmup", "work"]
        },
        "shape": {
          "type": "string",
          "enum": ["straight", "dropset", "restpause"]
        },
        "drops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drop"
          },
          "minItems": 1
        },
        "clusters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cluster"
          },
          "minItems": 1
        },
        "sides": {
          "type": "object",
          "properties": {
            "L": {
              "$ref": "#/$defs/side"
            },
            "R": {
              "$ref": "#/$defs/side"
            }
          },
          "required": ["L", "R"],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false,
      "not": {
        "type": "object",
        "properties": {
          "rir": true,
          "rpe": true
        },
        "required": ["rir", "rpe"]
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "speedKph": true
            },
            "required": ["speedKph"]
          },
          "then": {
            "type": "object",
            "properties": {
              "distanceM": true
            },
            "required": ["distanceM"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "drops": true
            },
            "required": ["drops"]
          },
          "then": {
            "type": "object",
            "properties": {
              "shape": {
                "const": "dropset"
              }
            },
            "required": ["shape"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "clusters": true
            },
            "required": ["clusters"]
          },
          "then": {
            "type": "object",
            "properties": {
              "shape": {
                "const": "restpause"
              }
            },
            "required": ["shape"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "sides": true
            },
            "required": ["sides"]
          },
          "then": {
            "type": "object",
            "properties": {
              "sides": {
                "type": "object",
                "properties": {
                  "L": {
                    "type": "object",
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "reps": true
                        },
                        "required": ["reps"]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "durationS": true
                        },
                        "required": ["durationS"]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "weightKg": true
                        },
                        "required": ["weightKg"]
                      }
                    ]
                  },
                  "R": {
                    "type": "object",
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "reps": true
                        },
                        "required": ["reps"]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "durationS": true
                        },
                        "required": ["durationS"]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "weightKg": true
                        },
                        "required": ["weightKg"]
                      }
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reps": true
                },
                "required": ["reps"]
              },
              {
                "type": "object",
                "properties": {
                  "durationS": true
                },
                "required": ["durationS"]
              },
              {
                "type": "object",
                "properties": {
                  "distanceM": true
                },
                "required": ["distanceM"]
              }
            ]
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "startedAt": {
          "$ref": "envelope.schema.json#/$defs/datetime"
        },
        "endedAt": {
          "$ref": "envelope.schema.json#/$defs/datetime"
        },
        "routineId": {
          "type": "string",
          "minLength": 1
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "envelope.schema.json#/$defs/exercise"
              },
              "sets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/set"
                },
                "minItems": 1
              },
              "notes": {
                "type": "string"
              },
              "topWeightKg": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["ref", "sets"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "energy": {
          "type": "object",
          "properties": {
            "kcal": {
              "type": "number",
              "minimum": 0
            },
            "method": {
              "type": "string",
              "enum": ["met-estimate", "device", "declared", "unknown"]
            }
          },
          "required": ["kcal", "method"],
          "additionalProperties": false
        },
        "perceivedEffort": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["startedAt", "endedAt", "exercises"],
      "additionalProperties": false
    }
  },
  "type": "object"
}
