{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gos.swal.network/schemas/ecosystem/v1/bodyweight-log.schema.json",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "schema": {
          "const": "swal.health/v1/bodyweight-log"
        }
      },
      "type": "object"
    }
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$"
        },
        "weightKg": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "date",
        "weightKg"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    }
  },
  "type": "object"
}
