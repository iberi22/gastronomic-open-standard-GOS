---
// KitchenChat.astro - Interactive Local Kitchen Assistant AI running via WebGPU
---

<div class="flex flex-col h-[calc(100vh-12rem)] max-w-4xl mx-auto bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm overflow-hidden" id="chat-component">
  <!-- Header / Status Bar -->
  <div class="px-6 py-4 bg-gray-50 dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
        <span class="material-symbols-outlined text-2xl">smart_toy</span>
      </div>
      <div>
        <h2 class="text-base font-bold text-gray-800 dark:text-gray-100 flex items-center gap-2">
          GOS Kitchen Assistant
          <span id="status-badge" class="px-2 py-0.5 text-xs rounded-full font-medium bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400">
            Checking WebGPU...
          </span>
        </h2>
        <p class="text-xs text-gray-500 dark:text-gray-400" id="status-subtext">
          Initializing hardware interface
        </p>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex items-center gap-2">
      <!-- Model Selector -->
      <select
        id="model-select"
        class="text-xs bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg px-2.5 py-1.5 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary"
      >
        <option value="Qwen2.5-1.5B-Instruct-q4f16_1-MLC">Qwen 2.5 1.5B (~1.6GB)</option>
        <option value="Llama-3.2-1B-Instruct-q4f16_1-MLC">Llama 3.2 1B (~1.1GB)</option>
      </select>

      <!-- Clear Storage -->
      <button
        id="btn-clear-cache"
        class="flex items-center gap-1 px-2.5 py-1.5 text-xs text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 rounded-lg transition-colors border border-transparent hover:border-red-200 dark:hover:border-red-900/30"
        title="Clear cached model weights"
      >
        <span class="material-symbols-outlined text-sm">delete_forever</span>
        <span>Clear Cache</span>
      </button>

      <!-- Clear Chat -->
      <button
        id="btn-clear-chat"
        class="flex items-center gap-1 px-2.5 py-1.5 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors border border-transparent hover:border-gray-200 dark:hover:border-gray-700"
        title="Clear current conversation"
      >
        <span class="material-symbols-outlined text-sm">clear_all</span>
        <span>Clear Chat</span>
      </button>
    </div>
  </div>

  <!-- Loading / Download Progress Overlay -->
  <div id="download-panel" class="hidden px-6 py-4 bg-primary/5 border-b border-gray-200 dark:border-gray-800 transition-all duration-300">
    <div class="max-w-xl mx-auto">
      <div class="flex items-center justify-between text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1.5">
        <span id="download-title">Downloading Model Weights (Required once)</span>
        <span id="download-percent">0%</span>
      </div>
      <div class="w-full bg-gray-200 dark:bg-gray-800 rounded-full h-2 overflow-hidden">
        <div id="download-progress-bar" class="bg-primary h-full rounded-full transition-all duration-300" style="width: 0%"></div>
      </div>
      <p id="download-status" class="text-[11px] text-gray-500 dark:text-gray-400 mt-1 truncate">
        Starting download...
      </p>
    </div>
  </div>

  <!-- Chat Area -->
  <div class="flex-1 overflow-y-auto p-6 space-y-6" id="chat-messages">
    <!-- Welcome Message -->
    <div class="flex gap-4 max-w-3xl">
      <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
        <span class="material-symbols-outlined text-lg">restaurant</span>
      </div>
      <div class="space-y-1.5">
        <div class="bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 rounded-2xl rounded-tl-none px-4 py-3 text-sm">
          <p class="font-bold mb-1">Welcome to GOS local AI Kitchen Assistant! 🍳</p>
          <p class="mb-2">I am an offline-capable culinary AI running 100% on your device's graphics card (WebGPU). I can suggest recipes, adapt ingredients, suggest variations, or calculate custom ratios.</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">To get started, you can click "Initialize Engine" below or type your culinary question directly. If WebGPU is not supported, I'll still provide recipe search results.</p>
        </div>
        <span class="text-[10px] text-gray-400 dark:text-gray-500 pl-2" id="welcome-timestamp">Just now</span>
      </div>
    </div>
  </div>

  <!-- Fallback / GPU Information Notice -->
  <div id="gpu-error-banner" class="hidden px-6 py-3 bg-amber-50 dark:bg-amber-950/20 border-t border-amber-200 dark:border-amber-900/30 text-amber-800 dark:text-amber-300 flex items-start gap-3">
    <span class="material-symbols-outlined text-amber-500 shrink-0 mt-0.5">warning</span>
    <div class="text-xs">
      <p class="font-bold">WebGPU Not Supported on this Device</p>
      <p>Local AI generation is disabled. Please ensure you are using Google Chrome or Microsoft Edge with a compatible GPU. You can still use the text box to execute local recipe RAG search!</p>
    </div>
  </div>

  <!-- Input Bar -->
  <div class="p-4 border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950">
    <form id="chat-form" class="flex gap-3">
      <input
        type="text"
        id="chat-input"
        placeholder="Type a cooking question (e.g. 'How to cook Sancocho de Pescado?', 'substitute for guascas')..."
        autocomplete="off"
        class="flex-1 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl px-4 py-3 text-sm text-gray-800 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all shadow-sm"
      />

      <!-- Initialize Engine Button (Visible when uninitialized) -->
      <button
        type="button"
        id="btn-init"
        class="px-5 py-3 bg-secondary hover:bg-secondary/90 text-white rounded-xl font-medium text-sm transition-all shadow-sm shrink-0 flex items-center gap-2"
      >
        <span class="material-symbols-outlined text-sm">power</span>
        <span>Initialize Engine</span>
      </button>

      <!-- Send Button -->
      <button
        type="submit"
        id="btn-send"
        disabled
        class="px-5 py-3 bg-primary hover:bg-primary/90 text-white rounded-xl font-medium text-sm transition-all shadow-sm shrink-0 flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span class="material-symbols-outlined text-sm">send</span>
        <span>Send</span>
      </button>
    </form>
  </div>
</div>

<script>
  import { isWebGPUSupported, getOrInitGPUEngine, streamGPUCompletion } from '../lib/gpu-agent';
  import { isModelCached, clearModelCache, getCacheStats } from '../lib/model-cache';
  import { ragSearch } from '../lib/rag-search';

  // State
  let engineLoaded = false;
  let engineInitializing = false;
  let isGenerating = false;
  let chatHistory: Array<{ role: string; content: string }> = [];

  // DOM Elements
  const btnInit = document.getElementById('btn-init') as HTMLButtonElement;
  const btnSend = document.getElementById('btn-send') as HTMLButtonElement;
  const btnClearChat = document.getElementById('btn-clear-chat') as HTMLButtonElement;
  const btnClearCache = document.getElementById('btn-clear-cache') as HTMLButtonElement;
  const modelSelect = document.getElementById('model-select') as HTMLSelectElement;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const chatForm = document.getElementById('chat-form') as HTMLFormElement;
  const chatMessages = document.getElementById('chat-messages') as HTMLDivElement;
  const statusBadge = document.getElementById('status-badge') as HTMLSpanElement;
  const statusSubtext = document.getElementById('status-subtext') as HTMLParagraphElement;
  const downloadPanel = document.getElementById('download-panel') as HTMLDivElement;
  const downloadPercent = document.getElementById('download-percent') as HTMLSpanElement;
  const downloadProgressBar = document.getElementById('download-progress-bar') as HTMLDivElement;
  const downloadStatus = document.getElementById('download-status') as HTMLParagraphElement;
  const gpuErrorBanner = document.getElementById('gpu-error-banner') as HTMLDivElement;
  const welcomeTimestamp = document.getElementById('welcome-timestamp') as HTMLSpanElement;

  // Set initial welcome timestamp
  if (welcomeTimestamp) {
    welcomeTimestamp.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  // Check WebGPU availability and update UI
  const gpuAvailable = isWebGPUSupported();
  if (!gpuAvailable) {
    statusBadge.textContent = "WebGPU Unsupported";
    statusBadge.className = "px-2 py-0.5 text-xs rounded-full font-medium bg-red-100 text-red-600 dark:bg-red-950/40 dark:text-red-400";
    statusSubtext.textContent = "WebGPU not available. Standard RAG fallback active.";
    btnInit.classList.add('hidden');
    gpuErrorBanner.classList.remove('hidden');
    btnSend.disabled = false; // Allow sending to RAG-only search
  } else {
    // Check cache status
    updateCacheStatus();
  }

  async function updateCacheStatus() {
    const selectedModel = modelSelect.value;
    const cached = await isModelCached(selectedModel);
    const stats = await getCacheStats();

    if (engineLoaded) {
      statusBadge.textContent = "Ready";
      statusBadge.className = "px-2 py-0.5 text-xs rounded-full font-medium bg-green-100 text-green-600 dark:bg-green-950/40 dark:text-green-400";
      statusSubtext.textContent = `Model running locally on WebGPU. Cache storage: ${stats.sizeMB} MB (${stats.count} files)`;
    } else if (cached) {
      statusBadge.textContent = "Offline Ready";
      statusBadge.className = "px-2 py-0.5 text-xs rounded-full font-medium bg-blue-100 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400";
      statusSubtext.textContent = "Model weights cached. Click Initialize to activate.";
    } else {
      statusBadge.textContent = "Uninitialized";
      statusBadge.className = "px-2 py-0.5 text-xs rounded-full font-medium bg-amber-100 text-amber-600 dark:bg-amber-950/40 dark:text-amber-400";
      statusSubtext.textContent = "Model weights need initial download (~1.6GB).";
    }
  }

  // Initialize Engine Handler
  async function initializeEngine() {
    if (engineInitializing || engineLoaded) return;
    engineInitializing = true;
    btnInit.disabled = true;
    btnInit.innerHTML = `<span class="material-symbols-outlined text-sm animate-spin">sync</span><span>Loading...</span>`;
    downloadPanel.classList.remove('hidden');

    const selectedModel = modelSelect.value;

    try {
      await getOrInitGPUEngine(selectedModel, (progress) => {
        downloadPercent.textContent = `${progress.percent}%`;
        downloadProgressBar.style.width = `${progress.percent}%`;
        downloadStatus.textContent = progress.message;
      });

      engineLoaded = true;
      engineInitializing = false;
      btnInit.classList.add('hidden');
      btnSend.disabled = false;
      downloadPanel.classList.add('hidden');
      updateCacheStatus();

      appendSystemMessage("WebGPU engine initialized successfully! Chat is active.");
    } catch (error: any) {
      console.error(error);
      engineInitializing = false;
      btnInit.disabled = false;
      btnInit.innerHTML = `<span class="material-symbols-outlined text-sm">power</span><span>Initialize Engine</span>`;
      downloadStatus.textContent = `Error: ${error.message || error}`;
      appendSystemMessage(`Failed to initialize WebGPU engine: ${error.message || error}`);
    }
  }

  btnInit.addEventListener('click', initializeEngine);

  // Clear Chat Handler
  btnClearChat.addEventListener('click', () => {
    chatHistory = [];
    const elements = chatMessages.querySelectorAll('.chat-message-bubble');
    elements.forEach(el => el.remove());
    appendSystemMessage("Chat history cleared.");
  });

  // Clear Cache Handler
  btnClearCache.addEventListener('click', async () => {
    if (confirm("Are you sure you want to clear cached WebGPU model weights? This will delete all cached model files and require a fresh download next time.")) {
      await clearModelCache();
      updateCacheStatus();
      appendSystemMessage("Model cache cleared successfully.");
    }
  });

  // Model Select Change
  modelSelect.addEventListener('change', () => {
    if (engineLoaded) {
      if (confirm("Loading a different model requires restarting the WebGPU engine. Would you like to restart now?")) {
        engineLoaded = false;
        btnInit.classList.remove('hidden');
        btnInit.disabled = false;
        btnInit.innerHTML = `<span class="material-symbols-outlined text-sm">power</span><span>Initialize Engine</span>`;
        btnSend.disabled = !gpuAvailable;
      } else {
        // Revert selection
        modelSelect.value = "Qwen2.5-1.5B-Instruct-q4f16_1-MLC";
      }
    }
    updateCacheStatus();
  });

  // Form submit / Message sender
  chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const query = chatInput.value.trim();
    if (!query || isGenerating) return;

    chatInput.value = '';
    isGenerating = true;
    btnSend.disabled = true;

    // 1. Append User Message to UI
    appendUserMessage(query);

    // 2. Perform Local RAG Search
    appendSystemStatus("Searching local knowledge base...");
    const ragResults = await ragSearch(query, 3);
    removeSystemStatus();

    // 3. Render Collapsible RAG References if results found
    let ragContainerId = "";
    if (ragResults.length > 0) {
      ragContainerId = appendRAGReferences(ragResults);
    }

    // 4. Handle WebGPU Unavailable Fallback
    if (!gpuAvailable || !engineLoaded) {
      appendSystemMessage("WebGPU is not active. Showing local recipe search results only.");
      isGenerating = false;
      btnSend.disabled = false;
      return;
    }

    // 5. Run LLM Inference
    try {
      // Formulate system prompt with recipe context
      let systemPrompt = "You are a helpful, professional AI Chef and Kitchen Assistant. You answer questions directly, accurately, and informatively.";

      if (ragResults.length > 0) {
        systemPrompt += "\n\nUse the following verified recipes from our Gastronomic Open Standard database to answer the user's question. Focus on their details, sensory descriptors, and ingredients:\n\n";
        ragResults.forEach((recipe, i) => {
          systemPrompt += `[Recipe ${i+1}]: ${recipe.title}\n`;
          if ((recipe as any).region) systemPrompt += `- Region: ${(recipe as any).region}\n`;
          if ((recipe as any).mainIngredients) systemPrompt += `- Ingredients: ${(recipe as any).mainIngredients.join(', ')}\n`;
          if ((recipe as any).description) systemPrompt += `- Description: ${(recipe as any).description}\n`;
          systemPrompt += `\n`;
        });
      }

      const promptMessages: any = [
        { role: "system", content: systemPrompt },
        ...chatHistory,
        { role: "user", content: query }
      ];

      // Append Assistant Bubble to UI
      const assistantBubbleId = appendAssistantStreamStart();
      const assistantBubble = document.getElementById(assistantBubbleId) as HTMLParagraphElement;

      let completeResponse = "";
      const selectedModel = modelSelect.value;

      const completionGenerator = streamGPUCompletion(promptMessages, {
        modelId: selectedModel,
        temperature: 0.7
      });

      for await (const chunk of completionGenerator) {
        completeResponse += chunk;
        // Simple markdown rendering (handles line breaks and bold tags)
        assistantBubble.innerHTML = formatMarkdown(completeResponse);
        // Scroll to bottom
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }

      // Save conversation state
      chatHistory.push({ role: "user", content: query });
      chatHistory.push({ role: "assistant", content: completeResponse });

    } catch (err: any) {
      console.error(err);
      appendSystemMessage(`Inference Error: ${err.message || err}`);
    } finally {
      isGenerating = false;
      btnSend.disabled = false;
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
  });

  // Helper functions for UI Manipulation
  function appendUserMessage(text: string) {
    const id = "msg-" + Date.now();
    const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

    const div = document.createElement('div');
    div.className = "chat-message-bubble flex gap-4 max-w-3xl ml-auto justify-end";
    div.innerHTML = `
      <div class="space-y-1.5 flex flex-col items-end">
        <div class="bg-primary text-white rounded-2xl rounded-tr-none px-4 py-3 text-sm">
          <p class="whitespace-pre-wrap">${escapeHTML(text)}</p>
        </div>
        <span class="text-[10px] text-gray-400 dark:text-gray-500 pr-2">${time}</span>
      </div>
      <div class="w-8 h-8 rounded-lg bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-600 dark:text-gray-400 shrink-0">
        <span class="material-symbols-outlined text-lg">person</span>
      </div>
    `;
    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function appendSystemMessage(text: string) {
    const div = document.createElement('div');
    div.className = "chat-message-bubble flex justify-center py-2";
    div.innerHTML = `
      <div class="bg-gray-100 dark:bg-gray-800/50 text-gray-600 dark:text-gray-400 text-xs px-4 py-1.5 rounded-full border border-gray-200/50 dark:border-gray-800/30">
        ${escapeHTML(text)}
      </div>
    `;
    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function appendSystemStatus(text: string) {
    const div = document.createElement('div');
    div.id = "system-status-indicator";
    div.className = "flex justify-center py-2";
    div.innerHTML = `
      <div class="bg-primary/5 text-primary text-xs px-4 py-1.5 rounded-full flex items-center gap-2 animate-pulse">
        <span class="material-symbols-outlined text-xs animate-spin">sync</span>
        <span>${escapeHTML(text)}</span>
      </div>
    `;
    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function removeSystemStatus() {
    const indicator = document.getElementById('system-status-indicator');
    if (indicator) indicator.remove();
  }

  function appendRAGReferences(results: any[]) {
    const containerId = "rag-" + Date.now();
    const div = document.createElement('div');
    div.className = "chat-message-bubble max-w-3xl ml-12 bg-gray-50 dark:bg-gray-950/30 border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm";

    let itemsHTML = "";
    results.forEach(recipe => {
      const href = `${import.meta.env.BASE_URL}/recipes/${recipe.slug}`;
      itemsHTML += `
        <a href="${href}" class="flex items-start gap-2.5 p-3 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors border-b border-gray-200 dark:border-gray-800 last:border-0">
          <span class="material-symbols-outlined text-primary mt-0.5">menu_book</span>
          <div class="min-w-0">
            <p class="text-xs font-bold text-gray-800 dark:text-gray-200 truncate">${escapeHTML(recipe.title)}</p>
            <p class="text-[10px] text-gray-500 dark:text-gray-400 capitalize truncate">
              ${(recipe as any).region ? `${(recipe as any).region} • ` : ''}Difficulty: ${(recipe as any).difficulty || 'Easy'}
            </p>
          </div>
          <span class="material-symbols-outlined text-gray-400 text-sm ml-auto">chevron_right</span>
        </a>
      `;
    });

    div.innerHTML = `
      <details class="group" open>
        <summary class="flex items-center justify-between px-4 py-2.5 text-xs font-bold text-gray-700 dark:text-gray-300 cursor-pointer select-none group-open:border-b group-open:border-gray-200 dark:group-open:border-gray-800">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-sm text-primary">source</span>
            <span>Recipe Knowledge Found (${results.length})</span>
          </div>
          <span class="material-symbols-outlined text-sm transition-transform group-open:rotate-180">expand_more</span>
        </summary>
        <div class="flex flex-col">
          ${itemsHTML}
        </div>
      </details>
    `;

    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
    return containerId;
  }

  function appendAssistantStreamStart(): string {
    const bubbleId = "ast-" + Date.now();
    const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

    const div = document.createElement('div');
    div.className = "chat-message-bubble flex gap-4 max-w-3xl";
    div.innerHTML = `
      <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
        <span class="material-symbols-outlined text-lg">smart_toy</span>
      </div>
      <div class="space-y-1.5 flex-1 min-w-0">
        <div class="bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 rounded-2xl rounded-tl-none px-4 py-3 text-sm prose dark:prose-invert max-w-none">
          <p id="${bubbleId}" class="whitespace-pre-wrap leading-relaxed"><span class="animate-pulse">Thinking...</span></p>
        </div>
        <span class="text-[10px] text-gray-400 dark:text-gray-500 pl-2">${time}</span>
      </div>
    `;

    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
    return bubbleId;
  }

  function formatMarkdown(text: string): string {
    // Basic Markdown Formatting support
    let html = text;

    // Convert list items
    html = html.replace(/^\s*-\s+(.+)$/gm, '<li>$1</li>');
    html = html.replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>');

    // Convert double line breaks to paragraph markers
    html = html.replace(/\n\n/g, '<br/><br/>');

    // Convert **bold** tags
    html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

    // Convert *italic* tags
    html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');

    return html;
  }

  function escapeHTML(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
</script>
