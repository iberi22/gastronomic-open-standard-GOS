{
  "name": "gastronomic-open-standard",
  "description": "Gastronomic Open Standard (GOS) - A scientifically structured, open database of world recipes and ingredients.",
  "version": "2.0.0",
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberi22/gastronomic-open-standard-GOS.git"
  },
  "keywords": [
    "recipes",
    "cooking",
    "gastronomy",
    "open-standard"
  ],
  "scripts": {
    "build": "node ./.github/readme-generate.js",
    "manuallint": "node .github/manual_lint.js",
    "markdownlint": "markdownlint ./dishes ./tips",
    "lint": "pnpm run markdownlint && pnpm run manuallint && echo 'Lint finished. All passed.'",
    "test:e2e": "playwright test"
  },
  "author": "Brahyan Belalcazar <iberi22>",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/iberi22/gastronomic-open-standard-GOS/issues"
  },
  "homepage": "https://github.com/iberi22/gastronomic-open-standard-GOS",
  "devDependencies": {
    "glob": "^13.0.6",
    "markdownlint-cli": "^0.49.1"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "js-yaml": "^5.4.1",
    "markdown-it": "^14.3.1"
  }
}
