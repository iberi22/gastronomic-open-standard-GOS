{
  "name": "gastronomic-open-standard",
  "description": "Gastronomic Open Standard (GOS) - A scientifically structured, open database of world recipes and ingredients.",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberi22/gastronomic-open-standard-GOS.git"
  },
  "keywords": [
    "recipes",
    "cooking",
    "cookbook",
    "chinese",
    "dishes"
  ],
  "scripts": {
    "build": "node ./.github/readme-generate.js",
    "manuallint": "node .github/manual_lint.js",
    "markdownlint": "markdownlint ./dishes ./tips",
    "lint": "npm run markdownlint && npm run manuallint && echo 'Lint finished. All passed.'",
    "prepare": "husky"
  },
  "author": "Anduin2017",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/Anduin2017/HowToCook/issues"
  },
  "homepage": "https://cook.aiursoft.cn",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "front-matter": "^4.0.2",
    "textlint": "^15.5.1",
    "textlint-rule-ja-space-between-half-and-full-width": "^2.2.0",
    "textlint-rule-zh-half-and-full-width-bracket": "^1.1.0"
  },
  "devDependencies": {
    "glob": "^13.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdownlint-cli": "^0.47.0",
    "tar-fs": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.md": "markdownlint --fix --ignore 'CHANGELOG.md'"
  }
}