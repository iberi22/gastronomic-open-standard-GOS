# Prune hygiene (2026-08-24)
# Note: release evidence bundles MUST be committed. We use pathspec
# rules so .gitcore/releases/*.log and *.md are excluded from the
# global *.log / *.md exclusions further below.
#
# Strategy: name the release files explicitly with `!` patterns
# that override the broader patterns by being more specific.
*.log
!site/scripts/*.log
!.gitcore/releases/**/*.log
!*.evidence.log
*.exe
bin/
archive/site-cleanup/
site_legacy_20260902/
# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/
dishes_backup/
# Cloudflare Worker / Wrangler dev state
.wrangler/
worker/.wrangler/
# Astro + Husky leftovers (2026-09-04)
.astro/
.husky/*.orig
# Generated graph intermediates (regenerated every build by site/scripts/generate-graph.js)
/graph.json
docs/graph.json
site/graph-data.json
docs/explorar-grafo.html
docs/explorar-grafo-standalone.html
site/public/graph-data.json

# >>> GITCORE PUBLIC REPO HARDENING >>>
# ─────────────────────────────────────────────────────────────────────────────
# GitCore — fragmento para repos PÚBLICOS
# Añadir al .gitignore del repo público. Bloquea el estado interno del
# laboratorio que el protocolo GitCore crea en TODOS los repos.
#
# IMPORTANTE: ignorar un archivo ya trackeado NO lo despublica.
# Para archivos ya commiteados hay que ejecutar:
#   git rm -r --cached <ruta>
#   git commit -m "chore: stop publishing internal lab state"
# y, si ya se publicó, purgar el historial.
# ─────────────────────────────────────────────────────────────────────────────

# Planificación y estado de sesión (interno)
.gitcore/planning/
.gitcore/chronicles/
.gitcore/waves/
.gitcore/sdd/
.gitcore/releases/
.gitcore/issues/
.gitcore/features.details/
.gitcore/CONTEXT_LOG.md
.gitcore/STATE.md
.gitcore/TODO.md
.gitcore/features-status.md
.gitcore/implementation-score.json
.gitcore/AGENT_INDEX.md
.gitcore/ARCHITECTURE.md
.gitcore/SRC.md
.gitcore/skill-registry.json
.gitcore/.skill-registry.cache.json
.gitcore/_tmp_*

# Estado del harness y agentes
.hermes/
.atl/
.gestalt/
.jules/
.xavier/
.xavier-backups/
.skill-registry.cache.json

# Planificación suelta en la raíz o en docs/
PLANNING.md
TASK.md
tasks.json

